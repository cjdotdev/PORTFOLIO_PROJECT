  "narrative": {
    "northStar": "The Engineer's Letterhead",
    "overview": "The site runs on MakiSend's system, pinned by the owner: Arc UI's neutral foundation, Geist for headings, Inter for reading, Geist Mono for data, weights 400 and 500 only, 18/26/34px corners, bordered surfaces without shadow, sentence case. Joel's terracotta replaces MakiSend green as the single accent. Everything is drawn from CSS custom properties; light and dark are two value sets on the same names, switched by `data-theme` on the root.\n\nOn top of that borrowed grammar the site adds a personal layer: the surname set as a full-width monument, the c/J monogram, an ink engraving portrait that sits on the page instead of in a frame, a live location board that shows the backend at work, a once-per-session cinematic title, and an inverted footer band. These additions carry identity; the system around them stays quiet so they read.",
    "keyCharacteristics": [
      "Neutral grey paper and ink, one terracotta accent used for links, live dots, focus and current state.",
      "Geist 500 headings with tight negative tracking, Inter 400 body, no other weights.",
      "Flat bordered surfaces at 18/26/34px; depth comes from borders and muted fills, not shadows.",
      "Identity carried by a few authored objects: monument, mark, engraving, location board.",
      "Motion is purposeful and gated on `prefers-reduced-motion`; content is visible by default."
    ],
    "rules": [
      {
        "name": "The One Ember Rule",
        "body": "Terracotta is the only hue. It marks what is live, linked, focused or current; it is never a fill for large surfaces.",
        "section": "colors"
      },
      {
        "name": "The Token-Only Rule",
        "body": "Components read custom properties; light and dark differ only in values on `:root[data-theme=\"dark\"]`.",
        "section": "colors"
      },
      {
        "name": "The Two Weights Rule",
        "body": "400 and 500 only. Emphasis comes from size and colour, never bold.",
        "section": "typography"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "Headings, buttons and labels are sentence case. The monument is the single uppercase setting, because it is a name set as an object.",
        "section": "typography"
      },
      {
        "name": "The Border Not Shadow Rule",
        "body": "A container gets a 1px `--border` and a radius. Arc's shadow tokens exist in the foundation but are not used on surfaces.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** take every colour, radius, space and duration from the custom properties in `global.css` and `arc/foundation.css`.",
      "**Do** keep terracotta (#ae4b2b / #e8916f) to links, live dots, focus and current state.",
      "**Do** set headings in Geist 500 with negative tracking and body in Inter 400.",
      "**Do** use 1px borders and 18/26/34px corners for containers.",
      "**Do** gate every animation on `prefers-reduced-motion: no-preference` and leave content visible without it.",
      "**Do** keep touch targets at 44px."
    ],
    "donts": [
      "**Don't** use weights other than 400 and 500.",
      "**Don't** add shadows to cards or panels.",
      "**Don't** add eyebrows or kicker labels above headings.",
      "**Don't** use em dashes in copy.",
      "**Don't** set headings, buttons or labels in all caps; the monument is the only uppercase.",
      "**Don't** introduce a second accent hue."
    ]
  }
}