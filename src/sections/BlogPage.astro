---
import PostList from "../components/PostList.astro";
import { getBlogPosts } from "../lib/hashnode";
import type { Dict, Locale } from "../i18n";

interface Props {
  t: Dict;
  locale: Locale;
}

const { t, locale } = Astro.props;
const posts = getBlogPosts();
---

<header class="page-head container">
  <h1 class="display-lg">{t.blogPage.title}</h1>
  <p class="lede">
    {t.writing.lede}
    {t.writing.englishNote && <> {t.writing.englishNote}</>}
  </p>
</header>

<div class="container list">
  <PostList posts={posts} t={t} locale={locale} level={2} filters />
</div>

<style>
  .page-head {
    display: grid;
    gap: var(--space-4);
  }
  .list {
    padding-bottom: var(--section-space);
  }
</style>
