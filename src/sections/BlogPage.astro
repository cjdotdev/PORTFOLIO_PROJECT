---
import PostList from "../components/PostList.astro";
import { getPosts } from "../lib/posts";
import BackLink from "../components/BackLink.astro";
import { localePath, type Dict, type Locale } from "../i18n";

interface Props {
  t: Dict;
  locale: Locale;
}

const { t, locale } = Astro.props;
const posts = await getPosts(locale);
---

<header class="page-head container">
  <BackLink href={localePath(locale, "/")} label={t.nav.backHome} />
  <h1 class="display-lg">{t.blogPage.title}</h1>
  <p class="lede">{t.writing.lede}</p>
</header>

<div class="container list">
  <PostList posts={posts} t={t} locale={locale} level={2} filters />
</div>

<style>
  .page-head {
    display: grid;
    gap: var(--space-4);
  }
  .list {
    padding-bottom: var(--section-space);
  }
</style>
