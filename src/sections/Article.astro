---
import { Image } from "astro:assets";
import { siX } from "simple-icons";
import BackLink from "../components/BackLink.astro";
import Contents from "../components/Contents.astro";
import "../styles/prose.css";
import { render } from "astro:content";
import { PERSONAL, SITE_URL } from "../data";
import { localePath, type Dict, type Locale } from "../i18n";
import { postPath, readingTime, type LocalPost } from "../lib/posts";

interface Props {
  post: LocalPost;
  /** The older and the newer post, if any. */
  previous?: LocalPost;
  next?: LocalPost;
  t: Dict;
  locale: Locale;
}

const { post, previous, next, t, locale } = Astro.props;
const { lang } = post;
const { data } = post.entry;
const { Content, headings } = await render(post.entry);
const contents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const format = new Intl.DateTimeFormat(locale === "fr" ? "fr-FR" : "en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
const day = (date: Date) => date.toISOString().slice(0, 10);
const url = `${SITE_URL}${postPath(lang, post.slug)}`;
// LinkedIn's own "in" mark (Simple Icons no longer ships it), as in SocialIcons.astro.
const LINKEDIN =
  "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z";
const share = [
  { label: "X", path: siX.path, href: `https://x.com/intent/post?url=${encodeURIComponent(url)}&text=${encodeURIComponent(data.title)}` },
  { label: "LinkedIn", path: LINKEDIN, href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}` },
];
const blog = localePath(locale, "/blog/");
---

<!--
  A post, after Hashnode without its extras: the cover, the title and subtitle, the author with the
  date and reading time, then the text with its table of contents (beside it on wide screens, folded
  above it on smaller ones), then topics, sharing, the author and the posts around it. The post carries
  its own language (lang); when it has no version in the page's language, a line under the byline
  says so.
-->
<article class="article" data-article>
  <div class="container intro">
    <BackLink href={blog} label={t.post.back} />
    {
      data.cover && (
        <Image
          class="cover"
          src={data.cover}
          alt={data.coverAlt ?? ""}
          widths={[640, 1000, 1400, 1800]}
          sizes="(min-width: 72rem) 68rem, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
    <header class="head" lang={lang}>
      <h1 class="title">{data.title}</h1>
      <p class="subtitle">{data.subtitle}</p>
    </header>
    <div class="byline">
      <img class="avatar" src="/img/avatar-v1.webp" alt="" width="44" height="44" />
      <div>
        <p class="author">{PERSONAL.name}</p>
        <p class="mono when">
          <time datetime={day(data.date)}>{format.format(data.date)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime(post.entry)} {t.post.minRead}</span>
          {
            data.updated && (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  {t.post.updated} <time datetime={day(data.updated)}>{format.format(data.updated)}</time>
                </span>
              </>
            )
          }
        </p>
      </div>
    </div>
    {lang !== locale && <p class="only-in">{t.post.onlyIn}</p>}
  </div>

  <div class:list={["container read-body", { "with-contents": contents.length > 1 }]}>
    {contents.length > 1 && <Contents headings={contents} label={t.post.contents} lang={lang} />}

    <div class="prose" lang={lang} data-prose data-copy={t.post.copyCode} data-copied={t.post.copiedCode} data-anchor={t.post.headingLink}>
      <Content />
    </div>

    <footer class="end">
      {
        data.tags.length > 0 && (
          <ul class="tags" role="list" lang={lang}>
            {data.tags.map((tag) => (
              <li>
                <a class="tag mono" href={`${blog}?topic=${encodeURIComponent(tag)}`}>
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <div class="share">
        <p class="mono">{t.post.share}</p>
        <div class="share-actions">
          <button class="btn btn-secondary" type="button" data-copy-link={url} data-done={t.post.copiedLink}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            <span>{t.post.copyLink}</span>
          </button>
          {
            share.map((link) => (
              <a
                class="btn btn-secondary"
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={link.label}
                title={link.label}
              >
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                  <path d={link.path} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <div class="author-box">
        <img class="avatar" src="/img/avatar-v1.webp" alt="" width="64" height="64" loading="lazy" />
        <div>
          <p class="mono">{t.post.writtenBy}</p>
          <p class="author-name">{PERSONAL.name}</p>
          <p class="bio">{t.post.bio}</p>
          <p class="author-links">
            <a class="link" href={PERSONAL.github} target="_blank" rel="noopener noreferrer">GitHub</a>
            <a class="link" href={PERSONAL.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          </p>
        </div>
      </div>

      {
        (previous || next) && (
          <nav class="around" aria-label={t.blogPage.title}>
            {previous && (
              <a class="around-link previous" href={postPath(locale, previous.slug)}>
                <span class="mono">{t.post.previous}</span>
                <span class="around-title" lang={previous.lang}>{previous.entry.data.title}</span>
              </a>
            )}
            {next && (
              <a class="around-link next" href={postPath(locale, next.slug)}>
                <span class="mono">{t.post.next}</span>
                <span class="around-title" lang={next.lang}>{next.entry.data.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </footer>
  </div>
</article>

<script>
  import { enhanceLongRead } from "../lib/prose";

  const root = document.querySelector<HTMLElement>("[data-article]");

  if (root) {
    enhanceLongRead(root);

    // Copy the post's link.
    root.querySelectorAll<HTMLButtonElement>("[data-copy-link]").forEach((button) => {
      const label = button.querySelector("span");
      const idle = label?.textContent ?? "";
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copyLink ?? location.href);
          if (label) label.textContent = button.dataset.done ?? idle;
          setTimeout(() => label && (label.textContent = idle), 1800);
        } catch {
          // Refused clipboard: nothing to show.
        }
      });
    });
  }
</script>

<style>
  .article {
    padding-bottom: var(--section-space);
  }
  .intro {
    display: grid;
    gap: var(--space-6);
    max-width: calc(68rem + 2 * var(--gutter));
    padding-top: var(--space-8);
  }
  .cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1.9;
    object-fit: cover;
    border-radius: var(--radius-panel);
    background: var(--surface);
  }

  /* The title block and the text share one centred column. */
  .head,
  .byline {
    width: 100%;
    max-width: 44rem;
    margin-inline: auto;
  }
  .head {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-4);
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.25rem);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
    line-height: 1.08;
    text-wrap: balance;
  }
  .subtitle {
    margin: 0;
    color: var(--text-secondary);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.45;
    text-wrap: pretty;
  }
  .byline {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border);
  }
  .byline p {
    margin: 0;
  }
  /* The post is not in the page's language. */
  .only-in {
    width: 100%;
    max-width: 44rem;
    margin: calc(-1 * var(--space-2)) auto 0;
    color: var(--accent);
  }
  .avatar {
    flex: none;
    border-radius: 50%;
    object-fit: cover;
    background: var(--surface);
  }
  .author {
    font-weight: 500;
  }
  .when {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    color: var(--text-secondary);
  }

  /* After the text. */
  .end {
    display: grid;
    gap: var(--space-10);
    margin-top: var(--space-8);
  }
  .end p {
    margin: 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--text-secondary);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }
  .tag:hover {
    border-color: var(--border-strong);
    color: var(--foreground);
  }
  .share {
    display: grid;
    gap: var(--space-3);
  }
  .share > p,
  .author-box .mono {
    color: var(--text-secondary);
  }
  /* X and LinkedIn: their logo alone, in a square button. */
  .share-actions a.btn {
    width: var(--control-height-md);
    padding: 0;
  }
  .share-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .author-box {
    display: flex;
    align-items: flex-start;
    gap: var(--space-5);
    padding-block: var(--space-8);
    border-block: 1px solid var(--border);
  }
  .author-box > div {
    display: grid;
    gap: var(--space-1);
  }
  .author-name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
  }
  .bio {
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  .author-links {
    display: flex;
    gap: var(--space-5);
    margin-top: var(--space-2) !important;
  }

  .around {
    display: grid;
    gap: var(--space-6);
  }
  .around-link {
    display: grid;
    gap: var(--space-1);
    text-decoration: none;
  }
  .around-link .mono {
    color: var(--text-secondary);
  }
  .around-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.25;
    text-wrap: balance;
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .around-link:hover .around-title {
    color: var(--accent);
  }
  @media (min-width: 40rem) {
    .around {
      grid-template-columns: 1fr 1fr;
    }
    .next {
      grid-column: 2;
      text-align: right;
    }
  }
</style>
