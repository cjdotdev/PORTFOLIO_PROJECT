---
import { Image } from "astro:assets";
import { siX } from "simple-icons";
import BackLink from "../components/BackLink.astro";
import { render } from "astro:content";
import { PERSONAL, SITE_URL } from "../data";
import { localePath, type Dict, type Locale } from "../i18n";
import { readingTime, type Post } from "../lib/posts";

interface Props {
  post: Post;
  /** The older and the newer post, if any. */
  previous?: Post;
  next?: Post;
  t: Dict;
  locale: Locale;
}

const { post, previous, next, t, locale } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
const contents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const format = new Intl.DateTimeFormat(locale === "fr" ? "fr-FR" : "en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
const day = (date: Date) => date.toISOString().slice(0, 10);
const url = `${SITE_URL}/blog/${post.id}/`;
// LinkedIn's own "in" mark (Simple Icons no longer ships it), as in SocialIcons.astro.
const LINKEDIN =
  "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z";
const share = [
  { label: "X", path: siX.path, href: `https://x.com/intent/post?url=${encodeURIComponent(url)}&text=${encodeURIComponent(data.title)}` },
  { label: "LinkedIn", path: LINKEDIN, href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}` },
];
const blog = localePath(locale, "/blog/");
---

<!--
  A post, after Hashnode without its extras: the cover, the title and subtitle, the author with the
  date and reading time, then the text with its table of contents (beside it on wide screens, folded
  above it on smaller ones), then topics, sharing, the author and the posts around it. The post itself
  is in English (lang="en") whatever the page's language.
-->
<article class="article" data-article>
  <div class="container intro">
    <BackLink href={blog} label={t.post.back} />
    {
      data.cover && (
        <Image
          class="cover"
          src={data.cover}
          alt={data.coverAlt ?? ""}
          widths={[640, 1000, 1400, 1800]}
          sizes="(min-width: 72rem) 68rem, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
    <header class="head" lang="en">
      <h1 class="title">{data.title}</h1>
      <p class="subtitle">{data.subtitle}</p>
    </header>
    <div class="byline">
      <img class="avatar" src="/img/avatar-v1.webp" alt="" width="44" height="44" />
      <div>
        <p class="author">{PERSONAL.name}</p>
        <p class="mono when">
          <time datetime={day(data.date)}>{format.format(data.date)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime(post)} {t.post.minRead}</span>
          {
            data.updated && (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  {t.post.updated} <time datetime={day(data.updated)}>{format.format(data.updated)}</time>
                </span>
              </>
            )
          }
        </p>
      </div>
    </div>
  </div>

  <div class:list={["container body", { "with-contents": contents.length > 1 }]}>
    {
      contents.length > 1 && (
        <>
          <details class="contents contents-fold">
            <summary>
              {t.post.contents}
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </summary>
            <ol role="list" lang="en">
              {contents.map((heading) => (
                <li class:list={{ sub: heading.depth === 3 }}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </details>
          <nav class="contents contents-side" aria-label={t.post.contents}>
            <p class="mono">{t.post.contents}</p>
            <ol role="list" lang="en">
              {contents.map((heading) => (
                <li class:list={{ sub: heading.depth === 3 }}>
                  <a href={`#${heading.slug}`} data-to={heading.slug}>
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </>
      )
    }

    <div class="prose" lang="en" data-prose data-copy={t.post.copyCode} data-copied={t.post.copiedCode} data-anchor={t.post.headingLink}>
      <Content />
    </div>

    <footer class="end">
      {
        data.tags.length > 0 && (
          <ul class="tags" role="list" lang="en">
            {data.tags.map((tag) => (
              <li>
                <a class="tag mono" href={`${blog}?topic=${encodeURIComponent(tag)}`}>
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <div class="share">
        <p class="mono">{t.post.share}</p>
        <div class="share-actions">
          <button class="btn btn-secondary" type="button" data-copy-link={url} data-done={t.post.copiedLink}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            <span>{t.post.copyLink}</span>
          </button>
          {
            share.map((link) => (
              <a
                class="btn btn-secondary"
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={link.label}
                title={link.label}
              >
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                  <path d={link.path} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <div class="author-box">
        <img class="avatar" src="/img/avatar-v1.webp" alt="" width="64" height="64" loading="lazy" />
        <div>
          <p class="mono">{t.post.writtenBy}</p>
          <p class="author-name">{PERSONAL.name}</p>
          <p class="bio">{t.post.bio}</p>
          <p class="author-links">
            <a class="link" href={PERSONAL.github} target="_blank" rel="noopener noreferrer">GitHub</a>
            <a class="link" href={PERSONAL.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          </p>
        </div>
      </div>

      {
        (previous || next) && (
          <nav class="around" aria-label={t.blogPage.title}>
            {previous && (
              <a class="around-link previous" href={localePath(locale, `/blog/${previous.id}/`)}>
                <span class="mono">{t.post.previous}</span>
                <span class="around-title" lang="en">{previous.data.title}</span>
              </a>
            )}
            {next && (
              <a class="around-link next" href={localePath(locale, `/blog/${next.id}/`)}>
                <span class="mono">{t.post.next}</span>
                <span class="around-title" lang="en">{next.data.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </footer>
  </div>
</article>

<script>
  const root = document.querySelector<HTMLElement>("[data-article]");
  const prose = root?.querySelector<HTMLElement>("[data-prose]");

  if (root && prose) {
    // Code blocks: the language above the code and a button that copies it.
    prose.querySelectorAll<HTMLPreElement>("pre").forEach((pre) => {
      const block = document.createElement("div");
      block.className = "code";
      const bar = document.createElement("div");
      bar.className = "code-bar";
      const language = document.createElement("span");
      language.textContent = pre.dataset.language && pre.dataset.language !== "plaintext" ? pre.dataset.language : "";
      const copy = document.createElement("button");
      copy.type = "button";
      copy.textContent = prose.dataset.copy ?? "Copy";
      copy.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(pre.innerText);
          copy.textContent = prose.dataset.copied ?? "Copied";
          setTimeout(() => (copy.textContent = prose.dataset.copy ?? "Copy"), 1600);
        } catch {
          // The clipboard can be refused (insecure context, permissions): the code stays selectable.
        }
      });
      bar.append(language, copy);
      pre.replaceWith(block);
      block.append(bar, pre);
    });

    // Headings: a "#" link to copy or share the section.
    prose.querySelectorAll<HTMLHeadingElement>("h2[id], h3[id]").forEach((heading) => {
      const anchor = document.createElement("a");
      anchor.className = "anchor";
      anchor.href = `#${heading.id}`;
      anchor.textContent = "#";
      anchor.setAttribute("aria-label", prose.dataset.anchor ?? "Link to this section");
      heading.append(anchor);
    });

    // The table of contents beside the text marks the section being read: the last heading that has
    // passed the top third of the screen, computed from the scroll position.
    const links = [...root.querySelectorAll<HTMLAnchorElement>(".contents-side a[data-to]")];
    const targets = links
      .map((link) => document.getElementById(link.dataset.to ?? ""))
      .filter((heading): heading is HTMLElement => heading !== null);
    let frame = 0;
    const mark = () => {
      frame = 0;
      const line = innerHeight / 3;
      let current = -1;
      targets.forEach((heading, i) => {
        if (heading.getBoundingClientRect().top <= line) current = i;
      });
      links.forEach((link, i) => {
        if (i === current) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    };
    if (links.length) {
      addEventListener("scroll", () => (frame ||= requestAnimationFrame(mark)), { passive: true });
      mark();
    }

    // The folded table of contents closes once a section is chosen.
    root.querySelectorAll<HTMLAnchorElement>(".contents-fold a").forEach((link) =>
      link.addEventListener("click", () => link.closest("details")?.removeAttribute("open")),
    );

    // Copy the post's link.
    root.querySelectorAll<HTMLButtonElement>("[data-copy-link]").forEach((button) => {
      const label = button.querySelector("span");
      const idle = label?.textContent ?? "";
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copyLink ?? location.href);
          if (label) label.textContent = button.dataset.done ?? idle;
          setTimeout(() => label && (label.textContent = idle), 1800);
        } catch {
          // Refused clipboard: nothing to show.
        }
      });
    });
  }
</script>

<style>
  .article {
    padding-bottom: var(--section-space);
  }
  .intro {
    display: grid;
    gap: var(--space-6);
    max-width: calc(68rem + 2 * var(--gutter));
    padding-top: var(--space-8);
  }
  .cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1.9;
    object-fit: cover;
    border-radius: var(--radius-panel);
    background: var(--surface);
  }

  /* The title block and the text share one centred column. */
  .head,
  .byline {
    width: 100%;
    max-width: 44rem;
    margin-inline: auto;
  }
  .head {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-4);
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.25rem);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
    line-height: 1.08;
    text-wrap: balance;
  }
  .subtitle {
    margin: 0;
    color: var(--text-secondary);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.45;
    text-wrap: pretty;
  }
  .byline {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border);
  }
  .byline p {
    margin: 0;
  }
  .avatar {
    flex: none;
    border-radius: 50%;
    object-fit: cover;
    background: var(--surface);
  }
  .author {
    font-weight: 500;
  }
  .when {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    color: var(--text-secondary);
  }

  /* Text column, centred; on wide screens the table of contents sits in the right margin. */
  .body {
    display: grid;
    grid-template-columns: minmax(0, 44rem);
    justify-content: center;
    gap: var(--space-8);
    max-width: calc(68rem + 2 * var(--gutter));
    padding-top: var(--space-8);
  }

  .contents ol {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .contents a {
    display: block;
    padding: var(--space-2) 0;
    color: var(--text-secondary);
    text-decoration: none;
    line-height: 1.35;
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .contents a:hover,
  .contents a[aria-current] {
    color: var(--foreground);
  }
  .contents .sub a {
    padding-left: var(--space-4);
  }

  /* Folded above the text, right under the byline's hairline: a row that opens on tap. */
  .contents-fold {
    margin-top: calc(-1 * var(--space-8));
    border-bottom: 1px solid var(--border);
  }
  .contents-fold summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3rem;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }
  .contents-fold summary::-webkit-details-marker {
    display: none;
  }
  .contents-fold summary svg {
    transition: rotate var(--duration-fast) var(--ease-standard);
  }
  .contents-fold[open] summary svg {
    rotate: 180deg;
  }
  .contents-fold ol {
    padding-bottom: var(--space-3);
  }
  .contents-side {
    display: none;
  }

  @media (min-width: 72rem) {
    .body.with-contents {
      grid-template-columns: minmax(0, 1fr) minmax(0, 44rem) minmax(0, 1fr);
      column-gap: var(--space-12);
    }
    .with-contents > * {
      grid-column: 2;
    }
    .contents-fold {
      display: none;
    }
    .with-contents .contents-side {
      display: block;
      grid-column: 3;
      grid-row: 1 / span 2;
      align-self: start;
      position: sticky;
      top: calc(4rem + var(--space-8));
      max-height: calc(100dvh - 4rem - var(--space-16));
      overflow-y: auto;
      font-size: var(--text-sm);
    }
    .contents-side p {
      margin: 0 0 var(--space-2);
      color: var(--text-secondary);
    }
    /* The section being read: terracotta hairline on its left. */
    .contents-side li {
      border-left: 1px solid var(--border);
    }
    .contents-side a {
      padding-left: var(--space-4);
      margin-left: -1px;
      border-left: 1px solid transparent;
    }
    .contents-side .sub a {
      padding-left: var(--space-8);
    }
    .contents-side a[aria-current] {
      border-left-color: var(--accent);
    }
  }

  /* The post's text, written in Markdown: styled from here (it is not part of this template). */
  .prose {
    font-size: var(--text-lg);
    line-height: 1.7;
    overflow-wrap: break-word;
  }
  .prose :global(> * + *) {
    margin-top: var(--space-5);
  }
  .prose :global(> :first-child) {
    margin-top: 0;
  }
  .prose :global(h2),
  .prose :global(h3) {
    position: relative;
    margin-bottom: 0;
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
    line-height: 1.2;
    text-wrap: balance;
    scroll-margin-top: calc(4rem + var(--space-6));
  }
  .prose :global(h2) {
    margin-top: var(--space-12);
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
  }
  .prose :global(h3) {
    margin-top: var(--space-8);
    font-size: clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem);
  }
  .prose :global(h2 + *),
  .prose :global(h3 + *) {
    margin-top: var(--space-3);
  }
  .prose :global(.anchor) {
    margin-left: 0.35em;
    color: var(--text-muted);
    text-decoration: none;
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }
  .prose :global(h2:hover .anchor),
  .prose :global(h3:hover .anchor),
  .prose :global(.anchor:focus-visible) {
    opacity: 1;
  }
  .prose :global(.anchor:hover) {
    color: var(--accent);
  }
  .prose :global(p),
  .prose :global(li) {
    text-wrap: pretty;
  }
  .prose :global(a:not(.anchor)) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }
  .prose :global(a:not(.anchor):hover) {
    text-decoration-color: currentColor;
  }
  .prose :global(strong) {
    font-weight: 500;
    color: var(--foreground);
  }
  .prose :global(ul),
  .prose :global(ol) {
    display: grid;
    gap: var(--space-2);
    padding-left: 1.4em;
  }
  .prose :global(li::marker) {
    color: var(--text-muted);
  }
  .prose :global(blockquote) {
    margin-inline: 0;
    padding-left: var(--space-5);
    border-left: 2px solid var(--accent);
    color: var(--text-secondary);
  }
  .prose :global(hr) {
    margin-block: var(--space-12);
    border: 0;
    border-top: 1px solid var(--border);
  }
  .prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-control);
  }
  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    border-radius: 0.35em;
    background: var(--surface-muted);
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  /* Code blocks: language and copy button on a bar above the code. */
  .prose :global(.code) {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    background: #101010;
  }
  .prose :global(.code-bar) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.5rem;
    padding: 0 var(--space-2) 0 var(--space-4);
    border-bottom: 1px solid var(--border);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .prose :global(.code-bar button) {
    min-height: 2.25rem;
    padding: 0 var(--space-3);
    border: 0;
    border-radius: 0.6rem;
    background: none;
    color: var(--text-secondary);
    font: inherit;
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }
  .prose :global(.code-bar button:hover) {
    background: var(--surface-muted);
    color: var(--foreground);
  }
  .prose :global(pre) {
    margin: 0;
    padding: var(--space-4) var(--space-5);
    overflow-x: auto;
    background: #101010 !important;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.7;
    tab-size: 2;
  }
  .prose :global(pre code) {
    font-family: inherit;
  }

  /* Tables: hairline rows, scrolling sideways on their own when too wide. */
  .prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--text-base);
  }
  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-3) var(--space-6) var(--space-3) 0;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    color: var(--text-secondary);
    font-weight: 500;
  }

  /* After the text. */
  .end {
    display: grid;
    gap: var(--space-10);
    margin-top: var(--space-8);
  }
  .end p {
    margin: 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--text-secondary);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }
  .tag:hover {
    border-color: var(--border-strong);
    color: var(--foreground);
  }
  .share {
    display: grid;
    gap: var(--space-3);
  }
  .share > p,
  .author-box .mono {
    color: var(--text-secondary);
  }
  /* X and LinkedIn: their logo alone, in a square button. */
  .share-actions a.btn {
    width: var(--control-height-md);
    padding: 0;
  }
  .share-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .author-box {
    display: flex;
    align-items: flex-start;
    gap: var(--space-5);
    padding-block: var(--space-8);
    border-block: 1px solid var(--border);
  }
  .author-box > div {
    display: grid;
    gap: var(--space-1);
  }
  .author-name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
  }
  .bio {
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  .author-links {
    display: flex;
    gap: var(--space-5);
    margin-top: var(--space-2) !important;
  }

  .around {
    display: grid;
    gap: var(--space-6);
  }
  .around-link {
    display: grid;
    gap: var(--space-1);
