---
import { PICS } from "../data/pics";
import type { Dict } from "../i18n";

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const p = t.picsPage;
---

<!-- Pics: Joel's own photographs in a bento grid. Twelve columns on desktop; each photo takes 4, 6
     or 8 of them, so wide and tall frames alternate and the rows pack dense. On tablets the grid
     drops to three equal columns, on phones to two: the mix of 4:3 and 3:4 keeps the wall varied. -->
<section class="pics container" aria-labelledby="pics-title">
  <header class="head">
    <a class="back" href={p.backHref}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      {p.back}
    </a>
    <h1 id="pics-title" class="display-lg">{p.title}</h1>
    <p class="lede">{p.lede}</p>
    <p class="note">{p.note}</p>
  </header>

  <div class="bento">
    {
      PICS.map((pic) => (
        <figure class={`span-${pic.span}`} style={`--ratio:${pic.width}/${pic.height}`}>
          <img
            src={pic.src}
            alt={pic.alt}
            width={pic.width}
            height={pic.height}
            loading="lazy"
            decoding="async"
            draggable="false"
          />
        </figure>
      ))
    }
  </div>
</section>

<style>
  .pics {
    display: grid;
    align-content: start;
    gap: var(--space-12);
    padding-block: var(--space-8) var(--section);
  }
  .head {
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    justify-self: start;
    min-height: 2.75rem;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .back:hover {
    color: var(--foreground);
  }
  .note {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  /* ─── The bento: twelve columns, photos packed dense so no gap opens up ─── */
  .bento {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-flow: dense;
    gap: var(--space-4);
  }
  .bento > * {
    grid-column: span 4;
    margin: 0;
    border-radius: var(--radius-surface);
    overflow: hidden;
  }
  .bento > .span-6 {
    grid-column: span 6;
  }
  .bento > .span-8 {
    grid-column: span 8;
  }
  .bento img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: var(--ratio);
    object-fit: cover;
    transition: scale var(--duration-standard) var(--ease-standard);
  }
  .bento > *:hover img {
    scale: 1.03;
  }

  /* Tablet: three equal columns. Phone: two. The frames keep their own ratios, so the wall stays
     varied without any spans. */
  @media (max-width: 56rem) {
    .bento {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-3);
    }
    .bento > *,
    .bento > .span-6,
    .bento > .span-8 {
      grid-column: span 1;
    }
  }
  @media (max-width: 39.99rem) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-2);
    }
    .bento > * {
      border-radius: var(--radius-panel);
    }
  }
</style>
