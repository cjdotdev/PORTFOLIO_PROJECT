---
import { SONGS, songId } from "../data/passions";
import type { Dict } from "../i18n";

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const m = t.musicPage;
const songs = SONGS.map((song) => ({ ...song, id: songId(song) }));
const labels = JSON.stringify({ play: m.play, pause: m.pause, loading: m.loading, ready: m.ready, playing: m.playing });
const first = songs[0];
---

<div class="music-page container" data-music-page data-songs={JSON.stringify(songs)} data-labels={labels}>

  <div class="deck-grid">
    <figure class="stage" data-deck-stage>
      <div class="flat" aria-hidden="true">
        <div class="cd" data-cd>
          <img data-fallback src={first.cover} alt="" width="400" height="400" decoding="async" />
        </div>
        <svg class="ring" viewBox="0 0 100 100" aria-hidden="true">
          <circle class="ring-track" cx="50" cy="50" r="49" pathLength="1"></circle>
          <circle class="ring-fill" data-ring cx="50" cy="50" r="49" pathLength="1"></circle>
        </svg>
      </div>
      <canvas class="meter" data-meter aria-hidden="true"></canvas>
            <figcaption class="sr-only">{m.scene}</figcaption>
    </figure>

    <div class="player">
      <header class="page-head">
        <a class="back" href={m.backHref}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          {m.back}
        </a>
        <h1 class="display-lg">{m.title}</h1>
        <p class="lede">{m.lede}</p>
      </header>
      <div class="now">
        <p class="status" data-status aria-live="polite">{m.loading}</p>
        <h2 class="now-title" id="now-title" data-title>{first.title}</h2>
        <p class="now-meta" data-meta>{first.artist} · {first.album} · {first.year}</p>

        <div class="progress">
          <span class="track" aria-hidden="true"><span class="fill" data-bar></span></span>
          <span class="time"><span data-elapsed>0:00</span> / 0:30</span>
        </div>

        <div class="controls">
          <button class="round" type="button" data-prev aria-label={m.prev}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 5v14M19 5.5v13L9 12z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
          </button>
          <button class="round play" type="button" data-toggle data-state="play" aria-label={m.play}>
            <svg class="icon-play" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
            <svg class="icon-pause" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M8 5.5v13M16 5.5v13" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path></svg>
          </button>
          <button class="round" type="button" data-next aria-label={m.next}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M18 5v14M5 5.5v13L15 12z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
          </button>
          <a class="apple" data-apple href={first.url} target="_blank" rel="noopener noreferrer">{m.listen}</a>
        </div>
      </div>

      <h2 class="list-title">{m.playlist}</h2>
      <ol class="tracks" role="list">
        {
          songs.map((song, i) => (
            <li>
              <button type="button" data-track={i} aria-current={i === 0 ? "true" : undefined}>
                <img src={song.cover} alt="" width="400" height="400" loading="lazy" decoding="async" />
                <span class="track-text">
                  <span class="track-title">{song.title}</span>
                  <span class="track-artist">{song.artist}</span>
                </span>
                <span class="eq" aria-hidden="true">
                  <span />
                  <span />
                  <span />
                </span>
              </button>
            </li>
          ))
        }
      </ol>
      <p class="note">{m.note}</p>
    </div>
  </div>

  <audio data-audio preload="none" crossorigin="anonymous"></audio>
</div>

<script>
  import { readSongs } from "../lib/music/support";
  import { mountPlayer } from "../lib/music/player";
  import { mountFlat } from "../lib/music/flat";
  import { mountMeter } from "../lib/music/meter";

  const root = document.querySelector<HTMLElement>("[data-music-page]");
  if (root) {
    const songs = readSongs(root);
    const player = mountPlayer(root, songs, JSON.parse(root.dataset.labels ?? "{}"));
    const stage = root.querySelector<HTMLElement>("[data-deck-stage]")!;
    // The flat CD everywhere: the 3D deck (lib/music/deck.ts) is set aside for now, it made the songs
    // slow to start.
    mountMeter(stage.querySelector("[data-meter]")!, root.querySelector("[data-audio]")!);
    player.attach(mountFlat(stage, songs, { onLoaded: (i) => player.onLoaded(i) }));
  }
</script>

<style>
  .music-page {
    padding-block: var(--space-4) var(--section);
  }
  .page-head {
    display: grid;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    justify-self: start;
    min-height: 2.75rem;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .back:hover {
    color: var(--foreground);
  }

  .deck-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
    align-items: start;
  }

  /* ─── The CD: on the page ground, no frame ─── */
  /* It holds the first screen on the left and stays there while the playlist scrolls. */
  .stage {
    position: sticky;
    top: 4.75rem;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--space-8);
    height: calc(100svh - 6rem);
    min-height: 28rem;
    max-height: 56rem;
    margin: 0;
  }
  .flat {
    display: grid;
    place-items: center;
    width: 100%;
  }
  /* The level meter: the song's real bars under the disc. */
  .meter {
    display: block;
    width: min(70%, 28rem);
    height: 3rem;
    color: var(--accent);
  }
  /* The time ring: a thin circle just outside the disc, filling in the accent as the song plays. */
  .ring {
    grid-area: 1 / 1;
    width: calc(min(70%, 28rem) + 2.5rem);
    aspect-ratio: 1;
    overflow: visible;
    transform: rotate(-90deg);
    pointer-events: none;
  }
  .ring circle {
    fill: none;
    stroke-width: 0.6;
  }
  .ring-track {
    stroke: var(--border);
  }
  .ring-fill {
    stroke: var(--accent);
    stroke-linecap: round;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 250ms linear;
  }
  .cd {
    grid-area: 1 / 1;
    position: relative;
    width: min(70%, 28rem);
    aspect-ratio: 1;
    container-type: inline-size;
  }
  .cd img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--surface-muted);
    object-fit: cover;
    /* Label from 38% of the radius out; the 30 to 38% band is the silvered stacking ring; inside
       it the clear hub, and the hole at 12.5%. */
    mask: radial-gradient(circle closest-side, transparent 12.5%, rgb(0 0 0 / 0.14) 12.8%, rgb(0 0 0 / 0.14) 30%, #000 30.3%);
    will-change: transform;
  }
  /* The rim and the stacking ring catch the light; they stay still while the label turns. */
  .cd::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid color-mix(in srgb, var(--foreground) 14%, transparent);
    border-radius: 50%;
    pointer-events: none;
  }
  .cd::before {
    content: "";
    position: absolute;
    inset: 31%;
    z-index: 1;
    border: 4cqi solid color-mix(in srgb, var(--foreground) 22%, var(--background));
    border-radius: 50%;
    pointer-events: none;
  }

  /* ─── Player ─── */
  .player {
    display: grid;
    gap: var(--space-4);
  }
  .now {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-surface);
    background: var(--surface);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .status::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }
  [data-loading] .status::before {
    background: var(--border-strong);
  }
  .now-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.25rem);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
    line-height: 1.1;
    text-wrap: balance;
  }
  .now-meta {
    margin: 0;
    color: var(--text-secondary);
  }
  .progress {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .track {
    display: block;
    height: 4px;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background: var(--border);
  }
  .fill {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 250ms linear;
  }
  .time {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .round {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--foreground);
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard),
      transform var(--duration-instant) var(--ease-standard);
  }
  .round:hover {
    border-color: var(--foreground);
  }
  .round:active {
    transform: scale(0.94);
  }
  .round.play {
    width: 3.5rem;
    height: 3.5rem;
    border-color: transparent;
    background: var(--primary);
    color: var(--primary-foreground);
  }
  .round.play:hover {
    background: color-mix(in srgb, var(--primary) 86%, var(--background));
  }
  .play .icon-pause,
  .play[data-state="pause"] .icon-play {
    display: none;
  }
  .play[data-state="pause"] .icon-pause {
    display: block;
  }
  .apple {
    margin-left: auto;
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
    text-underline-offset: 0.22em;
  }
  .apple:hover {
    text-decoration-color: currentColor;
  }

  .list-title {
    margin: var(--space-4) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
  }
  .tracks {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
  }
  .tracks button {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    min-height: 4rem;
    padding: var(--space-2) var(--space-3) var(--space-2) var(--space-2);
    border: 0;
    border-radius: var(--radius-control);
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-standard);
  }
  .tracks button:hover {
    background: var(--surface-muted);
  }
  .tracks button[aria-current] {
    background: var(--accent-subtle);
  }
  .tracks img {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--surface-muted);
    transition: transform var(--duration-spring) var(--ease-spring);
  }
  .tracks button[aria-current] img {
    transform: rotate(-24deg) scale(1.04);
  }
  .track-text {
    display: grid;
    min-width: 0;
  }
  .track-title {
    overflow: hidden;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  [aria-current] .track-title {
    color: var(--accent-strong);
  }
  .track-artist {
    overflow: hidden;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* Three bars that bounce on the row that is playing. */
  .eq {
    display: none;
    align-items: end;
    gap: 2px;
    height: 0.875rem;
  }
  .eq span {
    width: 3px;
    height: 100%;
    border-radius: 1px;
    background: var(--accent);
    transform-origin: bottom;
  }
  [data-playing] .eq {
    display: flex;
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-playing] .eq span {
      animation: eq 0.9s var(--ease-in-out) infinite alternate;
    }
    [data-playing] .eq span:nth-child(2) {
      animation-delay: -0.3s;
    }
    [data-playing] .eq span:nth-child(3) {
      animation-delay: -0.6s;
    }
  }
  @keyframes eq {
    from {
      transform: scaleY(0.25);
    }
    to {
      transform: scaleY(1);
    }
  }
  .note {
    margin: var(--space-2) 0 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  @media (max-width: 55rem) {
    .deck-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    /* On a phone the order reads title, deck, then the controls and the playlist. */
    .player {
      display: contents;
    }
    .page-head {
      order: -2;
    }
    .now,
    .list-title,
    .tracks,
    .note {
      margin-inline: 0;
    }
    .stage {
      position: relative;
      top: 0;
      order: -1;
      gap: var(--space-6);
      height: auto;
      min-height: 0;
      max-height: none;
      padding-block: var(--space-2) var(--space-4);
    }
    .meter {
      width: min(80%, 22rem);
      height: 2.5rem;
    }
    .cd {
      width: min(80%, 22rem);
    }
    .ring {
      width: calc(min(80%, 22rem) + 1.75rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ring-fill,
    .tracks img,
    .fill {
      transition: none;
    }
  }
</style>
