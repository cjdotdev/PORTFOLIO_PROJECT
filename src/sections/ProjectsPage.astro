---
import WorkItem from "../components/WorkItem.astro";
import { PROJECTS } from "../data";
import BackLink from "../components/BackLink.astro";
import { localePath, type Dict, type Locale } from "../i18n";

interface Props {
  t: Dict;
  locale: Locale;
}

const { t, locale } = Astro.props;
---

<header class="page-head container">
  <BackLink href={localePath(locale, "/")} label={t.nav.backHome} />
  <h1 class="display-lg">{t.projectsPage.title}</h1>
  <p class="lede">{t.projectsPage.lede}</p>
</header>

<div class="list container">
  {
    PROJECTS.map((project) => (
      <div class="reveal">
        <WorkItem project={project} t={t} locale={locale} level={2} />
      </div>
    ))
  }
</div>

<style>
  .page-head {
    display: grid;
    gap: var(--space-4);
  }
  .list {
    display: grid;
    gap: clamp(4rem, 3rem + 4vw, 7rem);
  }
</style>
