---
import WorkItem from "../components/WorkItem.astro";
import { PROJECTS } from "../data";
import type { Dict } from "../i18n";

interface Props {
  t: Dict;
}

const { t } = Astro.props;
---

<header class="page-head container">
  <h1 class="display-lg">{t.projectsPage.title}</h1>
  <p class="lede">{t.projectsPage.lede}</p>
</header>

<div class="list container">
  {
    PROJECTS.map((project) => (
      <div class="reveal">
        <WorkItem project={project} t={t} level={2} />
      </div>
    ))
  }
</div>

<style>
  .page-head {
    display: grid;
    gap: var(--space-4);
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) clamp(3rem, 2rem + 3vw, 5rem);
  }
  .list {
    display: grid;
    gap: clamp(4rem, 3rem + 4vw, 7rem);
  }
</style>
