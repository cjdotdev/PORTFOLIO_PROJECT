---
import Hero from "../components/Hero.astro";
import WhereAmI from "../components/WhereAmI.astro";
import ProjectsShowcase from "../components/ProjectsShowcase.astro";
import PostList from "../components/PostList.astro";
import Contact from "../components/Contact.astro";
import Passions from "../components/Passions.astro";
import { EXPERIENCE } from "../data";
import { getBlogPosts } from "../lib/hashnode";
import { localePath, type Dict, type Locale } from "../i18n";

interface Props {
  t: Dict;
  locale: Locale;
}

const { t, locale } = Astro.props;
const posts = getBlogPosts().slice(0, 3);
const month = new Intl.DateTimeFormat(locale === "fr" ? "fr-FR" : "en-US", {
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
---

<Hero t={t} locale={locale} />

<WhereAmI t={t} locale={locale} />

<ProjectsShowcase t={t} locale={locale} />

<section class="section container about reveal" aria-labelledby="about-title">
  <h2 id="about-title" class="display">{t.about.title}</h2>
  <div class="about-body">
    {t.about.body.map((paragraph) => <p>{paragraph}</p>)}
  </div>
  <div class="experience">
    <h3 class="label">{t.experience.title}</h3>
    <ul role="list">
      {
        EXPERIENCE.map((job) => (
          <li>
            <p class="job">
              <span>{t.experience.items[job.id].role}</span>
              <a class="link" href={job.site} target="_blank" rel="noopener noreferrer">
                {job.company}
              </a>
            </p>
            <p class="dates">
              <time datetime={job.start}>{month.format(new Date(`${job.start}-01`))}</time>
              {" – "}
              {job.end ? (
                <time datetime={job.end}>{month.format(new Date(`${job.end}-01`))}</time>
              ) : (
                t.experience.present
              )}
            </p>
            <p class="desc">{t.experience.items[job.id].desc}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="section container stack-md reveal" aria-labelledby="writing-title">
  <div class="head">
    <div class="head-text">
      <h2 id="writing-title" class="display">{t.writing.title}</h2>
      <p class="lede">
        {t.writing.lede}
        {t.writing.englishNote && <> {t.writing.englishNote}</>}
      </p>
    </div>
    <a class="link more" href={localePath(locale, "/blog/")}>{t.writing.all}</a>
  </div>
  <PostList posts={posts} t={t} locale={locale} />
</section>

<Passions t={t} />

<Contact t={t} />

<style>
  .stack-md {
    display: grid;
    gap: var(--space-8);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
  }
  .head-text {
    display: grid;
    gap: var(--space-3);
  }
  .more {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .about {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-8) clamp(2rem, 1rem + 4vw, 5rem);
  }
  .about-body {
    display: grid;
    gap: var(--space-4);
    max-width: 38rem;
    font-size: var(--text-lg);
    text-wrap: pretty;
  }
  .experience {
    grid-column: 2;
    display: grid;
    gap: var(--space-3);
  }
  .label {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .experience li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-1) var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid var(--border);
  }
  .job {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-weight: 500;
  }
  .dates {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }
  .desc {
    grid-column: 1 / -1;
    max-width: 38rem;
    color: var(--text-secondary);
  }
  @media (max-width: 55rem) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }
    .experience {
      grid-column: 1;
    }
  }
</style>
