---
import Hero from "../components/Hero.astro";
import WhereAmI from "../components/WhereAmI.astro";
import ProjectDeck from "../components/ProjectDeck.astro";
import AboutStory from "../components/AboutStory.astro";
import PostList from "../components/PostList.astro";
import Contact from "../components/Contact.astro";
import Passions from "../components/Passions.astro";
import { EXPERIENCE } from "../data";
import { getBlogPosts } from "../lib/hashnode";
import { localePath, type Dict, type Locale } from "../i18n";

interface Props {
  t: Dict;
  locale: Locale;
}

const { t, locale } = Astro.props;
const posts = getBlogPosts().slice(0, 3);
const month = new Intl.DateTimeFormat(locale === "fr" ? "fr-FR" : "en-US", {
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
---

<Hero t={t} locale={locale} />

<ProjectDeck t={t} locale={locale} />

<section class="section container about reveal" aria-labelledby="about-title">
  <h2 id="about-title" class="display">{t.about.title}</h2>
  <AboutStory t={t} />
  <div class="experience">
    <h3 class="experience-title">{t.experience.title}</h3>
    <ul role="list">
      {
        EXPERIENCE.map((job) => (
          <li>
            <a class="company" href={job.site} target="_blank" rel="noopener noreferrer">
              {job.company}
            </a>
            <p class="role">{t.experience.items[job.id].role}</p>
            <p class="dates">
              <time datetime={job.start}>{month.format(new Date(`${job.start}-01`))}</time>
              {" – "}
              {job.end ? (
                <time datetime={job.end}>{month.format(new Date(`${job.end}-01`))}</time>
              ) : (
                t.experience.present
              )}
            </p>
            <p class="desc">{t.experience.items[job.id].desc}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="section container stack-md reveal" aria-labelledby="writing-title">
  <div class="head">
    <div class="head-text">
      <h2 id="writing-title" class="display">{t.writing.title}</h2>
      <p class="lede">
        {t.writing.lede}
        {t.writing.englishNote && <> {t.writing.englishNote}</>}
      </p>
    </div>
    <a class="link more" href={localePath(locale, "/blog/")}>{t.writing.all}</a>
  </div>
  <PostList posts={posts} t={t} locale={locale} />
</section>

<WhereAmI t={t} locale={locale} />

<Passions t={t} />

<Contact t={t} />

<style>
  .stack-md {
    display: grid;
    gap: var(--space-8);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
  }
  .head-text {
    display: grid;
    gap: var(--space-3);
  }
  .more {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .about {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-8) clamp(2rem, 1rem + 4vw, 5rem);
  }
  /* The help sentence takes the section's full width, between the lines about Joel and his experience. */
  /* The title, then the three phases told as the page scrolls, take the full width. */
  .about > #about-title,
  .about > :global(.story) {
    grid-column: 1 / -1;
  }
  /* Where Joel does all of it today: the closing line of the section, between two hairlines. Each
     job is a row: the company large, then the role and the dates centred on it, the description
     under the role. Past jobs, once added, stack as more rows of the same table. */
  .experience {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-8);
  }
  .experience-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.1rem + 0.8vw, 1.75rem);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
  }
  .experience ul {
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--border);
  }
  .experience li {
    display: grid;
    /* The company takes only its width, so the role sits just after it. */
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--space-2) clamp(1.5rem, 0.75rem + 2vw, 3rem);
    align-items: center;
    padding-block: var(--space-6);
    border-top: 1px solid var(--border);
  }
  .company {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.4rem + 2.6vw, 3.75rem);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
    line-height: 1.05;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 0.04em;
    text-underline-offset: 0.14em;
    transition: text-decoration-color var(--duration-fast) var(--ease-standard);
  }
  .company:hover {
    text-decoration-color: currentColor;
  }
  .role {
    font-size: var(--text-lg);
    font-weight: 500;
  }
  .dates {
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .desc {
    grid-column: 2 / -1;
    max-width: 38rem;
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  @media (max-width: 55rem) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* Narrow: the company on its own line, then the role and dates, then the description. */
  @media (max-width: 47.99rem) {
    .experience li {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .company,
    .desc {
      grid-column: 1 / -1;
    }
  }

</style>
