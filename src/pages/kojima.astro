---
import Layout from "../layouts/Layout.astro";
import KojimaStory from "../sections/KojimaStory.astro";
import { getDict } from "../i18n";

const t = getDict("en");
---

<Layout
  t={t}
  locale="en"
  alternate={{ en: "/kojima/", fr: "/fr/kojima/" }}
  current="kojima"
  title={t.meta.kojimaTitle}
  description={t.meta.kojimaDescription}
>
  <link slot="head" rel="preload" href="/fonts/noto-serif-jp-kojima-500.woff2" as="font" type="font/woff2" crossorigin />
  <KojimaStory t={t} />
</Layout>
