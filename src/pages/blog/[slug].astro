---
import { getImage } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Article from "../../sections/Article.astro";
import { getDict } from "../../i18n";
import { getPosts, postPath, type LocalPost } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts("en");
  // Newest first: the previous post is the older one, the next post the newer one.
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: { post, previous: posts[i + 1], next: posts[i - 1] },
  }));
}

interface Props {
  post: LocalPost;
  previous?: LocalPost;
  next?: LocalPost;
}

const { post, previous, next } = Astro.props;
const t = getDict("en");
const { data } = post.entry;
const share = data.cover ? await getImage({ src: data.cover, width: 1200, height: 630, format: "jpg", fit: "cover" }) : undefined;
---

<!-- A post missing in this language shows in the other one; its canonical is then that version's page. -->
<Layout
  t={t}
  locale="en"
  alternate={{ en: postPath("en", post.slug), fr: postPath("fr", post.slug) }}
  canonicalPath={postPath(post.lang, post.slug)}
  current="writing"
  title={`${data.title}, Joel Codja`}
  description={data.subtitle}
  article={{ image: share?.src, published: data.date, modified: data.updated, tags: data.tags, lang: post.lang }}
>
  <Article post={post} previous={previous} next={next} t={t} locale="en" />
</Layout>
