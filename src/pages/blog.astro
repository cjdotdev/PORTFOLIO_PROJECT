---
import Layout from "../layouts/Layout.astro";
import BlogPage from "../sections/BlogPage.astro";
import { getDict } from "../i18n";

const t = getDict("en");
---

<Layout
  t={t}
  locale="en"
  alternate={{ en: "/blog/", fr: "/fr/blog/" }}
  current="writing"
  title={t.meta.blogTitle}
  description={t.meta.blogDescription}
>
  <BlogPage t={t} locale="en" />
</Layout>
