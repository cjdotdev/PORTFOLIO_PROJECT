---
import Layout from "../../layouts/Layout.astro";
import MusicPage from "../../sections/MusicPage.astro";
import { MUSIC_PAGE } from "../../data";
import { getDict } from "../../i18n";

const t = getDict("fr");
---

<Layout
  t={t}
  locale="fr"
  alternate={{ en: "/music/", fr: "/fr/music/" }}
  current="music"
  title={t.meta.musicTitle}
  description={t.meta.musicDescription}
  noindex={!MUSIC_PAGE}
>
  <link slot="head" rel="preconnect" href="https://audio-ssl.itunes.apple.com" crossorigin />
  <MusicPage t={t} />
</Layout>
