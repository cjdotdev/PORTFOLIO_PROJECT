---
import Layout from "../../layouts/Layout.astro";
import ProjectsPage from "../../sections/ProjectsPage.astro";
import { getDict } from "../../i18n";
import { PROJECTS_PAGE } from "../../data";

const t = getDict("fr");
---

<Layout
  t={t}
  locale="fr"
  alternate={{ en: "/projects/", fr: "/fr/projects/" }}
  current="work"
  title={t.meta.projectsTitle}
  description={t.meta.projectsDescription}
  noindex={!PROJECTS_PAGE}
>
  <ProjectsPage t={t} />
</Layout>
