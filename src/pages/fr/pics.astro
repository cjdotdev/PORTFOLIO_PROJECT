---
import Layout from "../../layouts/Layout.astro";
import PicsPage from "../../sections/PicsPage.astro";
import { getDict } from "../../i18n";

const t = getDict("fr");
---

<Layout
  t={t}
  locale="fr"
  alternate={{ en: "/pics/", fr: "/fr/pics/" }}
  current="pics"
  title={t.meta.picsTitle}
  description={t.meta.picsDescription}
>
  <PicsPage t={t} />
</Layout>
