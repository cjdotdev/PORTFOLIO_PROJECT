---
import { PERSONAL } from "../data";

interface Props {
  /** Rises in on load (hero only). */
  rise?: boolean;
  /** The pronunciation sits at the top-right of the letters. */
  say?: string;
  /** Decorative repeat (footer): hidden from assistive tech, which already heard the name. */
  decorative?: boolean;
}

const { rise = false, say, decorative = false } = Astro.props;
---

<div class:list={["monument", { rise }]} aria-hidden={decorative ? "true" : undefined}>
  <p class="word">
    {PERSONAL.surname.split("").map((letter, index) => <span style={`--i:${index}`}>{letter}</span>)}
  </p>
  {
    say && (
      <p class="say">
        <span class="first">{PERSONAL.name.split(" ")[0]}</span>
        <span class="ipa">{PERSONAL.pronunciation}</span>
        <span>{say}</span>
      </p>
    )
  }
</div>

<style>
  /* The surname spans the container exactly: in Monoton, "CODJA" is 4 em of ink from the C to the A,
     so a font size of a quarter of the container's inline size fills it, and it never wraps. The
     letters stand 0.88 em tall with their overshoot, which the 0.9 line height holds. */
  .monument {
    position: relative;
    display: flex;
    flex-direction: column;
    container-type: inline-size;
  }
  /* The footer repeat is decoration: it should not be picked up by a text selection. */
  .monument[aria-hidden="true"] {
    user-select: none;
  }
  /* The surname is a mark, not text to copy: it cannot be selected (the page's own name is in the
     h1 and the header). */
  .word {
    -webkit-user-select: none;
    user-select: none;
    display: flex;
    font-family: "Monoton", var(--font-display);
    font-size: calc(100cqi * 0.25);
    font-weight: 400;
    line-height: 0.9;
    text-transform: uppercase;
    white-space: nowrap;
    /* The C's side bearing: the ink starts flush with the container. */
    margin-left: -0.027em;
  }
  /* The pronunciation annotates the letters from under the baseline, right-aligned on the A, so it
     never reads as one more line of the portrait caption above. */
  .say {
    display: flex;
    justify-content: end;
    gap: var(--space-2);
    margin-top: var(--space-3);
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
  .say .ipa {
    color: var(--foreground);
    font-weight: 500;
  }
  .first {
    display: none;
  }

  /* Phone: the name becomes a lockup at the top of the hero. "Joel" and the pronunciation sit on
     one line above the surname, which runs edge to edge (a 6px margin from the screen), as large as
     one line allows, so it reads as a name and not as stray letters. */
  @media (max-width: 47.99rem) {
    .monument {
      margin-inline: calc(var(--gutter) * -1 + 0.375rem);
    }
    .say {
      order: -1;
      align-items: baseline;
      margin: 0 0 var(--space-2);
      padding-inline: calc(var(--gutter) - 0.375rem);
    }
    .first {
      display: inline;
      margin-right: auto;
      color: var(--foreground);
      font-family: var(--font-display);
      font-size: var(--text-xl);
      font-weight: 500;
      letter-spacing: -0.02em;
    }
  }

  /* One authored moment: the letters rise out of the baseline in sequence. Visible by default;
     the animation only runs when motion is welcome. */
  .word span {
    display: inline-block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .word {
      overflow: clip;
      overflow-clip-margin: 0.08em;
    }
    .rise .word span {
      animation: rise 1s var(--ease-enter) both;
      animation-delay: calc(80ms + var(--i) * 70ms);
    }
    /* While the opening title plays, the letters wait below the baseline; they rise the moment it
       ends (or is skipped), as the mark lands in the header. */
    :global(html[data-intro="on"]) .rise .word span {
      animation-play-state: paused;
    }
  }
  @keyframes rise {
    from {
      translate: 0 92%;
    }
    to {
      translate: 0 0;
    }
  }
</style>
