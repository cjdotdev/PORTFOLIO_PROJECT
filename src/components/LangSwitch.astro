---
/**
 * The language switch. In the header ("menu"): the current flag and code open a small panel of both
 * languages, each with its flag and written in itself, with a highlight gliding between the rows, the current
 * one ticked and a note that the blog stays in English. In the phone sheet ("list") the same rows sit
 * inline. Choosing the other language sweeps its row with the accent, then opens that version of the
 * page. Keyboard follows Arc's dropdown menu: Enter, Space or ArrowDown open; ArrowUp and ArrowDown
 * move and loop; Home and End jump; E or F pick by letter; Escape closes and returns focus. Without
 * JavaScript the panel stays closed and the trigger itself links to the other language.
 */
import Flag from "./Flag.astro";
// Phosphor Icons (MIT): a seal with a tick for the current language, the translate sign for the other.
import sealCheck from "@phosphor-icons/core/assets/fill/seal-check-fill.svg?raw";
import translate from "@phosphor-icons/core/assets/regular/translate.svg?raw";
import type { Dict, Locale } from "../i18n";

interface Props {
  t: Dict;
  locale: Locale;
  /** The same page in the other language. */
  href: string;
  variant?: "menu" | "list";
}

const { t, locale, href, variant = "menu" } = Astro.props;
// Each row speaks its own language: these strings are the same on every page.
const rows: { code: Locale; name: string; detail: string }[] = [
  { code: "en", name: "English", detail: "This page in English" },
  { code: "fr", name: "Français", detail: "Cette page en français" },
];
const panelId = `lang-${variant}`;
---

<div class:list={["lang", variant]} data-lang data-variant={variant}>
  {
    variant === "menu" && (
      <a
        class="trigger"
        href={href}
        role="button"
        aria-haspopup="menu"
        aria-expanded="false"
        aria-controls={panelId}
        aria-label={`${t.nav.language}: ${rows.find((row) => row.code === locale)?.name}`}
        data-lang-trigger
      >
        <span class="trigger-flag">
          <Flag code={locale} size={18} />
        </span>
        <span class="code">{locale.toUpperCase()}</span>
        <svg class="chevron" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
          <path class="up" d="M8 9.5l4-4 4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          <path class="down" d="M8 14.5l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    )
  }
  <div class="panel" id={panelId} role={variant === "menu" ? "menu" : undefined} aria-label={t.nav.language} data-lang-panel hidden={variant === "menu"}>
    <span class="glide" aria-hidden="true" data-lang-glide></span>
    {
      rows.map((row) => {
        const current = row.code === locale;
        return (
          <a
            class="row"
            href={current ? undefined : href}
            role={variant === "menu" ? "menuitem" : undefined}
            aria-current={current ? "true" : undefined}
            aria-disabled={current && variant === "menu" ? "true" : undefined}
            tabindex={variant === "menu" ? "-1" : current ? undefined : "0"}
            hreflang={row.code}
            lang={row.code}
            data-lang-row={row.code}
            data-key={row.code === "en" ? "e" : "f"}
          >
            <span class="badge" aria-hidden="true">
              <Flag code={row.code} size={30} />
            </span>
            <span class="text">
              <span class="name">
                {row.name} <span class="tag">{row.code.toUpperCase()}</span>
              </span>
              <span class="detail">{row.detail}</span>
            </span>
            {current ? (
              <span class="state current-state" aria-hidden="true" set:html={sealCheck} />
            ) : (
              <span class="state go" aria-hidden="true" set:html={translate} />
            )}
            <span class="sweep" aria-hidden="true" />
          </a>
        );
      })
    }
  </div>
</div>

<script>
  const calm = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>("[data-lang]").forEach((root) => {
    const panel = root.querySelector<HTMLElement>("[data-lang-panel]")!;
    const glide = root.querySelector<HTMLElement>("[data-lang-glide]")!;
    const rows = [...root.querySelectorAll<HTMLAnchorElement>("[data-lang-row]")];
    const trigger = root.querySelector<HTMLAnchorElement>("[data-lang-trigger]");
    const isMenu = root.dataset.variant === "menu";

    // The highlight glides to the row under the pointer, and jumps for the keyboard.
    function highlight(row: HTMLElement | undefined, instant = false) {
      if (!row) {
        glide.style.opacity = "0";
        return;
      }
      glide.toggleAttribute("data-instant", instant || calm.matches);
      glide.style.opacity = "1";
      glide.style.translate = `0 ${row.offsetTop}px`;
      glide.style.height = `${row.offsetHeight}px`;
    }

    // Choosing the other language: the accent sweeps the row, then the page changes.
    function choose(row: HTMLAnchorElement) {
      if (!row.href) {
        if (isMenu) close(true);
        return;
      }
      if (calm.matches) {
        window.location.assign(row.href);
        return;
      }
      root.setAttribute("data-leaving", "");
      row.setAttribute("data-chosen", "");
      window.setTimeout(() => window.location.assign(row.href), 320);
    }

    rows.forEach((row) => {
      row.addEventListener("pointerenter", () => highlight(row));
      row.addEventListener("focus", () => highlight(row, true));
      row.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey) return;
        event.preventDefault();
        choose(row);
      });
    });
    panel.addEventListener("pointerleave", () => {
      const focused = rows.find((row) => row === document.activeElement);
      highlight(focused);
    });

    if (!isMenu || !trigger) return;

    const onOutside = (event: PointerEvent) => {
      if (!root.contains(event.target as Node)) close();
    };
    function open(focusIndex = rows.findIndex((row) => !row.hasAttribute("aria-current"))) {
      panel.hidden = false;
      trigger!.setAttribute("aria-expanded", "true");
      requestAnimationFrame(() => {
        root.setAttribute("data-open", "");
        rows[Math.max(0, focusIndex)]?.focus();
      });
      document.addEventListener("pointerdown", onOutside);
    }
    function close(restoreFocus = false) {
      root.removeAttribute("data-open");
      trigger!.setAttribute("aria-expanded", "false");
      panel.hidden = true;
      highlight(undefined);
      document.removeEventListener("pointerdown", onOutside);
      if (restoreFocus) trigger!.focus();
    }

    trigger.addEventListener("click", (event) => {
      event.preventDefault();
      if (panel.hidden) open();
      else close();
    });
    trigger.addEventListener("keydown", (event) => {
      if (event.key === " " || event.key === "ArrowDown") {
        event.preventDefault();
        open();
      }
    });
    panel.addEventListener("keydown", (event) => {
      const index = rows.indexOf(document.activeElement as HTMLAnchorElement);
      const go = (i: number) => rows[(i + rows.length) % rows.length].focus();
      if (event.key === "ArrowDown") go(index + 1);
      else if (event.key === "ArrowUp") go(index - 1);
      else if (event.key === "Home") go(0);
      else if (event.key === "End") go(rows.length - 1);
      else if (event.key === "Escape") close(true);
      else if (event.key === "Tab") close();
      else if (event.key === "Enter" || event.key === " ") {
        if (index >= 0) choose(rows[index]);
      } else {
        const byKey = rows.find((row) => row.dataset.key === event.key.toLowerCase());
        if (!byKey) return;
        byKey.focus();
      }
      event.preventDefault();
    });
  });
</script>

<style>
  .lang {
    position: relative;
  }

  /* ─── Trigger ─── */
  .trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 2.25rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--text-secondary);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }
  .trigger:hover,
  .lang[data-open] .trigger {
    border-color: var(--border-strong);
    color: var(--foreground);
  }
  .code {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }
  .trigger-flag {
    display: block;
    margin-left: calc(var(--space-1) * -1);
    border-radius: 50%;
    outline: 1px solid var(--border-strong);
    transition: scale var(--duration-standard) var(--ease-spring);
  }
  .trigger:hover .trigger-flag,
  .lang[data-open] .trigger-flag {
    scale: 1.1;
  }
  /* Up-and-down chevrons, the sign of a selector; they pinch together while the panel is open. */
  .chevron path {
    transition: translate var(--duration-standard) var(--ease-standard);
  }
  .lang[data-open] .chevron .up {
    translate: 0 2px;
  }
  .lang[data-open] .chevron .down {
    translate: 0 -2px;
  }

  /* ─── Panel ─── */
  .panel {
    position: relative;
    display: grid;
    gap: 2px;
  }
  .menu .panel {
    position: absolute;
    top: calc(100% + var(--space-2));
    right: 0;
    z-index: 40;
    width: 17rem;
    padding: var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-surface);
    background: var(--surface);
    opacity: 0;
    scale: 0.96;
    translate: 0 -4px;
    transform-origin: top right;
    /* Closed, the panel is gone, not just transparent: an invisible panel would still take the clicks
       meant for whatever sits under it (the projects link, for one). It hides once its fade is done. */
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 160ms var(--ease-standard),
      scale 200ms var(--ease-enter),
      translate 200ms var(--ease-enter),
      visibility 0s linear 200ms;
  }
  .menu[data-open] .panel {
    opacity: 1;
    scale: 1;
    translate: 0 0;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 160ms var(--ease-standard),
      scale 200ms var(--ease-enter),
      translate 200ms var(--ease-enter),
      visibility 0s;
  }
  .glide {
    position: absolute;
    top: 0;
    right: var(--space-2);
    left: var(--space-2);
    border-radius: var(--radius-control);
    background: var(--surface-muted);
    opacity: 0;
    pointer-events: none;
    transition:
      translate 180ms cubic-bezier(0.2, 0, 0, 1),
      height 180ms cubic-bezier(0.2, 0, 0, 1),
      opacity 120ms var(--ease-standard);
  }
  .list .glide {
    right: 0;
    left: 0;
  }
  .glide[data-instant] {
    transition: opacity 120ms var(--ease-standard);
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-height: 3.25rem;
    padding: var(--space-2) var(--space-3);
    overflow: hidden;
    border-radius: var(--radius-control);
    color: var(--foreground);
    text-decoration: none;
    cursor: pointer;
    outline-offset: -2px;
  }
  .row[aria-current] {
    cursor: default;
  }
  /* The flag, ringed in terracotta on the current language. */
  .badge {
    display: block;
    border-radius: 50%;
    outline: 1px solid var(--border-strong);
    outline-offset: 0;
    transition:
      outline-color var(--duration-fast) var(--ease-standard),
      outline-offset var(--duration-fast) var(--ease-standard),
      scale var(--duration-standard) var(--ease-spring);
  }
  .row[aria-current] .badge {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .tag {
    margin-left: var(--space-1);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  .text {
    display: grid;
    min-width: 0;
  }
  .name {
    font-weight: 500;
  }
  .detail {
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
  /* The current language: a terracotta seal with a tick. The other: the translate sign, which takes
     the accent and tips over a little on hover. Both from Phosphor Icons. */
  .state {
    display: grid;
    place-items: center;
    width: 1.375rem;
    height: 1.375rem;
  }
  .state :global(svg) {
    width: 100%;
    height: 100%;
  }
  .current-state {
    color: var(--accent);
  }
  .go {
    color: var(--text-secondary);
    transition:
      color var(--duration-fast) var(--ease-standard),
      rotate var(--duration-considered) var(--ease-spring),
      scale var(--duration-considered) var(--ease-spring);
  }
  .row:hover .go,
  .row:focus-visible .go {
    color: var(--accent);
    rotate: -8deg;
    scale: 1.12;
  }
  .row:not([aria-current]):hover .badge,
  .row:not([aria-current]):focus-visible .badge {
    scale: 1.08;
  }
  /* The sweep: a band of accent that crosses the chosen row before the page changes. */
  .sweep {
    position: absolute;
    inset: 0;
    background: var(--accent-subtle);
    border-bottom: 2px solid var(--accent);
    scale: 0 1;
    transform-origin: left;
    pointer-events: none;
  }
  .row[data-chosen] .sweep {
    scale: 1 1;
    transition: scale 300ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  .row[data-chosen] .badge {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu[data-open] .row {
      animation: row-in 220ms var(--ease-enter) both;
    }
    .menu[data-open] .row:nth-of-type(2) {
      animation-delay: 40ms;
    }
  }
  @keyframes row-in {
    from {
      opacity: 0;
      translate: 0 -4px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu .panel {
      scale: 1;
      translate: 0 0;
      transition: opacity 120ms linear;
    }
    .trigger-flag,
    .badge,
    .chevron path,
    .go {
      transition: none;
    }
  }
</style>
