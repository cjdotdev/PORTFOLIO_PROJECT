---
import Mark from "./Mark.astro";
import LangSwitch from "./LangSwitch.astro";
import SocialIcons from "./SocialIcons.astro";
import { localePath, type Dict, type Locale } from "../i18n";
import { PICS_PAGE, PROJECTS_PAGE } from "../data";

interface Props {
  t: Dict;
  locale: Locale;
  current: "home" | "work" | "writing" | "pics" | "music" | "kojima" | "none";
  switchHref: string;
}

const { t, locale, current, switchHref } = Astro.props;
const home = localePath(locale, "/");
// "Projects" shows only while /projects does (PROJECTS_PAGE): the deck sits right under the hero.
const links = [
  ...(PROJECTS_PAGE ? [{ id: "work", label: t.nav.work, href: localePath(locale, "/projects/") }] : []),
  { id: "writing", label: t.nav.writing, href: localePath(locale, "/blog/") },
  ...(PICS_PAGE ? [{ id: "pics", label: t.nav.pics, href: localePath(locale, "/pics/") }] : []),
  { id: "contact", label: t.nav.contact, href: `${home}#contact` },
];
---

<!--
  Three parts, like lenis.dev: the links on the left, the CJ mark alone in the centre, the language
  switch on the right. The site is dark only, so there is no theme switch. A 64px sticky bar that
  takes the page background and a hairline once the page scrolls; under 760px the links fold into a
  sheet that drops from the bar, with a scrim behind it and the language switch at its foot, and the
  mark stays in the centre.
-->
<header class="header" data-header>
  <div class="bar container">
    <nav class="nav" aria-label={t.nav.label}>
      <ul role="list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={link.id === current ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="brand" href={home} aria-label={t.nav.home} aria-current={current === "home" ? "page" : undefined}>
      <Mark size={36} class="mark" />
    </a>

    <div class="actions">
      <SocialIcons class="wide" />
      <span class="wide"><LangSwitch t={t} locale={locale} href={switchHref} /></span>
      <button type="button" class="menu" data-menu-button aria-expanded="false" aria-controls="site-sheet" aria-label={t.nav.menu}>
        <span class="burger" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="scrim" data-menu-scrim hidden></div>
  <div class="sheet" id="site-sheet" data-menu-sheet data-lenis-prevent hidden>
    <div class="sheet-inner">
      <ul role="list">
        {
          links.map((link) => (
            <li>
              <a class="row" href={link.href} aria-current={link.id === current ? "page" : undefined}>
                {link.label}
                {link.id === current && <span class="row-dot" aria-hidden="true" />}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="sheet-actions">
        <LangSwitch t={t} locale={locale} href={switchHref} variant="list" />
        <SocialIcons class="sheet-social" buttons />
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");

  // Scrolled: the bar takes the page background and a hairline, as on makisend.lixalistudio.tech.
  const onScroll = () => header?.toggleAttribute("data-scrolled", window.scrollY > 8);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // Mobile sheet: opens under the bar, closes on the scrim, Escape, a link, or a wider screen.
  const button = header?.querySelector<HTMLButtonElement>("[data-menu-button]");
  const sheet = header?.querySelector<HTMLElement>("[data-menu-sheet]");
  const scrim = header?.querySelector<HTMLElement>("[data-menu-scrim]");
  if (header && button && sheet && scrim) {
    const setOpen = (open: boolean, restoreFocus = false) => {
      button.setAttribute("aria-expanded", String(open));
      sheet.hidden = !open;
      scrim.hidden = !open;
      header.toggleAttribute("data-open", open);
      document.documentElement.style.overflow = open ? "hidden" : "";
      if (open) sheet.querySelector<HTMLElement>("a, button")?.focus();
      else if (restoreFocus) button.focus();
    };
    button.addEventListener("click", () => setOpen(button.getAttribute("aria-expanded") !== "true"));
    scrim.addEventListener("click", () => setOpen(false));
    sheet.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !sheet.hidden) setOpen(false, true);
    });
    window.matchMedia("(min-width: 47.5rem)").addEventListener("change", (event) => event.matches && setOpen(false));
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid transparent;
    background: transparent;
    transition:
      background-color var(--duration-standard) var(--ease-standard),
      border-color var(--duration-standard) var(--ease-standard);
  }
  .header[data-scrolled],
  .header[data-open] {
    border-bottom-color: var(--border);
    background: var(--background);
  }
  /* Two equal outer columns keep the mark on the exact centre of the bar, whatever their contents. */
  .bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-2);
    height: 4rem;
  }
  .brand {
    grid-column: 2;
    display: inline-grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    text-decoration: none;
  }
  .brand :global(.mark) {
    flex: none;
  }
  /* Touch the earring and it swings: the J rocks on its hook and settles, the C stays put. */
  @media (prefers-reduced-motion: no-preference) {
    .brand:hover :global(.mark .cj-j),
    .brand:focus-visible :global(.mark .cj-j) {
      animation: earring 1.1s cubic-bezier(0.37, 0, 0.63, 1);
    }
  }
  @keyframes earring {
    18% {
      rotate: 11deg;
    }
    40% {
      rotate: -7deg;
    }
    60% {
      rotate: 4deg;
    }
    80% {
      rotate: -1.5deg;
    }
    to {
      rotate: 0deg;
    }
  }

  .nav {
    grid-column: 1;
    justify-self: start;
    /* The first link's text lines up with the page gutter. */
    margin-left: calc(var(--space-3) * -1);
  }
  .nav ul {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .nav a {
    display: inline-flex;
    align-items: center;
    height: 2.25rem;
    padding: 0 var(--space-3);
    border-radius: 12px;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }
  /* Lenis-style underline: it draws in from the left on hover and leaves to the right. The current
     page keeps it, in the accent. */
  .nav a {
    position: relative;
  }
  .nav a::after {
    content: "";
    position: absolute;
    right: var(--space-3);
    bottom: 0.4rem;
    left: var(--space-3);
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
  }
  .nav a:hover,
  .nav a:focus-visible {
    color: var(--foreground);
  }
  .nav a:hover::after,
  .nav a:focus-visible::after,
  .nav a[aria-current="page"]::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .nav a[aria-current="page"] {
    color: var(--accent-strong);
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav a::after {
      transition: transform 600ms var(--ease-enter);
    }
  }

  .actions {
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Menu button: two lines that cross into an X. */
  .menu {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: calc(var(--space-2) * -1);
    border: 0;
    border-radius: 12px;
    background: none;
    color: var(--foreground);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .menu:active {
    background: var(--surface-muted);
  }
  .burger {
    position: relative;
    width: 18px;
    height: 10px;
  }
  .burger span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    border-radius: 2px;
    background: currentColor;
    transition:
      top var(--duration-standard) var(--ease-standard),
      rotate var(--duration-standard) var(--ease-standard);
  }
  .burger span:first-child {
    top: 0;
  }
  .burger span:last-child {
    top: calc(100% - 1.5px);
  }
  [aria-expanded="true"] .burger span {
    top: calc(50% - 0.75px);
  }
  [aria-expanded="true"] .burger span:first-child {
    rotate: 45deg;
  }
  [aria-expanded="true"] .burger span:last-child {
    rotate: -45deg;
  }

  /* Sheet: drops from the bar and pushes nothing; the scrim closes it. */
  .scrim {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    height: 100dvh;
    background: rgb(0 0 0 / 0.16);
  }
  .sheet {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    border-bottom: 1px solid var(--border);
    background: var(--background);
  }
  .sheet-inner {
    max-height: calc(100dvh - 4rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--space-2) var(--gutter) var(--space-5);
  }
  .sheet li {
    border-bottom: 1px solid var(--border-subtle);
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.25rem;
    padding: 0 var(--space-1);
    font-size: var(--text-base);
    font-weight: 500;
    text-decoration: none;
  }
  .row-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    background: var(--accent);
  }
  .sheet-actions {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  @media (prefers-reduced-motion: no-preference) {
    .sheet:not([hidden]) {
      animation: drop var(--duration-standard) var(--ease-enter);
    }
    .scrim:not([hidden]) {
      animation: fade var(--duration-standard) var(--ease-standard);
    }
  }
  @keyframes drop {
    from {
      opacity: 0;
      translate: 0 -8px;
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  @media (max-width: 47.49rem) {
    .nav,
    .wide,
    .actions > :global(.wide) {
      display: none;
    }
    .menu {
      display: grid;
    }
  }
  @media (min-width: 47.5rem) {
    .sheet,
    .scrim {
      display: none;
    }
  }
</style>
