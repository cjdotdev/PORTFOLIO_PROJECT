---
import Monument from "./Monument.astro";
import { HERO_IMAGE } from "../lib/hero-image";
import { LOCATION, PERSONAL } from "../data";
import { localePath, type Dict, type Locale } from "../i18n";

interface Props {
  t: Dict;
  locale: Locale;
}

const { t, locale } = Astro.props;
const place = `${LOCATION.city}, ${locale === "fr" && LOCATION.country === "Benin" ? "Bénin" : LOCATION.country}`;
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="top">
    <div class="copy">
      <h1 id="hero-title" class="display-lg">
        <span class="sr-only">{PERSONAL.name}. </span>{t.hero.statement}
      </h1>
      <p class="lede">{t.hero.line}</p>
      <div class="actions">
        <a class="btn btn-primary" href={`mailto:${PERSONAL.email}`}>{t.hero.primary}</a>
        <a class="btn btn-secondary" href={localePath(locale, "/projects/")}>{t.hero.secondary}</a>
      </div>
    </div>

    <figure class="portrait">
      {/* Static, preloaded WebP with an inline placeholder: see src/lib/hero-image.ts. */}
      <img
        src={HERO_IMAGE.src}
        srcset={HERO_IMAGE.srcset}
        sizes={HERO_IMAGE.sizes}
        width={HERO_IMAGE.width}
        height={HERO_IMAGE.height}
        alt={t.hero.portraitAlt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        style={`background-image: url(${HERO_IMAGE.placeholder})`}
      />
      <figcaption>
        <span class="live" aria-hidden="true"></span>
        <span data-where="place">{place}</span>
        <span class="time mono" data-local-time data-tz={LOCATION.timezone}></span>
        <span class="sr-only">{t.hero.localTime}</span>
      </figcaption>
    </figure>
  </div>

  <Monument rise say={t.hero.say} />
</section>

<script>
  // Joel's local time next to the city, refreshed each minute. Empty until the script runs.
  function tick() {
    document.querySelectorAll<HTMLElement>("[data-local-time]").forEach((element) => {
      const tz = element.dataset.tz || "UTC";
      element.textContent = new Intl.DateTimeFormat(document.documentElement.lang, {
        hour: "2-digit",
        minute: "2-digit",
        hourCycle: "h23",
        timeZone: tz,
      }).format(new Date());
    });
  }
  tick();
  setInterval(tick, 30_000);
</script>

<style>
  /* Vertical rhythm follows the viewport height so the surname still closes a laptop's first screen. */
  .hero {
    display: grid;
    gap: clamp(2rem, 6svh - 1rem, 4rem);
    padding-top: clamp(0.5rem, 4svh - 1rem, 2.5rem);
  }
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-8) clamp(1.5rem, 0.5rem + 3vw, 4rem);
    align-items: end;
  }
  .copy {
    display: grid;
    gap: clamp(var(--space-4), 3svh, var(--space-6));
    max-width: 34rem;
    padding-bottom: var(--space-8);
  }
  .copy .lede {
    max-width: 30rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }

  /* The engraving is ink on paper: in light mode the paper melts into the page (multiply) and the
     edges dissolve, so the drawing sits on the site itself rather than in a frame. In dark mode the
     ink inverts to light lines on the dark ground. */
  .portrait {
    display: grid;
    gap: var(--space-3);
    justify-self: end;
  }
  .portrait img {
    width: 100%;
    height: auto;
    /* The inline placeholder, stretched under the image until the sharp file paints over it. */
    background-size: 100% 100%;
    background-repeat: no-repeat;
    mix-blend-mode: multiply;
    mask-image: radial-gradient(ellipse 62% 66% at 60% 50%, #000 52%, transparent 100%);
  }
  :global(:root[data-theme="dark"]) .portrait img {
    filter: invert(1) contrast(0.92);
    mix-blend-mode: screen;
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-inline: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .time {
    margin-left: auto;
    color: var(--text-secondary);
  }
  /* Live marker: a terracotta dot with a slow ring, the same dot as the API block. */
  .live {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .live::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: var(--accent);
      animation: ping 2.4s var(--ease-standard) infinite;
    }
  }
  @keyframes ping {
    to {
      scale: 3;
      opacity: 0;
    }
  }

  /* The surname must close a laptop's first screen. It keeps the full width, so the engraving gives
     way: its width follows what the viewport height leaves once the bar, the gaps, the caption and
     the letters (0.234 of the container's width tall) are counted, at the drawing's 1.62 ratio. */
  @media (min-width: 48rem) {
    .hero {
      --monument-h: calc(min(100vw - 2 * var(--gutter), var(--page-max) - 2 * var(--gutter)) * 0.237);
    }
    .portrait {
      width: clamp(18rem, calc((100svh - 15rem - var(--monument-h)) * 1.62), 44rem);
      max-width: min(58vw, calc(100vw - 30rem));
    }
  }

  @media (max-width: 47.99rem) {
    /* Phone order: the name lockup first, then the engraving, then the statement and actions. */
    .hero {
      gap: var(--space-6);
      padding-top: var(--space-4);
    }
    .hero > :global(.monument) {
      order: -1;
    }
    .top {
      grid-template-columns: minmax(0, 1fr);
    }
    .portrait {
      grid-row: 1;
      justify-self: stretch;
      margin-inline: calc(var(--gutter) * -1);
    }
    figcaption {
      padding-inline: var(--gutter);
    }
    .copy {
      padding-bottom: 0;
    }
    .actions .btn {
      flex: 1 1 10rem;
    }
  }
</style>
