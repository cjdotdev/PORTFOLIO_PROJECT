---
import Monument from "./Monument.astro";
import { HERO_IMAGE, HERO_PHOTO } from "../lib/hero-image";
import { PERSONAL } from "../data";
import type { Dict, Locale } from "../i18n";

interface Props {
  t: Dict;
  locale: Locale;
}

const { t, locale } = Astro.props;
// The headline is the job and the specialty; the line under it gives the country (with its flag),
// where the template's {country} placeholder sits.
const lineParts = t.hero.line.split(/(\{\w+\})/).filter(Boolean);
// The two specialties, written [like this] in the copy, are the terracotta words.
const specialtyParts = t.hero.specialty.split(/(\[[^\]]+\])/).filter(Boolean);
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="top">
    <div class="copy">
      <h1 id="hero-title" class="display-lg">
        <span class="sr-only">{PERSONAL.name}. </span>
        {t.hero.role} <span class="specialty">
          {specialtyParts.map((part) => (part.startsWith("[") ? <em>{part.slice(1, -1)}</em> : part))}
        </span>
      </h1>
      <p class="lede">
        {
          lineParts.map((part) =>
            part === "{country}" ? (
              <strong class="fact country">
                <svg class="gabon" viewBox="0 0 3 3" width="14" height="14" aria-hidden="true">
                  <rect width="3" height="1" fill="#009e60" />
                  <rect y="1" width="3" height="1" fill="#fcd116" />
                  <rect y="2" width="3" height="1" fill="#3a75c4" />
                </svg>
                Gabon
              </strong>
            ) : (
              part
            ),
          )
        }
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={`mailto:${PERSONAL.email}`} data-copy-email={PERSONAL.email}>{t.hero.primary}</a>
        <span class="copied" role="status" data-copied hidden>
          {/* Lucide "circle-check", the circle filled in terracotta */}
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="none" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" class="disc" />
            <path d="m8.5 12 2.5 2.5 4.5-5" class="tick" />
          </svg>
          <span>{t.hero.copied}</span>
          <span class="address">{PERSONAL.email}</span>
        </span>
        <a class="btn btn-secondary" href={PERSONAL.cv[locale]} download={locale === "fr" ? "Joel-Codja-CV-FR.pdf" : "Joel-Codja-CV.pdf"}>
          {/* Lucide "download" */}
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 15V3" />
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <path d="m7 10 5 5 5-5" />
          </svg>
          {t.hero.secondary}
        </a>
      </div>
    </div>

    <figure class="portrait">
      {/* Static, preloaded WebP with an inline placeholder: see src/lib/hero-image.ts. The photo it was
          drawn from lies under the same mask and shows through on hover, keyboard focus or a tap. */}
      <button class="faces" type="button" data-faces aria-pressed="false">
      <img
        class="engraving"
        src={HERO_IMAGE.src}
        srcset={HERO_IMAGE.srcset}
        sizes={HERO_IMAGE.sizes}
        width={HERO_IMAGE.width}
        height={HERO_IMAGE.height}
        alt={t.hero.portraitAlt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        style={`background-image: url(${HERO_IMAGE.placeholder})`}
      />
      <img
        class="photo"
        src={HERO_PHOTO.src}
        srcset={HERO_PHOTO.srcset}
        sizes={HERO_IMAGE.sizes}
        width={HERO_IMAGE.width}
        height={HERO_IMAGE.height}
        alt=""
        loading="lazy"
        decoding="async"
      />
      <span class="sr-only">{t.hero.portraitPhoto}</span>
      </button>
    </figure>
  </div>

  <Monument rise say={t.hero.say} />
</section>

<script>
  // "Email me": with a mouse there is often no mail app behind mailto:, so the address is copied and a
  // toast rises from the bottom of the screen to say so (moved to <body> so "fixed" means the screen). Touch screens (and a refused clipboard) keep the mailto: link.
  const mouse = window.matchMedia("(hover: hover) and (pointer: fine)");
  document.querySelectorAll<HTMLAnchorElement>("[data-copy-email]").forEach((link) => {
    const note = link.parentElement!.querySelector<HTMLElement>("[data-copied]")!;
    document.body.append(note);
    let timer = 0;
    link.addEventListener("click", async (event) => {
      if (!mouse.matches || !navigator.clipboard) return;
      event.preventDefault();
      try {
        await navigator.clipboard.writeText(link.dataset.copyEmail!);
      } catch {
        window.location.href = link.href;
        return;
      }
      note.hidden = false;
      note.getBoundingClientRect(); // start the rise from below the screen
      note.dataset.open = "";
      window.clearTimeout(timer);
      timer = window.setTimeout(() => delete note.dataset.open, 2600);
    });
    note.addEventListener("transitionend", () => {
      if (!("open" in note.dataset)) note.hidden = true;
    });
  });

  // The lens: a soft circle of the real photo that follows the mouse a little behind it, opening as
  // the pointer comes in and closing as it leaves. A tap (or Enter) opens it over the whole picture
  // until the next tap; keyboard focus does the same. With reduced motion it moves without easing.
  const calm = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLButtonElement>("[data-faces]").forEach((button) => {
    const photo = button.querySelector<HTMLElement>(".photo")!;
    const LENS = 0.17; // radius as a share of the picture's width
    const pos = { x: 0.6, y: 0.45, tx: 0.6, ty: 0.45 };
    let r = 0;
    let target = 0;
    let hovering = false;
    let frame = 0;
    let last = 0;

    function goal() {
      const width = button.clientWidth;
      const whole = Math.hypot(width, button.clientHeight);
      const open = button.getAttribute("aria-pressed") === "true" || button.matches(":focus-visible");
      target = open ? whole : hovering ? width * LENS : 0;
    }

    function step(now: number) {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      // Slow on purpose: the circle trails the pointer and grows like ink washing off.
      const follow = calm.matches ? 1 : 1 - Math.exp(-5 * dt);
      const grow = calm.matches ? 1 : 1 - Math.exp(-(target > r ? 3.2 : 4.5) * dt);
      pos.x += (pos.tx - pos.x) * follow;
      pos.y += (pos.ty - pos.y) * follow;
      r += (target - r) * grow;
      photo.style.setProperty("--x", `${(pos.x * 100).toFixed(2)}%`);
      photo.style.setProperty("--y", `${(pos.y * 100).toFixed(2)}%`);
      photo.style.setProperty("--r", `${r.toFixed(1)}px`);
      const settled = Math.abs(target - r) < 0.5 && Math.abs(pos.tx - pos.x) < 0.001 && Math.abs(pos.ty - pos.y) < 0.001;
      frame = settled ? 0 : requestAnimationFrame(step);
    }
    function wake() {
      goal();
      if (frame) return;
      last = performance.now();
      frame = requestAnimationFrame(step);
    }

    button.addEventListener("pointerenter", (event) => {
      if (event.pointerType !== "mouse") return;
      const box = button.getBoundingClientRect();
      // The circle starts where the pointer comes in, not from the middle.
      pos.x = pos.tx = (event.clientX - box.left) / box.width;
      pos.y = pos.ty = (event.clientY - box.top) / box.height;
      hovering = true;
      wake();
    });
    button.addEventListener("pointermove", (event) => {
      if (event.pointerType !== "mouse") return;
      const box = button.getBoundingClientRect();
      pos.tx = (event.clientX - box.left) / box.width;
      pos.ty = (event.clientY - box.top) / box.height;
      wake();
    });
    button.addEventListener("pointerleave", () => {
      hovering = false;
      wake();
    });
    button.addEventListener("click", (event) => {
      if ((event as PointerEvent).pointerType === "mouse") return;
      button.setAttribute("aria-pressed", String(button.getAttribute("aria-pressed") !== "true"));
      wake();
    });
    button.addEventListener("focus", wake);
    button.addEventListener("blur", wake);
  });
</script>

<style>
  /* Fixed vertical rhythm: nothing here follows the window's height, which differs between browsers. */
  .hero {
    display: grid;
    gap: 2.5rem;
    padding-top: 1.25rem;
    padding-bottom: var(--section-space);
  }
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-8) clamp(1.5rem, 0.5rem + 3vw, 4rem);
    align-items: end;
  }
  .copy {
    display: grid;
    gap: var(--space-6);
    max-width: 34rem;
    padding-bottom: var(--space-8);
  }
  /* The headline is one sentence in two sizes: the job at the display size, the specialty under it
     at about half, so the job reads first and the hero stays short. */
  .specialty {
    display: block;
    margin-top: 0.35em;
    font-size: clamp(1.25rem, 0.95rem + 0.9vw, 1.75rem);
    font-weight: 400;
    letter-spacing: var(--tracking-display);
    line-height: 1.25;
    text-wrap: balance;
  }
  .specialty em {
    color: var(--accent);
    font-style: normal;
  }
  /* The country stands out of the line's grey. */
  .fact {
    color: var(--foreground);
    font-weight: 500;
  }
  .country {
    white-space: nowrap;
  }
  .gabon {
    display: inline-block;
    margin-right: 0.3em;
    vertical-align: -0.1em;
    border-radius: 50%;
    outline: 1px solid var(--border-strong);
  }
  .copy .lede {
    max-width: 30rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }

  /* The toast once the address is copied: a dark panel on the page's own surface that rises from the
     bottom of the screen, the check in terracotta, the address in mono. */
  .copied {
    position: fixed;
    bottom: max(1.5rem, env(safe-area-inset-bottom));
    left: 50%;
    z-index: 100;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0.9rem 1.4rem;
    white-space: nowrap;
    font-size: 1.125rem;
    color: var(--foreground);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-floating);
    opacity: 0;
    transform: translate(-50%, calc(100% + 2rem));
    transition:
      opacity var(--duration-standard) var(--ease-standard),
      transform var(--duration-considered) var(--ease-enter);
    pointer-events: none;
  }
  .copied[data-open] {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .copied svg {
    flex: none;
  }
  .copied .disc {
    fill: var(--accent);
    stroke: var(--accent);
  }
  .copied .tick {
    stroke: var(--accent-foreground);
    stroke-width: 2.25;
  }
  .copied .address {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--text-secondary);
  }
  @media (prefers-reduced-motion: reduce) {
    .copied,
    .copied[data-open] {
      transform: translate(-50%, 0);
    }
  }

  /* The engraving is ink on paper, inverted to light lines on the dark ground (the site is dark
     only), its edges dissolving so the drawing sits on the site itself rather than in a frame. */
  .portrait {
    display: grid;
    gap: var(--space-3);
    justify-self: end;
  }
  /* The button is only the hit area: no chrome of its own. */
  .faces {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius-surface);
    background: none;
    color: inherit;
    cursor: default;
  }
  .faces:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .engraving,
  .photo {
    display: block;
  }
  .engraving {
    width: 100%;
    height: auto;
    /* The inline placeholder, stretched under the image until the sharp file paints over it. */
    background-size: 100% 100%;
    background-repeat: no-repeat;
    mix-blend-mode: multiply;
    mask-image: radial-gradient(ellipse 62% 66% at 60% 50%, #000 52%, transparent 100%);
  }
  :global(:root[data-theme="dark"]) .engraving {
    filter: invert(1) contrast(0.92);
    mix-blend-mode: screen;
  }
  /* The photo sits exactly on the drawing. Two masks meet: the drawing's soft-edged oval, and a soft
     circle the script moves with the pointer (--x, --y) and grows or shrinks (--r). Only where both
     are open does the real photo show through the ink. A tap or keyboard focus opens the circle over
     the whole picture. Without the script the circle stays shut and the drawing stays. */
  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    --lens: radial-gradient(circle max(var(--r, 0px), 1px) at var(--x, 50%) var(--y, 50%), #000 35%, transparent 100%);
    --oval: radial-gradient(ellipse 62% 66% at 60% 50%, #000 52%, transparent 100%);
    -webkit-mask-image: var(--lens), var(--oval);
    -webkit-mask-composite: source-in;
    mask-image: var(--lens), var(--oval);
    mask-composite: intersect;
  }
  /* On the dark page the photo's white sky would glare: it comes down a step, the face stays true. */
  :global(:root[data-theme="dark"]) .photo {
    filter: brightness(0.82) contrast(1.05);
  }

  /* Side by side, sized from the width only: the window's height differs from browser to browser
     (toolbars, bookmarks bar, zoom), and a portrait sized from it moved the whole hero. The copy
     keeps a fixed column, wide enough for "Backend developer," on one line at full size; the
     engraving takes the rest at its own ratio. */
  @media (min-width: 48rem) {
    .top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .portrait {
      width: 100%;
    }
  }
  @media (min-width: 64rem) {
    .top {
      grid-template-columns: minmax(0, 28rem) minmax(0, 1fr);
    }
  }

  @media (max-width: 47.99rem) {
    /* Phone order: the name lockup first, then the engraving, then the statement and actions. */
    .hero {
      gap: var(--space-6);
      padding-top: var(--space-4);
    }
    .hero > :global(.monument) {
      order: -1;
    }
    .top {
      grid-template-columns: minmax(0, 1fr);
    }
    .portrait {
      grid-row: 1;
      justify-self: stretch;
      margin-inline: calc(var(--gutter) * -1);
    }
    .copy {
      padding-bottom: 0;
    }
    .actions .btn {
      flex: 1 1 10rem;
    }
  }
</style>
