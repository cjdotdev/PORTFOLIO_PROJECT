---
/**
 * Joel's CJ mark: a Bodoni C with the J hanging under it like a drop earring, and a terracotta copy
 * of both behind them. Three stacked SVGs (shadow, C, J) so the intro can move each one on its own:
 * the C spins in, the J drops and swings from its pivot, the shadow slides out. The letters take the
 * current text colour; the shadow takes --cj-echo (the accent by default), so one mark serves light
 * and dark. Geometry lives in src/data/cj-mark.ts.
 */
import { CJ_C, CJ_ECHO, CJ_GROUP, CJ_J, CJ_PIVOT, CJ_VIEWBOX } from "../data/cj-mark";

interface Props {
  size?: number | string;
  class?: string;
  title?: string;
  /** A warm streak of light inside the J, hidden until something animates .cj-glint (the intro does). */
  glint?: boolean;
}
const { size = 32, class: className, title, glint = false } = Astro.props;
const dimension = typeof size === "number" ? `${size}px` : size;
// The shadow's cut-out mask needs an id of its own on every page that shows the mark more than once.
const uid = `cj-${Math.random().toString(36).slice(2, 8)}`;
---

<span
  class:list={["cj", className]}
  style={`--cj-size: ${dimension}; --cj-pivot: ${CJ_PIVOT.x * 100}% ${CJ_PIVOT.y * 100}%`}
  role={title ? "img" : undefined}
  aria-hidden={title ? undefined : "true"}
  aria-label={title}
>
  <svg class="cj-echo" viewBox={CJ_VIEWBOX} aria-hidden="true">
    <defs>
      <mask id={`${uid}-gap`} maskUnits="userSpaceOnUse" x="0" y="0" width="256" height="256">
        <rect width="256" height="256" fill="white"></rect>
        <g transform={CJ_GROUP} fill="black" stroke="black" stroke-linejoin="round">
          <path transform={CJ_C.transform} d={CJ_C.d} stroke-width={CJ_ECHO.gapC}></path>
          <path transform={CJ_J.transform} d={CJ_J.d} stroke-width={CJ_ECHO.gapJ}></path>
        </g>
      </mask>
    </defs>
    <g mask={`url(#${uid}-gap)`}>
      <g transform={CJ_GROUP}>
        <g transform={`translate(${CJ_ECHO.dx} ${CJ_ECHO.dy})`}>
          <path transform={CJ_C.transform} d={CJ_C.d}></path>
          <path transform={CJ_J.transform} d={CJ_J.d}></path>
        </g>
      </g>
    </g>
  </svg>
  <svg class="cj-c" viewBox={CJ_VIEWBOX} aria-hidden="true">
    <g transform={CJ_GROUP}><path transform={CJ_C.transform} d={CJ_C.d}></path></g>
  </svg>
  <svg class="cj-j" viewBox={CJ_VIEWBOX} aria-hidden="true">
    {
      glint && (
        <defs>
          <clipPath id={`${uid}-j`}>
            <path transform={CJ_J.transform} d={CJ_J.d} />
          </clipPath>
          <linearGradient id={`${uid}-light`} x1="0" x2="1" y1="0" y2="0">
            <stop offset="0" stop-color="#e8916f" stop-opacity="0" />
            <stop offset="0.5" stop-color="#e8916f" stop-opacity="0.95" />
            <stop offset="1" stop-color="#e8916f" stop-opacity="0" />
          </linearGradient>
        </defs>
      )
    }
    <g transform={CJ_GROUP}>
      <path transform={CJ_J.transform} d={CJ_J.d}></path>
      {
        glint && (
          <g clip-path={`url(#${uid}-j)`}>
            <rect class="cj-glint" x="0" y="40" width="34" height="220" fill={`url(#${uid}-light)`} transform="skewX(-22)" />
          </g>
        )
      }
    </g>
  </svg>
</span>

<style>
  .cj {
    position: relative;
    display: inline-block;
    width: var(--cj-size);
    height: var(--cj-size);
    vertical-align: middle;
  }
  .cj svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .cj-c,
  .cj-j {
    fill: currentColor;
  }
  .cj-echo {
    fill: var(--cj-echo, var(--accent));
  }
  .cj-j {
    transform-origin: var(--cj-pivot);
  }
  .cj-glint {
    opacity: 0;
  }
</style>
