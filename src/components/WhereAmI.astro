---
import { LOCATION, SITE_URL } from "../data";
import type { Dict, Locale } from "../i18n";

interface Props {
  t: Dict;
  locale: Locale;
}

const { t, locale } = Astro.props;
const endpoint = "/api/where";
const host = new URL(SITE_URL).host;
// What the HTML shows before (or without) the live call. Same fields as functions/api/where.ts.
const fallback = {
  city: LOCATION.city,
  country: LOCATION.country,
  from: LOCATION.from,
  timezone: LOCATION.timezone,
  coordinates: { lat: LOCATION.lat, lon: LOCATION.lon },
};
const country = locale === "fr" && LOCATION.country === "Benin" ? "Bénin" : LOCATION.country;
const from = LOCATION.from;

// The map is a 4x3 block of 256px OpenStreetMap tiles at zoom 12, laid so the city centre sits in
// the middle of the frame. No key needed; the attribution is shown on the map. CSS turns the tiles
// grey in light mode and inverts them for a night map in dark mode.
const ZOOM = 12;
const n = 2 ** ZOOM;
const latRad = (LOCATION.lat * Math.PI) / 180;
const fx = ((LOCATION.lon + 180) / 360) * n;
const fy = ((1 - Math.log(Math.tan(latRad) + 1 / Math.cos(latRad)) / Math.PI) / 2) * n;
const x0 = Math.floor(fx) - 1;
const y0 = Math.floor(fy) - 1;
const offsetX = Math.round((fx - x0) * 256);
const offsetY = Math.round((fy - y0) * 256);
const tiles = [0, 1, 2].flatMap((row) => [0, 1, 2, 3].map((col) => ({ x: x0 + col, y: y0 + row })));
const tile = (x: number, y: number) => `https://tile.openstreetmap.org/${ZOOM}/${x}/${y}.png`;
---

<section class="where section container reveal" aria-labelledby="where-title">
  <div class="intro">
    <h2 id="where-title" class="display">{t.where.title}</h2>
    <p class="lede">{t.where.lede}</p>
  </div>

  <div class="board" data-where-console data-endpoint={endpoint} data-fallback={t.where.fallback} data-codes={JSON.stringify(t.where.codes)}>
    <figure class="map" role="img" aria-label={t.where.mapAlt}>
      <div class="tiles" style={`--ox:${offsetX}px; --oy:${offsetY}px`}>
        {tiles.map(({ x, y }) => (
          <img src={tile(x, y)} alt="" width="256" height="256" loading="lazy" decoding="async" />
        ))}
      </div>
      <span class="pin" aria-hidden="true"><span></span></span>
      <figcaption>
        © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer"
          >OpenStreetMap contributors</a
        >
      </figcaption>
    </figure>

    <dl class="readouts">
      <div>
        <dt>{t.where.now}</dt>
        <dd><span data-where="place">{LOCATION.city}, {country}</span></dd>
      </div>
      <div>
        <dt>{t.where.localTime}</dt>
        <dd class="num" data-local-time data-tz={LOCATION.timezone}></dd>
      </div>
      <div>
        <dt>{t.where.weather}</dt>
        <dd class="num" data-weather>–</dd>
      </div>
      <div>
        <dt>{t.where.from}</dt>
        <dd>{from}</dd>
      </div>
    </dl>

    <div class="console">
      <div class="request">
        <p class="label">{t.where.request}</p>
        <p class="mono line"><span class="verb">GET</span> https://{host}{endpoint}</p>
        <button type="button" class="btn btn-secondary send" data-send>
          <span class="live" aria-hidden="true"></span>
          <span data-send-label data-idle={t.where.send} data-busy={t.where.sending}>{t.where.send}</span>
        </button>
      </div>
      <div class="response">
        <p class="label">
          {t.where.response}
          <span class="status mono" data-status aria-live="polite"></span>
        </p>
        <pre class="mono json" data-json>{JSON.stringify(fallback, null, 2)}</pre>
        <p class="note" data-note hidden></p>
      </div>
    </div>
  </div>
</section>

<script>
  type Weather = { temperature_c: number; weather_code: number; is_day?: boolean } | null;
  type Place = {
    city?: string;
    country?: string;
    coordinates?: { lat: number; lon: number };
    weather?: Weather;
    [key: string]: unknown;
  };

  const reduce = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function escape(text: string) {
    return text.replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" })[c] as string);
  }

  // Keys quiet, values in ink, so the eye reads the answer and not the syntax.
  function highlight(line: string) {
    return escape(line)
      .replace(/^(\s*)"([^"]+)":/, '$1<span class="k">"$2"</span>:')
      .replace(/: ("[^"]*"|-?[\d.]+|true|false|null)(,?)$/, ': <span class="v">$1</span>$2')
      .replace(/^(\s*)"([^"]*)"(,?)$/, '$1<span class="v">"$2"</span>$3');
  }

  async function render(pre: HTMLElement, text: string) {
    const lines = text.split("\n");
    if (reduce()) {
      pre.innerHTML = lines.map(highlight).join("\n");
      return;
    }
    pre.innerHTML = "";
    for (const [index, line] of lines.entries()) {
      pre.insertAdjacentHTML("beforeend", (index ? "\n" : "") + `<span class="in">${highlight(line)}</span>`);
      await new Promise((resolve) => setTimeout(resolve, 35));
    }
  }

  // WMO weather codes, grouped into the words the dictionary carries.
  function weatherKey(code: number) {
    if (code === 0) return "clear";
    if (code <= 2) return "cloudy";
    if (code === 3) return "overcast";
    if (code <= 48) return "fog";
    if (code <= 57) return "drizzle";
    if (code <= 67) return "rain";
    if (code <= 77) return "snow";
    if (code <= 82) return "showers";
    return "storm";
  }

  // Without the site's API (local dev, an outage) the weather still comes live, straight from Open-Meteo.
  async function weatherDirect(lat: number, lon: number): Promise<Weather> {
    try {
      const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,weather_code,is_day&timezone=auto`;
      const data = await (await fetch(url)).json();
      return { temperature_c: Math.round(data.current.temperature_2m), weather_code: data.current.weather_code };
    } catch {
      return null;
    }
  }

  function setup(root: HTMLElement) {
    const button = root.querySelector<HTMLButtonElement>("[data-send]")!;
    const label = root.querySelector<HTMLElement>("[data-send-label]")!;
    const status = root.querySelector<HTMLElement>("[data-status]")!;
    const pre = root.querySelector<HTMLElement>("[data-json]")!;
    const note = root.querySelector<HTMLElement>("[data-note]")!;
    const weatherOut = root.querySelector<HTMLElement>("[data-weather]")!;
    const codes = JSON.parse(root.dataset.codes ?? "{}") as Record<string, string>;
    const endpoint = root.dataset.endpoint!;
    const fallbackText = pre.textContent ?? "";
    const fallback = JSON.parse(fallbackText) as Place;
    pre.innerHTML = fallbackText.split("\n").map(highlight).join("\n");

    function showWeather(weather: Weather | undefined) {
      if (!weather) return;
      weatherOut.textContent = `${weather.temperature_c}°C · ${codes[weatherKey(weather.weather_code)] ?? ""}`;
    }

    async function send() {
      button.disabled = true;
      label.textContent = label.dataset.busy!;
      root.dataset.state = "busy";
      const started = performance.now();
      try {
        const response = await fetch(endpoint, { headers: { accept: "application/json" }, cache: "no-store" });
        if (!response.ok || !response.headers.get("content-type")?.includes("json")) throw new Error(String(response.status));
        const place = (await response.json()) as Place;
        const ms = Math.round(performance.now() - started);
        status.textContent = `${response.status} OK · ${ms} ms`;
        note.hidden = true;
        root.dataset.state = "ok";
        showWeather(place.weather);
        await render(pre, JSON.stringify(place, null, 2));
        if (place.city && place.country) {
          document.querySelectorAll("[data-where='place']").forEach((element) => {
            element.textContent = `${place.city}, ${place.country}`;
          });
        }
      } catch {
        status.textContent = "";
        note.textContent = root.dataset.fallback ?? "";
        note.hidden = false;
        root.dataset.state = "fallback";
        const { lat, lon } = fallback.coordinates!;
        const weather = await weatherDirect(lat, lon);
        showWeather(weather);
        await render(pre, JSON.stringify({ ...fallback, weather }, null, 2));
      } finally {
        button.disabled = false;
        label.textContent = label.dataset.idle!;
      }
    }

    button.addEventListener("click", send);
    // The first call happens on its own when the block comes into view.
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        send();
      },
      { threshold: 0.25 },
    );
    observer.observe(root);
  }

  document.querySelectorAll<HTMLElement>("[data-where-console]").forEach(setup);
</script>

<script>
  // Joel's local time in the board, refreshed every half minute. Empty until the script runs.
  function tick() {
    document.querySelectorAll<HTMLElement>("[data-local-time]").forEach((element) => {
      const tz = element.dataset.tz || "UTC";
      element.textContent = new Intl.DateTimeFormat(document.documentElement.lang, {
        hour: "2-digit",
        minute: "2-digit",
        hourCycle: "h23",
        timeZone: tz,
      }).format(new Date());
    });
  }
  tick();
  setInterval(tick, 30_000);
</script>

<style>
  .where {
    display: grid;
    gap: var(--space-8);
  }
  .intro {
    display: grid;
    gap: var(--space-4);
  }
  .board {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-rows: minmax(20rem, 1fr) auto;
    grid-template-areas:
      "map console"
      "readouts console";
    gap: var(--space-4);
  }

  /* ─── Map ─── */
  .map {
    grid-area: map;
    position: relative;
    min-height: 20rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-surface);
    background: var(--surface-muted);
    isolation: isolate;
  }
  .tiles {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    grid-template-columns: repeat(4, 256px);
    width: 1024px;
    translate: calc(var(--ox) * -1) calc(var(--oy) * -1);
  }
  .tiles img {
    display: block;
    width: 256px;
    height: 256px;
    max-width: none;
  }
  .tiles {
    filter: grayscale(1) contrast(0.9) brightness(1.04);
  }
  :global(:root[data-theme="dark"]) .tiles {
    filter: grayscale(1) invert(1) brightness(0.82) contrast(0.92);
  }
  .pin {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: 1rem;
    height: 1rem;
    translate: -50% -50%;
    border: 3px solid var(--surface);
    border-radius: var(--radius-pill);
    background: var(--accent);
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.25);
  }
  .pin span {
    position: absolute;
    inset: -3px;
    border-radius: inherit;
    background: var(--accent);
    opacity: 0.35;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pin span {
      animation: radar 2.4s var(--ease-standard) infinite;
    }
  }
  @keyframes radar {
    from {
      scale: 1;
      opacity: 0.45;
    }
    to {
      scale: 5;
      opacity: 0;
    }
  }
  .map figcaption {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    z-index: 1;
    padding: 2px var(--space-2);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    color: var(--text-secondary);
    font-size: 0.6875rem;
  }

  /* ─── Readouts ─── */
  .readouts {
    grid-area: readouts;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-panel);
  }
  dt {
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
  dd {
    margin: var(--space-1) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .num {
    font-variant-numeric: tabular-nums;
  }

  /* ─── Request / response ─── */
  .console {
    grid-area: console;
    display: grid;
    grid-template-rows: auto 1fr;
    border: 1px solid var(--border);
    border-radius: var(--radius-surface);
    background: var(--surface);
    overflow: hidden;
  }
  .request,
  .response {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-6);
  }
  .request {
    border-bottom: 1px solid var(--border);
  }
  .label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .line {
    overflow-wrap: anywhere;
  }
  .verb {
    color: var(--foreground);
    font-weight: 500;
  }
  .status {
    color: var(--foreground);
  }
  .send {
    justify-self: start;
    gap: var(--space-3);
  }
  .response {
    background: var(--surface-muted);
  }
  .json {
    margin: 0;
    min-height: 15em;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--foreground);
    font-size: 0.8125rem;
  }
  .json :global(.k) {
    color: var(--text-secondary);
  }
  .json :global(.v) {
    color: var(--foreground);
    font-weight: 500;
  }
  @media (prefers-reduced-motion: no-preference) {
    .json :global(.in) {
      animation: line-in 0.32s var(--ease-enter) both;
    }
  }
  @keyframes line-in {
    from {
      opacity: 0;
      filter: blur(3px);
    }
  }
  .note {
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
  .live {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--accent);
  }
  [data-state="busy"] .live {
    animation: blink 0.8s steps(2, jump-none) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.2;
    }
  }

  @media (max-width: 60rem) {
    .board {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
      grid-template-areas: "map" "readouts" "console";
    }
    .map {
      min-height: 16rem;
    }
  }
  @media (max-width: 40rem) {
    .readouts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: var(--space-5);
    }
    .request,
    .response {
      padding: var(--space-5);
    }
  }
</style>
