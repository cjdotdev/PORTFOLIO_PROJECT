---
import GabonMap from "./GabonMap.astro";
import { LOCATION } from "../data";
import type { Dict, Locale } from "../i18n";

interface Props {
  t: Dict;
  locale: Locale;
}

const { t, locale } = Astro.props;
const endpoint = "/api/where";
const country = locale === "fr" && LOCATION.country === "Benin" ? "Bénin" : LOCATION.country;
const from = LOCATION.from;

// The map is a 4x3 block of 256px OpenStreetMap tiles at zoom 12, laid so the city centre sits in
// the middle of the frame. No key needed; the attribution is shown on the map. CSS turns the tiles
// grey in light mode and inverts them for a night map in dark mode. This first frame is LOCATION; the
// script lays the same block again around whatever coordinates the API answers.
const ZOOM = 12;
const n = 2 ** ZOOM;
const latRad = (LOCATION.lat * Math.PI) / 180;
const fx = ((LOCATION.lon + 180) / 360) * n;
const fy = ((1 - Math.log(Math.tan(latRad) + 1 / Math.cos(latRad)) / Math.PI) / 2) * n;
const x0 = Math.floor(fx) - 1;
const y0 = Math.floor(fy) - 1;
const offsetX = Math.round((fx - x0) * 256);
const offsetY = Math.round((fy - y0) * 256);
const tiles = [0, 1, 2].flatMap((row) => [0, 1, 2, 3].map((col) => ({ x: x0 + col, y: y0 + row })));
const tile = (x: number, y: number) => `https://tile.openstreetmap.org/${ZOOM}/${x}/${y}.png`;
---

<section class="where section container reveal" aria-labelledby="where-title">
  <div class="intro">
    <h2 id="where-title" class="display">{t.where.title}</h2>
    <p class="lede">{t.where.lede}</p>
  </div>

  <div
    class="board"
    data-where-board
    data-endpoint={endpoint}
    data-lat={LOCATION.lat}
    data-lon={LOCATION.lon}
    data-codes={JSON.stringify(t.where.codes)}
  >
    <figure class="map" role="img" aria-label={t.where.mapAlt} data-city={LOCATION.city}>
      <div class="tiles" style={`--ox:${offsetX}px; --oy:${offsetY}px`} data-zoom={ZOOM}>
        {tiles.map(({ x, y }) => (
          <img src={tile(x, y)} alt="" width="256" height="256" loading="lazy" decoding="async" />
        ))}
      </div>
      <span class="pin" aria-hidden="true"><span></span></span>
      <figcaption>
        © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer"
          >OpenStreetMap contributors</a
        >
      </figcaption>
    </figure>

    <dl class="readouts">
      <div>
        <dt>{t.where.now}</dt>
        <dd><span data-where="place">{LOCATION.city}, {country}</span></dd>
      </div>
      <div>
        <dt>{t.where.localTime}</dt>
        <dd class="num" data-local-time data-tz={LOCATION.timezone}></dd>
      </div>
      <div>
        <dt>{t.where.weather}</dt>
        <dd class="num" data-weather>–</dd>
      </div>
      <div>
        <dt>{t.where.from}</dt>
        <dd>{from}</dd>
      </div>
    </dl>

    <div class="console">
      <GabonMap t={t} locale={locale} />
    </div>
  </div>
</section>

<script>
  type Weather = { temperature_c: number; weather_code: number; is_day?: boolean } | null;
  type Place = {
    city?: string;
    country?: string;
    coordinates?: { lat: number; lon: number };
    weather?: Weather;
  };

  // WMO weather codes, grouped into the words the dictionary carries.
  function weatherKey(code: number) {
    if (code === 0) return "clear";
    if (code <= 2) return "cloudy";
    if (code === 3) return "overcast";
    if (code <= 48) return "fog";
    if (code <= 57) return "drizzle";
    if (code <= 67) return "rain";
    if (code <= 77) return "snow";
    if (code <= 82) return "showers";
    return "storm";
  }

  // Without the site's API (local dev, an outage) the weather still comes live, straight from Open-Meteo.
  async function weatherDirect(lat: number, lon: number): Promise<Weather> {
    try {
      const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,weather_code,is_day&timezone=auto`;
      const data = await (await fetch(url)).json();
      return { temperature_c: Math.round(data.current.temperature_2m), weather_code: data.current.weather_code };
    } catch {
      return null;
    }
  }

  // Lays the 4x3 tile block around new coordinates, with the same maths as the build-time frame, so the
  // map follows the API when the place changes. The pin stays in the middle; the tiles move under it.
  function moveMap(map: HTMLElement, lat: number, lon: number, city?: string) {
    const tiles = map.querySelector<HTMLElement>(".tiles")!;
    const zoom = Number(tiles.dataset.zoom);
    const n = 2 ** zoom;
    const latRad = (lat * Math.PI) / 180;
    const fx = ((lon + 180) / 360) * n;
    const fy = ((1 - Math.log(Math.tan(latRad) + 1 / Math.cos(latRad)) / Math.PI) / 2) * n;
    const x0 = Math.floor(fx) - 1;
    const y0 = Math.floor(fy) - 1;
    tiles.querySelectorAll("img").forEach((img, index) => {
      const src = `https://tile.openstreetmap.org/${zoom}/${x0 + (index % 4)}/${y0 + Math.floor(index / 4)}.png`;
      if (img.src !== src) img.src = src;
    });
    tiles.style.setProperty("--ox", `${Math.round((fx - x0) * 256)}px`);
    tiles.style.setProperty("--oy", `${Math.round((fy - y0) * 256)}px`);
    if (city && map.dataset.city && city !== map.dataset.city) {
      map.setAttribute("aria-label", map.getAttribute("aria-label")!.replace(map.dataset.city, city));
      map.dataset.city = city;
    }
  }

  // When the block comes into view, ask the site's API where Joel is; the place, the map and the
  // weather follow its answer. Without an answer the page keeps LOCATION and fetches the weather itself.
  function setup(root: HTMLElement) {
    const map = root.querySelector<HTMLElement>(".map")!;
    const weatherOut = root.querySelector<HTMLElement>("[data-weather]")!;
    const codes = JSON.parse(root.dataset.codes ?? "{}") as Record<string, string>;

    function showWeather(weather: Weather | undefined) {
      if (!weather) return;
      weatherOut.textContent = `${weather.temperature_c}°C · ${codes[weatherKey(weather.weather_code)] ?? ""}`;
    }

    async function locate() {
      try {
        const response = await fetch(root.dataset.endpoint!, { headers: { accept: "application/json" } });
        if (!response.ok || !response.headers.get("content-type")?.includes("json")) throw new Error(String(response.status));
        const place = (await response.json()) as Place;
        if (place.coordinates) moveMap(map, place.coordinates.lat, place.coordinates.lon, place.city);
        if (place.city && place.country) {
          document.querySelectorAll("[data-where='place']").forEach((element) => {
            element.textContent = `${place.city}, ${place.country}`;
          });
        }
        showWeather(place.weather ?? (place.coordinates && (await weatherDirect(place.coordinates.lat, place.coordinates.lon))));
      } catch {
        showWeather(await weatherDirect(Number(root.dataset.lat), Number(root.dataset.lon)));
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        locate();
      },
      { threshold: 0.25 },
    );
    observer.observe(root);
  }

  document.querySelectorAll<HTMLElement>("[data-where-board]").forEach(setup);
</script>

<script>
  // Joel's local time in the board, refreshed every half minute. Empty until the script runs.
  function tick() {
    document.querySelectorAll<HTMLElement>("[data-local-time]").forEach((element) => {
      const tz = element.dataset.tz || "UTC";
      element.textContent = new Intl.DateTimeFormat(document.documentElement.lang, {
        hour: "2-digit",
        minute: "2-digit",
        hourCycle: "h23",
        timeZone: tz,
      }).format(new Date());
    });
  }
  tick();
  setInterval(tick, 30_000);
</script>

<style>
  .where {
    display: grid;
    gap: var(--space-8);
  }
  .intro {
    display: grid;
    gap: var(--space-4);
  }
  .board {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-rows: minmax(20rem, 1fr) auto;
    grid-template-areas:
      "map console"
      "readouts console";
    gap: var(--space-4);
  }

  /* ─── Map ─── */
  .map {
    grid-area: map;
    position: relative;
    min-height: 20rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-surface);
    background: var(--surface-muted);
    isolation: isolate;
  }
  .tiles {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    grid-template-columns: repeat(4, 256px);
    width: 1024px;
    translate: calc(var(--ox) * -1) calc(var(--oy) * -1);
  }
  .tiles img {
    display: block;
    width: 256px;
    height: 256px;
    max-width: none;
  }
  .tiles {
    filter: grayscale(1) contrast(0.9) brightness(1.04);
  }
  :global(:root[data-theme="dark"]) .tiles {
    filter: grayscale(1) invert(1) brightness(0.82) contrast(0.92);
  }
  .pin {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: 1rem;
    height: 1rem;
    translate: -50% -50%;
    border: 3px solid var(--surface);
    border-radius: var(--radius-pill);
    background: var(--accent);
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.25);
  }
  .pin span {
    position: absolute;
    inset: -3px;
    border-radius: inherit;
    background: var(--accent);
    opacity: 0.35;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pin span {
      animation: radar 2.4s var(--ease-standard) infinite;
    }
  }
  @keyframes radar {
    from {
      scale: 1;
      opacity: 0.45;
    }
    to {
      scale: 5;
      opacity: 0;
    }
  }
  .map figcaption {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    z-index: 1;
    padding: 2px var(--space-2);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    color: var(--text-secondary);
    font-size: 0.6875rem;
  }

  /* ─── Readouts ─── */
  .readouts {
    grid-area: readouts;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-panel);
  }
  dt {
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
  dd {
    margin: var(--space-1) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .num {
    font-variant-numeric: tabular-nums;
  }

  /* ─── Gabon ─── */
  .console {
    grid-area: console;
    display: grid;
  }

  @media (max-width: 60rem) {
    .board {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
      grid-template-areas: "map" "readouts" "console";
    }
    .map {
      min-height: 16rem;
    }
  }
  @media (max-width: 40rem) {
    .readouts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: var(--space-5);
    }
  }
</style>
