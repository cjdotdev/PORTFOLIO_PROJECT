---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import makisendLight from "../assets/work/dashboard-logs-light.webp";
import makisendDark from "../assets/work/dashboard-logs-dark.webp";
import scheduler from "../assets/work/linkedin-scheduler.webp";
import contrasto from "../assets/work/contrasto.webp";
import TechList from "./TechList.astro";
import type { Project } from "../data";
import type { Dict } from "../i18n";

interface Props {
  project: Project;
  t: Dict;
  /** h3 under a section heading on the home page, h2 on /projects. */
  level?: 2 | 3;
}

const { project, t, level = 3 } = Astro.props;
const copy = t.work.items[project.id];
const headingId = `work-${project.id}`;

// One shot per theme where the product has both (MakiSend's dashboard), chosen by data-theme.
const SHOTS: Record<Project["id"], { light: ImageMetadata; dark?: ImageMetadata }> = {
  makisend: { light: makisendLight, dark: makisendDark },
  "linkedin-scheduler": { light: scheduler },
  contrasto: { light: contrasto },
};
const shot = SHOTS[project.id];
const sizes = "(min-width: 64rem) 42rem, 100vw";
---

<article class="work" aria-labelledby={headingId}>
  <div class="text">
    {/* Literal h2/h3: Astro's scoped styles do not reach a dynamic tag. */}
    {
      level === 2 ? (
        <h2 id={headingId} class="name">
          <img src={project.logo} alt="" width="36" height="36" />
          {copy.name}
        </h2>
      ) : (
        <h3 id={headingId} class="name">
          <img src={project.logo} alt="" width="36" height="36" />
          {copy.name}
        </h3>
      )
    }
    <p class="lede">{copy.line}</p>
    <p class="role">{copy.role}</p>
    {
      copy.facts.length > 0 && (
        <ul class="facts" role="list">
          {copy.facts.map((fact) => (
            <li>{fact}</li>
          ))}
        </ul>
      )
    }
    <div class="stack">
      <TechList stack={project.stack} label={t.work.stack} />
    </div>
    <p class="links">
      {
        project.site && (
          <a class="link" href={project.site} target="_blank" rel="noopener noreferrer">
            {t.work.site}
            <span class="sr-only">: {copy.name}</span>
          </a>
        )
      }
      {
        project.repo && (
          <a class="link" href={project.repo} target="_blank" rel="noopener noreferrer">
            {t.work.repo}
            <span class="sr-only">: {copy.name}</span>
          </a>
        )
      }
    </p>
  </div>

  <figure class:list={["shot", { zoom: project.id === "makisend" }]}>
    <Image
      class:list={{ "shot-light": !!shot.dark }}
      src={shot.light}
      alt={copy.shotAlt}
      widths={[480, 800, 1200]}
      sizes={sizes}
      format="webp"
      quality={80}
      loading="lazy"
      decoding="async"
    />
    {
      shot.dark && (
        <Image
          class="shot-dark"
          src={shot.dark}
          alt={copy.shotAlt}
          widths={[480, 800, 1200]}
          sizes={sizes}
          format="webp"
          quality={80}
          loading="lazy"
          decoding="async"
        />
      )
    }
  </figure>
</article>

<style>
  .work {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-8) clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .text {
    display: grid;
    gap: var(--space-4);
  }
  /* One step under the section heading (DESIGN.md 28px), Geist 500 like every heading. */
  .name {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.3rem + 0.6vw, 1.75rem);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    overflow-wrap: anywhere;
  }
  .name img {
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
  }
  .role {
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
  .facts {
    display: grid;
    margin-top: var(--space-2);
    border-top: 1px solid var(--border);
  }
  .facts li {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
    font-size: var(--text-base);
    font-variant-numeric: tabular-nums;
    text-wrap: pretty;
  }
  .stack {
    margin-top: var(--space-2);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
  .shot {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-surface);
    background: var(--surface-muted);
  }
  .shot :global(img) {
    width: 100%;
    height: auto;
  }
  :global(:root[data-theme="dark"]) .shot :global(.shot-light),
  :global(:root:not([data-theme="dark"])) .shot :global(.shot-dark) {
    display: none;
  }

  @media (max-width: 55rem) {
    .work {
      grid-template-columns: minmax(0, 1fr);
    }
    .shot {
      grid-row: 1;
      border-radius: var(--radius-panel);
    }
  }
  /* On a phone the whole dashboard is too small to read: show its log table at a readable size. */
  @media (max-width: 40rem) {
    .zoom :global(img) {
      width: 190%;
      max-width: none;
      margin-left: -34%;
    }
  }
</style>
