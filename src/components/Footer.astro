---
import { siGithub, siHashnode, siX } from "simple-icons";
import Monument from "./Monument.astro";
import { PERSONAL } from "../data";
import type { Dict } from "../i18n";

interface Props {
  t: Dict;
}

const { t } = Astro.props;
// Simple Icons (CC0) no longer ships LinkedIn's mark; this is LinkedIn's own "in" logo, 24px grid.
const LINKEDIN =
  "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z";
const elsewhere = [
  { label: "GitHub", href: PERSONAL.github, path: siGithub.path },
  { label: "LinkedIn", href: PERSONAL.linkedin, path: LINKEDIN },
  { label: "X", href: PERSONAL.twitter, path: siX.path },
  { label: "Hashnode", href: PERSONAL.hashnode, path: siHashnode.path },
];
---

<footer class="footer">
  <div class="container row">
    <nav aria-label={t.footer.elsewhere}>
      <ul role="list">
        {
          elsewhere.map((item) => (
            <li>
              <a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.label} title={item.label}>
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <path d={item.path} fill="currentColor" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="top" href="#top">{t.footer.top}</a>
  </div>
  <div class="band">
    <div class="container">
      <Monument decorative />
      <div class="legal">
        <p>{t.footer.rights}</p>
        <a href={`mailto:${PERSONAL.email}`}>{PERSONAL.email}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  /* The last section's own padding plus this make the site's one section gap above the footer row. */
  .footer {
    margin-top: calc(var(--section-space) - var(--space-6));
  }
  .row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-6);
  }
  /* The hairline closes the page above the icons; it spans the content column, not the gutters. */
  .row::before {
    content: "";
    position: absolute;
    top: 0;
    inset-inline: var(--gutter);
    border-top: 1px solid var(--border);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  ul a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--text-secondary);
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      translate var(--duration-standard) var(--ease-enter);
  }
  ul a:hover {
    border-color: var(--border-strong);
    color: var(--foreground);
    translate: 0 -2px;
  }
  .top {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    text-underline-offset: 0.22em;
  }
  .top:hover {
    color: var(--foreground);
  }

  /* The name returns at full width, on the page's own dark ground under a hairline. */
  .band {
    padding-top: clamp(5rem, 3rem + 5vw, 8rem);
    overflow: clip;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-6) var(--space-8);
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
  .legal a {
    color: inherit;
    text-underline-offset: 0.22em;
  }
  .legal a:hover {
    color: var(--foreground);
  }
</style>
