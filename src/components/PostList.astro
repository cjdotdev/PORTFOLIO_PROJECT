---
import { Image } from "astro:assets";
import { localePath, type Dict, type Locale } from "../i18n";
import type { Post } from "../lib/posts";

interface Props {
  posts: Post[];
  t: Dict;
  locale: Locale;
  /** h3 under a section heading on the home page, h2 on /blog. */
  level?: 2 | 3;
  /** /blog: topic filters over the list. */
  filters?: boolean;
  /** Home: once the posts stack in one column (phone), only the newest shows; "All posts" leads on. */
  compact?: boolean;
}

const { posts, t, locale, level = 3, filters = false, compact = false } = Astro.props;
const format = new Intl.DateTimeFormat(locale === "fr" ? "fr-FR" : "en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
const [featured, ...rest] = posts;
const topics = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<!--
  Writing, laid out after Sanity's blog without its boxes (no cards on this site): the newest post
  featured across the full width, its title large on the left and its summary on the right; the others
  in a grid, each opened by a hairline, its date and topics at the foot like Sanity's author row. A
  post with a cover shows it on top (beside the text for the featured one, on desktop). On /blog,
  topics filter the list. The whole post is the link's target; the title is the only link.
-->
<div class:list={["writing", { compact }]} data-writing>
  {
    filters && topics.length > 1 && (
      <div class="filters" role="group" aria-label={t.writing.filters}>
        <button type="button" aria-pressed="true" data-topic="">
          {t.writing.allTopics}
        </button>
        {topics.map((topic) => (
          <button type="button" aria-pressed="false" data-topic={topic} lang="en">
            {topic}
          </button>
        ))}
      </div>
    )
  }
  {
    featured ? (
      <ol class="posts" role="list">
        {[featured, ...rest].map(({ id, data }, i) => (
          <li
            class:list={["post", { featured: i === 0, "has-cover": data.cover }]}
            data-tags={data.tags.join("|")}
          >
            {data.cover && (
              <Image
                class="cover"
                src={data.cover}
                alt=""
                widths={[480, 800, 1200]}
                sizes={i === 0 ? "(min-width: 64rem) 40rem, 92vw" : "(min-width: 64rem) 24rem, (min-width: 40rem) 46vw, 92vw"}
                loading={i === 0 ? "eager" : "lazy"}
              />
            )}
            <div class="text" lang="en">
              {level === 2 ? (
                <h2 class="title">
                  <a href={localePath(locale, `/blog/${id}/`)}>{data.title}</a>
                </h2>
              ) : (
                <h3 class="title">
                  <a href={localePath(locale, `/blog/${id}/`)}>{data.title}</a>
                </h3>
              )}
              <p class="brief">{data.subtitle}</p>
            </div>
            <p class="meta mono">
              <time datetime={data.date.toISOString().slice(0, 10)}>{format.format(data.date)}</time>
              <span class="tags" lang="en">
                {data.tags.map((tag) => (
                  <span>{tag}</span>
                ))}
              </span>
            </p>
          </li>
        ))}
      </ol>
    ) : (
      <p class="empty">{t.writing.empty}</p>
    )
  }
</div>

<script>
  // /blog: a topic shows only its posts; "All" shows them all again. The featured slot goes to the
  // first post still shown.
  document.querySelectorAll<HTMLElement>("[data-writing]").forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-topic]")];
    const posts = [...root.querySelectorAll<HTMLElement>(".post")];
    buttons.forEach((button) =>
      button.addEventListener("click", () => {
        const topic = button.dataset.topic ?? "";
        buttons.forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
        let first = true;
        for (const post of posts) {
          const shown = !topic || (post.dataset.tags ?? "").split("|").includes(topic);
          post.hidden = !shown;
          post.classList.toggle("featured", shown && first);
          if (shown) first = false;
        }
      }),
    );
    // A topic linked from a post (/blog/?topic=Cloudflare) opens the list already filtered.
    const asked = new URLSearchParams(location.search).get("topic");
    buttons.find((button) => asked && button.dataset.topic === asked)?.click();
  });
</script>

<style>
  .writing {
    display: grid;
    gap: var(--space-8);
  }

  /* Topic filters: words, the chosen one underlined in terracotta. */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
  }
  .filters button {
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-secondary);
    font: inherit;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-standard),
      text-decoration-color var(--duration-fast) var(--ease-standard);
  }
  .filters button:hover,
  .filters button[aria-pressed="true"] {
    color: var(--foreground);
  }
  .filters button[aria-pressed="true"] {
    text-decoration-color: var(--accent);
  }

  .posts {
    display: grid;
    gap: var(--space-12) var(--space-8);
    margin: 0;
    padding: 0;
  }
  .post {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }
  /* A post filtered out: its display: grid would otherwise override the hidden attribute. */
  .post[hidden] {
    display: none;
  }
  /* The cover: decorative here (the title says what the post is), 1.9:1 like Hashnode's. */
  .cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1.9;
    object-fit: cover;
    border-radius: var(--radius-control);
    background: var(--surface);
  }
  .post:not(.has-cover) {
    grid-template-rows: 1fr auto;
  }
  .text {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
    line-height: 1.2;
    text-wrap: balance;
  }
  /* The whole post is the link's target; the title stays the only link in the tab order. */
  .title a {
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .post:hover .title a {
    color: var(--accent);
  }
  .title a:focus-visible {
    outline: none;
  }
  .post:has(.title a:focus-visible) {
    outline: 2px solid var(--focus-outline);
    outline-offset: 6px;
    border-radius: 6px;
  }
  .brief {
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    color: var(--text-secondary);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* The newest post, across the full width: title large on the left, summary and meta on the right. */
  .featured {
    padding-block: var(--space-8);
    border-bottom: 1px solid var(--border);
  }
  .featured .title {
    font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.75rem);
    line-height: 1.1;
  }
  .featured .brief {
    font-size: var(--text-lg);
  }

  .empty {
    color: var(--text-secondary);
  }

  /* One column (phone): the home page keeps the newest post only. */
  @media (max-width: 39.99rem) {
    .compact .post:not(:first-child) {
      display: none;
    }
  }
  @media (min-width: 40rem) {
    .posts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .featured {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 64rem) {
    .posts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .featured {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-rows: auto;
      column-gap: clamp(2rem, 1rem + 4vw, 6rem);
    }
    /* The summary moves beside the title, the meta under the summary. */
    .featured .text {
      display: contents;
    }
    .featured .title {
      grid-column: 1;
      grid-row: 1 / span 2;
    }
    .featured .brief {
      grid-column: 2;
      grid-row: 1;
    }
    .featured .meta {
      grid-column: 2;
      grid-row: 2;
      align-self: end;
    }
    /* With a cover: the cover on the left, title, summary and meta stacked on the right. */
    .featured.has-cover {
      grid-template-rows: auto auto 1fr auto;
      row-gap: var(--space-4);
    }
    .featured.has-cover .cover {
      grid-column: 1;
      grid-row: 1 / -1;
      align-self: start;
    }
    .featured.has-cover .title {
      grid-column: 2;
      grid-row: 1;
    }
    .featured.has-cover .brief {
      grid-column: 2;
      grid-row: 2;
    }
    .featured.has-cover .meta {
      grid-row: 4;
    }
  }
</style>
