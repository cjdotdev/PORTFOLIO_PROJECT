---
import { Image } from "astro:assets";
import { siGithub } from "simple-icons";
import contrastoShot from "../assets/work/contrasto.webp";
import CardBack from "./CardBack.astro";
import TechList from "./TechList.astro";
import { PROJECTS, PROJECTS_PAGE } from "../data";
import { localePath, type Dict, type Locale } from "../i18n";

interface Props {
  t: Dict;
  locale: Locale;
}

const { t, locale } = Astro.props;
/** Plain backs under the projects, so the deck has the thickness of a real one. */
const SPARE = 2;
// Lucide icons (ISC), the set Arc uses, drawn at Arc's 1.75 stroke: a barrier for work under way, a
// calendar with a clock for what comes next, and the arrow of the "all projects" link.
const STATUS_ICON = {
  building:
    '<rect x="2" y="6" width="20" height="8" rx="1"/><path d="M17 14v7"/><path d="M7 14v7"/><path d="M17 3v3"/><path d="M7 3v3"/><path d="M10 14 2.3 6.3"/><path d="m14 6 7.7 7.7"/><path d="m8 6 8 8"/>',
  planned:
    '<path d="M21 7.5V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h3.5"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h5"/><path d="M17.5 17.5 16 16.3V14"/><circle cx="16" cy="16" r="6"/>',
};
const ARROW = '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>';
/** The finished projects whose logos fan out in the "all projects" link. */
const shipped = PROJECTS.filter((project) => !project.status).slice(0, 3);
const month = new Intl.DateTimeFormat(locale === "fr" ? "fr-FR" : "en-US", {
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
---

<section class="deck-section section container" id="work" aria-labelledby="work-title" data-deck-section>
  <div class="pin">
    <div class="head">
      <h2 id="work-title" class="display">{t.work.title}</h2>
      {/* The way to every project: the finished ones' logos overlap in a row, each over the next, and
          stay put; pointed at, the circle turns terracotta and its arrow runs through. Only while
          /projects is shown (PROJECTS_PAGE). */}
      {
        PROJECTS_PAGE && (
          <a class="all" href={localePath(locale, "/projects/")}>
            <span class="all-fan" aria-hidden="true">
              {shipped.map((project, i) => <img src={project.logo} alt="" width="22" height="22" style={`--i:${i}`} />)}
            </span>
            <span class="all-label">{t.work.all}</span>
            <span class="all-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" set:html={ARROW} />
              <svg viewBox="0 0 24 24" set:html={ARROW} />
            </span>
          </a>
        )
      }
    </div>

    <div class="board">
      {/* Tablet and desktop: a deck lying on a table, seen from above at an angle, so each card reads
          as a parallelogram. Only the cards move it. The top card lies face up; pressing it brings an
          engraved hand in, of the same family as the opening title's, that takes it and holds it up,
          and the next card turns face up. Pressing the drawn card slips it back under the deck.
          Phone: the same cards stand as a pile under the thumb. A swipe sends the top card round to
          the back (turning over on the way), the other way brings the last one back to the top, and a
          tap plays the top card's demo. The panel always shows the top card. */}
      <div class="table" data-table>
        <div class="deck" role="group" aria-label={t.work.deck} data-deck>
          {
            Array.from({ length: SPARE }, (_, i) => (
              <div class="card spare" style={`--slot:${i}`}>
                <CardBack />
              </div>
            ))
          }
          {
            PROJECTS.map((project, i) => {
              const name = t.work.items[project.id].name;
              return (
                <button
                  type="button"
                  class="card project"
                  style={`--slot:${SPARE + PROJECTS.length - 1 - i}`}
                  data-card={project.id}
                  aria-controls={`panel-${project.id}`}
                  aria-label={`${t.work.draw}: ${name}`}
                >
                  <span class:list={["face", { "is-wip": project.status && !project.video }]}>
                    {project.video ? (
                      // A demo loop; a project under way can have one too (a concept trailer), its status badge stays.
                      <video muted loop playsinline preload="none" poster={project.video.poster} aria-hidden="true">
                        <source src={project.video.src} type="video/webm" />
                      </video>
                    ) : project.status ? (
                      // Not built yet and nothing to show: a construction face, all CSS, with the project's own icon.
                      <span class="wip">
                        <img class="wip-icon" src={project.logo} alt="" width="64" height="64" draggable="false" />
                        <span class="wip-name">{name}</span>
                      </span>
                    ) : (
                      <Image
                        src={contrastoShot}
                        alt=""
                        widths={[480, 800, 1200]}
                        sizes="(min-width: 64rem) 40rem, 90vw"
                        format="webp"
                        quality={80}
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                      />
                    )}
                    <span class="label">
                      <img src={project.logo} alt="" width="20" height="20" draggable="false" />
                      {name}
                    </span>
                    {project.video && <span class="play" aria-hidden="true" />}
                  </span>
                  <CardBack />
                </button>
              );
            })
          }
        </div>
        {/* Loaded on the first draw only: phones never use it. */}
        <img class="hand" data-src="/img/hand-take.webp" alt="" width="1100" height="814" data-hand />
        {/* Wider screens: step through the pile, both ways. */}
        <div class="steps">
          <button type="button" class="step" aria-label={t.work.previous} data-step="previous">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" set:html={`<path d="M19 12H5"/><path d="m12 19-7-7 7-7"/>`} />
          </button>
          <button type="button" class="step" aria-label={t.work.next} data-step="next">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" set:html={`<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>`} />
          </button>
        </div>
      </div>

      <div class="side">
        <p class="hint">
          <span class="hint-deck">{t.work.hint}</span>
          <span class="hint-phone">{t.work.hintSwipe}</span>
        </p>
        <div class="panels" data-panels>
          {
            PROJECTS.map((project) => {
              const copy = t.work.items[project.id];
              return (
                <div class="panel" id={`panel-${project.id}`} data-panel={project.id}>
                  <h3 class="name">
                    <img src={project.logo} alt="" width="36" height="36" />
                    {copy.name}
                    {project.status && (
                      <span class="badge">
                        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={STATUS_ICON[project.status]} />
                        {t.work[project.status]}
                      </span>
                    )}
                  </h3>
                  <p class="line">{copy.line}</p>
                  <dl class="meta">
                    <div>
                      <dt>{project.status ? t.work.due : t.work.delivered}</dt>
                      <dd>
                        <time datetime={project.delivered}>{month.format(new Date(`${project.delivered}-01`))}</time>
                      </dd>
                    </div>
                    <div>
                      <dt class="sr-only">{copy.name}</dt>
                      <dd class="role">{copy.role}</dd>
                    </div>
                  </dl>
                  <TechList stack={project.stack} label={t.work.stack} more={t.work.more} less={t.work.less} />
                  <p class="actions">
                    {project.site && (
                      <a class="btn btn-primary" href={project.site} target="_blank" rel="noopener noreferrer">
                        {t.work.site}
                        <span class="sr-only">: {copy.name}</span>
                      </a>
                    )}
                    {project.repo && (
                      <a class="btn btn-secondary" href={project.repo} target="_blank" rel="noopener noreferrer">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d={siGithub.path} />
                        </svg>
                        GitHub
                        <span class="sr-only">: {copy.name}</span>
                      </a>
                    )}
                  </p>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // The deck's tilt, the same numbers as .deck's transform in the CSS: a drawn card undoes it to stand
  // upright and face the reader.
  const TILT_X = 55;
  const TILT_Z = -35;
  /** Space between two cards in the pile, in px. */
  const GAP = 3;

  type Pose = { a?: number; b?: number; x?: number; y?: number; z?: number; f?: number; s?: number };
  // Every keyframe uses the same list of functions so the browser interpolates each number on its own.
  const pose = ({ a = 0, b = 0, x = 0, y = 0, z = 0, f = 0, s = 1 }: Pose) =>
    `rotateZ(${a}deg) rotateX(${b}deg) translate3d(${x}px, ${y}px, ${z}px) rotateY(${f}deg) scale(${s})`;

  function setup(section: HTMLElement) {
    const table = section.querySelector<HTMLElement>("[data-table]")!;
    const heading = section.querySelector<HTMLElement>("h2")!;
    const deck = section.querySelector<HTMLElement>("[data-deck]")!;
    const hand = section.querySelector<HTMLImageElement>("[data-hand]")!;
    const cards = [...section.querySelectorAll<HTMLButtonElement>("[data-card]")];
    const panels = [...section.querySelectorAll<HTMLElement>("[data-panel]")];
    const panelBox = section.querySelector<HTMLElement>("[data-panels]")!;
    const spares = section.querySelectorAll(".spare").length;
    const still = window.matchMedia("(prefers-reduced-motion: reduce)");
    // Every width now uses the standing pile (Joel, 2026-11-01): phones swipe it, wider screens step
    // through it with the arrows. The table deck drawn by the hand below is kept but no longer used.
    const phone = window.matchMedia("all");
    /** Swiping is for touch-sized screens; wider ones step with the arrows only. */
    const swipeable = window.matchMedia("(max-width: 39.99rem)");
    const spareCards = [...section.querySelectorAll<HTMLElement>(".spare")];

    /** The deck from the top down; the drawn card is out of it. */
    const order = [...cards];
    let drawn: HTMLButtonElement | null = null;
    let queue: Promise<void> = Promise.resolve();
    let pending = 0;
    /** Phone: the top card's demo is playing (a tap starts and stops it). */
    let tapPlaying = false;
    const previousButton = section.querySelector<HTMLButtonElement>('[data-step="previous"]')!;
    const nextButton = section.querySelector<HTMLButtonElement>('[data-step="next"]')!;

    const width = () => cards[0].offsetWidth;
    const zOf = (index: number) => (spares + order.length - 1 - index) * GAP;
    // Shorter moves while several are waiting, so quick clicks never lag behind.
    const ms = (base: number) => (still.matches ? 0 : base / Math.min(3, Math.max(1, pending)));

    function run(card: HTMLElement, frames: string[], duration: number) {
      if (!duration) {
        card.style.transform = frames[frames.length - 1];
        return Promise.resolve();
      }
      const animation = card.animate(
        frames.map((transform) => ({ transform })),
        { duration, easing: "cubic-bezier(.22,1,.36,1)", fill: "forwards" },
      );
      return animation.finished.then(() => {
        card.style.transform = frames[frames.length - 1];
        animation.cancel();
      });
    }

    // Rest: every card in its slot, the top one face up and the only one you can press. A card that
    // comes to the top face down turns over on the way.
    function settle(duration = 0) {
      return Promise.all(
        order.map((card, index) => {
          card.disabled = index !== 0;
          card.tabIndex = index === 0 ? 0 : -1;
          card.style.zIndex = String(100 - index);
          const target = pose({ z: zOf(index), f: index === 0 ? 0 : 180 });
          const from = card.style.transform || target;
          const turnsUp = index === 0 && from.includes("rotateY(180deg)");
          return run(card, turnsUp && duration ? turnOver(zOf(index)) : [from, target], duration);
        }),
      );
    }

    // Face down to face up, turning on its long axis. Half the card's width swings below its centre as
    // it turns, so at every step it is lifted by that much (plus a little) and never cuts the deck.
    function turnOver(z: number) {
      const half = width() / 2;
      return Array.from({ length: 9 }, (_, i) => {
        const f = 180 - i * 22.5;
        return pose({ z: z + Math.sin((f * Math.PI) / 180) * half * 1.08, f });
      });
    }

    function enqueue(job: () => unknown) {
      pending++;
      busy();
      queue = queue.then(async () => {
        try {
          await job();
        } finally {
          pending--;
          busy();
        }
      });
      return queue;
    }
    // One move at a time: while a card is moving, the arrows are disabled and further presses (arrows
    // or cards) are ignored, so hammering a button cannot stack animations.
    function busy() {
      const moving = pending > 0;
      section.toggleAttribute("data-moving", moving);
      section.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((button) => (button.disabled = moving));
    }

    // ─── Phone: a pile standing under the thumb ───
    const flat = ({ x = 0, y = 0, r = 0, f = 0, s = 1 }) =>
      `translate3d(${x}px, ${y}px, 0px) rotate(${r}deg) rotateY(${f}deg) scale(${s})`;
    /** Each card deeper in the pile rests a step lower and a little smaller, so its edge shows. */
    const slotOf = (depth: number) => ({ y: Math.min(depth, 3) * 10, s: 1 - Math.min(depth, 3) * 0.045 });

    function stack(duration = 0) {
      spareCards.forEach((spare) => {
        spare.style.zIndex = "1";
        spare.style.transform = flat(slotOf(3));
      });
      showPanel(order[0].dataset.card!);
      return Promise.all(
        order.map((card, depth) => {
          card.disabled = false;
          card.tabIndex = depth === 0 ? 0 : -1;
          card.style.zIndex = String(100 - depth);
          const target = flat({ ...slotOf(depth), f: depth === 0 ? 0 : 180 });
          return run(card, [card.style.transform || target, target], duration);
        }),
      );
    }

    // Swiped either way: the top card flies off on that side turning over, so its back shows, and
    // slips in at the back of the pile; the next one turns face up.
    async function sendBack(side: -1 | 1) {
      if (order.length < 2) return;
      const card = order[0];
      const away = { x: side * width() * 1.05, y: -6, r: side * 10 };
      // It turns towards the side it flies to; -180 and 180 look the same, so it is then written as 180,
      // the side every card in the pile rests on, and never spins round again on the way in.
      await run(card, [card.style.transform, flat({ ...away, f: -side * 180 })], ms(600));
      card.style.transform = flat({ ...away, f: 180 });
      order.push(order.shift()!);
      await stack(ms(720));
    }

    // The reverse ("previous"): the card at the back slides out on that side from behind the pile, face
    // down, then comes onto the top turning face up as the others step down.
    async function bringBack(side: -1 | 1) {
      if (order.length < 2) return;
      const card = order[order.length - 1];
      const away = { x: side * width() * 1.05, y: -6, r: side * 10 };
      card.style.zIndex = "1";
      await run(card, [card.style.transform, flat({ ...away, f: 180 })], ms(600));
      order.unshift(order.pop()!);
      card.style.zIndex = "200";
      await stack(ms(720));
    }

    // The top card follows the finger sideways; the page keeps its vertical scroll (touch-action).
    let drag: { id: number; x: number; t: number; dx: number } | null = null;
    let dragged = false;
    deck.addEventListener("pointerdown", (event) => {
      if (!swipeable.matches || pending || !order[0].contains(event.target as Node)) return;
      drag = { id: event.pointerId, x: event.clientX, t: event.timeStamp, dx: 0 };
      dragged = false;
    });
    deck.addEventListener("pointermove", (event) => {
      if (!drag || event.pointerId !== drag.id) return;
      drag.dx = event.clientX - drag.x;
      if (Math.abs(drag.dx) > 8 && !dragged) {
        dragged = true;
        order[0].setPointerCapture(event.pointerId);
      }
      if (dragged) order[0].style.transform = flat({ x: drag.dx, r: drag.dx * 0.05 });
    });
    function release(event: PointerEvent, cancelled: boolean) {
      if (!drag || event.pointerId !== drag.id) return;
      const { dx, t } = drag;
      drag = null;
      if (!dragged) return;
      const fast = Math.abs(dx) / Math.max(1, event.timeStamp - t) > 0.5 && Math.abs(dx) > 30;
      if (!cancelled && (Math.abs(dx) > width() * 0.22 || fast)) {
        tapPlaying = false;
        playing(null);
        enqueue(() => sendBack(dx < 0 ? -1 : 1));
      } else {
        run(order[0], [order[0].style.transform, flat({})], 280);
      }
    }
    deck.addEventListener("pointerup", (event) => release(event, false));
    deck.addEventListener("pointercancel", (event) => release(event, true));

    // Where a drawn card stands: upright, in front of the deck and above it, almost as wide as the table.
    function shown(): Pose {
      const tableBox = table.getBoundingClientRect();
      const perspective = parseFloat(getComputedStyle(table).perspective) || 1600;
      const z = 140;
      const grow = perspective / (perspective - z);
      const s = Math.min((tableBox.width * 0.96) / width(), (tableBox.height * 0.6) / (width() * 0.5625)) / grow;
      // Its top edge sits a clear 40px under the section heading, whatever the layout puts between
      // them (on a tablet the hint above the table is hidden by then). The perspective (centred on the
      // table) pushes anything nearer the reader away from that centre, so the target is pulled back
      // towards it by the same factor.
      // The deck's centre is the table's centre (.deck is placed at 50% / 50%), which is also where the
      // perspective looks from; its on-screen box is skewed by the tilt, so it is not measured.
      const height = width() * 0.5625 * s * grow;
      const top = Math.max(tableBox.top, heading.getBoundingClientRect().bottom + 40);
      const origin = tableBox.top + tableBox.height / 2;
      const y = (top + height / 2 - origin) / grow;
      return { a: -TILT_Z, b: -TILT_X, x: 0, y, z, f: 0, s };
    }

    // On a phone the panel always follows the top card and the hint stays above it.
    function showPanel(id: string | null) {
      panels.forEach((panel) => panel.classList.toggle("is-active", panel.dataset.panel === id));
      if (id && !phone.matches) panelBox.dataset.picked = "";
      if (id) section.dataset.top = id;
    }

    function playing(card: HTMLElement | null) {
      for (const other of cards) {
        const video = other.querySelector("video");
        const on = other === card && !!video && !still.matches;
        other.classList.toggle("is-playing", on);
        if (!video) continue;
        if (on) video.play().catch(() => {});
        else video.pause();
      }
    }

    // A drawn card goes back under the deck: it first turns over where it stands, slowly, so its back
    // (the CJ mark and the signature) faces the reader for a moment, then it is slipped in face down.
    async function putBack() {
      if (!drawn) return;
      const card = drawn;
      drawn = null;
      card.classList.remove("is-drawn");
      playing(null);
      order.push(card);
      const slot = zOf(order.length - 1);
      const standing = shown();
      await run(card, [pose(standing), pose({ ...standing, f: 180 })], ms(900));
      if (still.matches) return settle();
      await new Promise((resolve) => setTimeout(resolve, 450));

      // One unbroken move: the card lies down as it comes beside the deck, clear of it and already at
      // the height of its slot at the bottom, then slides in under the others, slowing as it goes,
      // sinks a little past its place and comes back up to it. Meanwhile the cards above lift to let it
      // in and settle back down on it.
      const beside = -width() * 1.06;
      const duration = 1600;
      const lands = card.animate(
        [
          { transform: pose({ ...standing, f: 180 }), easing: "cubic-bezier(.45,0,.25,1)" },
          { transform: pose({ x: beside, z: slot + 1, f: 180 }), offset: 0.48, easing: "cubic-bezier(.3,0,.2,1)" },
          { transform: pose({ x: beside * 0.35, z: slot, f: 180 }), offset: 0.76, easing: "cubic-bezier(.2,.7,.2,1)" },
          { transform: pose({ z: slot - 6, f: 180 }), offset: 0.92, easing: "ease-out" },
          { transform: pose({ z: slot, f: 180 }) },
        ],
        { duration, fill: "forwards" },
      );
      const above = order.slice(0, -1);
      const lifts = above.map((other, index) => {
        const from = other.style.transform || pose({ z: zOf(index), f: index === 0 ? 0 : 180 });
        const to = pose({ z: zOf(index), f: index === 0 ? 0 : 180 });
        return other.animate(
          [
            { transform: from },
            { transform: pose({ z: zOf(index) + 18 + (above.length - index) * 3, f: index === 0 ? 0 : 180 }), offset: 0.4 },
            { transform: pose({ z: zOf(index) + 14, f: index === 0 ? 0 : 180 }), offset: 0.7 },
            { transform: to },
          ],
          { duration: duration * 0.6, delay: duration * 0.4, easing: "cubic-bezier(.4,0,.2,1)", fill: "forwards" },
        );
      });
      await Promise.all([lands.finished, ...lifts.map((lift) => lift.finished)]);
      card.style.transform = pose({ z: slot, f: 180 });
      lands.cancel();
      above.forEach((other, index) => {
        other.style.transform = pose({ z: zOf(index), f: index === 0 ? 0 : 180 });
      });
      lifts.forEach((lift) => lift.cancel());
      await settle();
    }


    // The hand comes down from the upper right, lays its fingers on the top card, takes it out of the
    // deck and lifts it up to face the reader, then lets go and leaves the way it came.
    async function draw(card: HTMLButtonElement) {
      if (card === drawn || order[0] !== card) return;
      await putBack();
      // The hint goes as soon as the hand comes, so the hand never covers it.
      panelBox.dataset.picked = "";
      order.shift();
      drawn = card;
      card.classList.add("is-drawn");
      card.disabled = false;
      card.tabIndex = -1;
      card.style.zIndex = "200";
      const zTop = zOf(-1);
      const slid = pose({ x: width() * 0.55, z: zTop + 12 });
      const up = pose(shown());

      if (!still.matches) {
        if (!hand.src) {
          hand.src = hand.dataset.src!;
          await hand.decode().catch(() => {});
        }
        card.append(hand);
        hand.classList.add("is-on");
        await hand.animate(
          [
            { translate: "38% -42%", opacity: 0 },
            { translate: "0 0", opacity: 1 },
          ],
          { duration: 420, easing: "cubic-bezier(.22,1,.36,1)", fill: "forwards" },
        ).finished;
        // A beat with the fingers on the card before it moves, as a real hand takes hold.
        await new Promise((resolve) => setTimeout(resolve, 160));
        await run(card, [pose({ z: zTop }), slid], 440);
      }
      await Promise.all([run(card, [still.matches ? up : slid, up], ms(820)), settle(ms(700))]);
      if (!still.matches) {
        await hand.animate(
          [
            { translate: "0 0", opacity: 1 },
            { translate: "42% -46%", opacity: 0 },
          ],
          { duration: 380, easing: "cubic-bezier(.55,0,.75,.2)", fill: "forwards" },
        ).finished;
        hand.classList.remove("is-on");
        hand.getAnimations().forEach((animation) => animation.cancel());
        table.append(hand);
      }
      // The panel waits for the hand to be gone, so the hand never passes over the text.
      showPanel(card.dataset.card!);
      playing(card);
    }

    // The top card is drawn; the drawn card, pressed again, goes back to the deck and the panel gives
    // way to the hint.
    for (const card of cards) {
      card.addEventListener("click", () => {
        if (phone.matches) {
          // A tap (not the end of a swipe) starts or stops the top card's demo.
          if (dragged) return void (dragged = false);
          if (card !== order[0] || pending) return;
          tapPlaying = !tapPlaying;
          playing(tapPlaying ? card : null);
          return;
        }
        if (pending) return;
        if (card === drawn) {
          enqueue(async () => {
            await putBack();
            showPanel(null);
            delete panelBox.dataset.picked;
          });
        } else if (order[0] === card) {
          enqueue(() => draw(card));
        }
      });
    }

    // The arrows (wider screens): next sends the top card behind the pile, previous brings the last
    // one back to the top. One move at a time.
    function stepTo(move: () => Promise<void>) {
      if (pending) return;
      tapPlaying = false;
      playing(null);
      enqueue(move);
    }
    nextButton.addEventListener("click", () => stepTo(() => sendBack(-1)));
    previousButton.addEventListener("click", () => stepTo(() => bringBack(-1)));
    // Keeps a drawn card in place when the table changes size.
    window.addEventListener("resize", () => {
      if (drawn && !phone.matches) drawn.style.transform = pose(shown());
    });

    // Crossing the phone width: a drawn card goes straight back, every card drops its pose and takes
    // its place in the other arrangement.
    function mode() {
      const name = phone.matches ? "phone" : "deck";
      if (section.dataset.mode === name) return;
      section.dataset.mode = name;
      if (drawn) {
        drawn.classList.remove("is-drawn");
        order.push(drawn);
        drawn = null;
      }
      hand.classList.remove("is-on");
      table.append(hand);
      tapPlaying = false;
      playing(null);
      for (const card of [...cards, ...spareCards]) {
        card.getAnimations().forEach((animation) => animation.cancel());
        card.style.transform = "";
        card.style.zIndex = "";
      }
      if (phone.matches) {
        stack();
      } else {
        showPanel(null);
        delete panelBox.dataset.picked;
        settle();
      }
    }
    phone.addEventListener("change", mode);

    // Only the drawn card's video (or, on a phone, the tapped one) plays, and only while it is on screen.
    new IntersectionObserver(([entry]) => {
      const card = phone.matches ? (tapPlaying ? order[0] : null) : drawn;
      playing(entry.isIntersecting ? card : null);
    }).observe(table);

    section.dataset.ready = "";
    mode();
  }

  document.querySelectorAll<HTMLElement>("[data-deck-section]").forEach(setup);
</script>

