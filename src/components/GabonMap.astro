---
/**
 * Gabon, where Joel comes from: its nine provinces and main towns on a flat map in the site's
 * colours. Pointing at (or tapping, or tabbing to) a town or a province lights it and shows what it
 * is beside the map; Ntoum, his town, pulses and is shown first. Geometry: src/data/gabon.ts.
 */
import { GABON_CITIES, GABON_PROVINCES, GABON_VIEWBOX, HOME_CITY } from "../data/gabon";
import type { Dict, Locale } from "../i18n";

interface Props {
  t: Dict;
  locale: Locale;
}

const { t, locale } = Astro.props;
const copy = t.where.gabon;
const count = new Intl.NumberFormat(locale === "fr" ? "fr-FR" : "en-US");
const cityName = (id: string) => GABON_CITIES.find((city) => city.id === id)?.name ?? id;
/** Towns whose name sits on the left of the dot, clear of a neighbour on the right. */
const LEFT = new Set(["libreville", "moanda"]);
---

<div class="homeland" data-gabon>
  <div class="head">
    <h3 class="title">{copy.title}</h3>
    <p class="hint">{copy.hint}</p>
  </div>

  <svg class="map" viewBox={GABON_VIEWBOX} role="group" aria-label={copy.alt} data-map>
    <g class="provinces">
      {GABON_PROVINCES.map((province) => <path class="province" d={province.d} data-province={province.name} />)}
      {/* The lit province's outline, drawn over its neighbours' so none of its edge is hidden. */}
      <path class="outline" d="" data-outline />
    </g>
    <g class="cities">
      {
        GABON_CITIES.map((city) => {
          const home = city.id === HOME_CITY;
          const left = LEFT.has(city.id);
          return (
            <g
              class:list={["city", { home }]}
              transform={`translate(${city.x} ${city.y})`}
              data-city={city.id}
              data-in={city.province}
              tabindex="0"
              role="button"
              aria-label={`${city.name}, ${city.province}`}
            >
              <circle class="hit" r="18" />
              {home && <circle class="pulse" r="7" />}
              <circle class="dot" r={home ? 4 : 4.5} />
              {/* Lucide "map-pin", its point on the town: the destination, where Joel comes from. */}
              {home && (
                <g class="home-pin" transform="translate(-15.6 -28.6) scale(1.3)" aria-hidden="true">
                  <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
                  <circle cx="12" cy="10" r="3" />
                </g>
              )}
              <text class="name" x={left ? -11 : 11} y="5" text-anchor={left ? "end" : "start"}>
                {city.name}
              </text>
            </g>
          );
        })
      }
    </g>
  </svg>

  <div class="info" aria-live="polite">
    {
      GABON_CITIES.map((city) => (
        <div class="card" data-info={city.id} hidden={city.id !== HOME_CITY}>
          <p class="card-name">
            {city.name}
            {city.id === HOME_CITY && <span class="home-tag">{copy.home}</span>}
          </p>
          <p class="card-line">{copy.cities[city.id]}</p>
          <dl class="facts">
            <div>
              <dt>{copy.province}</dt>
              <dd>{city.province}</dd>
            </div>
            <div>
              <dt>{copy.population}</dt>
              <dd>
                {count.format(city.population.count)} <span class="year">({city.population.year})</span>
              </dd>
            </div>
          </dl>
        </div>
      ))
    }
    {
      GABON_PROVINCES.map((province) => (
        <div class="card" data-info={`province:${province.name}`} hidden>
          <p class="card-name">{province.name}</p>
          <dl class="facts">
            <div>
              <dt>{copy.chiefTown}</dt>
              <dd>{cityName(province.capital)}</dd>
            </div>
          </dl>
        </div>
      ))
    }
  </div>

  <p class="credit">{copy.credit}</p>
</div>

<script>
  // One town or province is chosen at a time (Ntoum to begin with). Pointing at another shows it for
  // as long as the pointer stays; a tap, a click or the keyboard chooses it.
  function setup(root: HTMLElement) {
    const cities = [...root.querySelectorAll<SVGGElement>("[data-city]")];
    const provinces = [...root.querySelectorAll<SVGPathElement>("[data-province]")];
    const cards = [...root.querySelectorAll<HTMLElement>("[data-info]")];
    const outline = root.querySelector<SVGPathElement>("[data-outline]")!;
    let chosen = root.querySelector<SVGGElement>(".city.home")?.dataset.city ?? cities[0].dataset.city!;

    // A key is a town id, or "province:<name>".
    function show(key: string) {
      const city = cities.find((element) => element.dataset.city === key);
      const province = city ? city.dataset.in : key.replace(/^province:/, "");
      cards.forEach((card) => (card.hidden = card.dataset.info !== key));
      cities.forEach((element) => element.classList.toggle("is-active", element === city));
      for (const path of provinces) {
        const lit = path.dataset.province === province;
        path.classList.toggle("is-lit", lit);
        if (lit) outline.setAttribute("d", path.getAttribute("d")!);
      }
    }

    const choose = (key: string) => {
      chosen = key;
      show(key);
    };
    const fine = window.matchMedia("(hover: hover)");

    for (const city of cities) {
      const key = city.dataset.city!;
      city.addEventListener("pointerenter", () => fine.matches && show(key));
      city.addEventListener("pointerleave", () => fine.matches && show(chosen));
      city.addEventListener("click", () => choose(key));
      city.addEventListener("focus", () => choose(key));
      city.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          choose(key);
        }
      });
    }
    for (const path of provinces) {
      const key = `province:${path.dataset.province}`;
      path.addEventListener("pointerenter", () => fine.matches && show(key));
      path.addEventListener("pointerleave", () => fine.matches && show(chosen));
      path.addEventListener("click", () => choose(key));
    }
    show(chosen);
  }

  document.querySelectorAll<HTMLElement>("[data-gabon]").forEach(setup);
</script>

<style>
  .homeland {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-surface);
    background: var(--surface);
    container-type: inline-size;
  }
  .head {
    display: grid;
    gap: var(--space-1);
  }
  .title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
    line-height: 1.2;
  }
  .hint {
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  /* ─── The map ─── */
  .map {
    display: block;
    width: 100%;
    height: auto;
    max-height: 24rem;
    overflow: visible;
    -webkit-tap-highlight-color: transparent;
  }
  .province {
    fill: var(--surface-muted);
    stroke: var(--border-strong);
    stroke-width: 1.2;
    stroke-linejoin: round;
    cursor: pointer;
    transition:
      fill var(--duration-fast) var(--ease-standard),
      stroke var(--duration-fast) var(--ease-standard);
  }
  .province.is-lit {
    fill: color-mix(in srgb, var(--accent) 16%, var(--surface));
  }
  .outline {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-linejoin: round;
    pointer-events: none;
  }
  .city {
    cursor: pointer;
    outline: none;
  }
  .hit {
    fill: transparent;
  }
  .dot {
    fill: var(--accent);
    stroke: var(--surface);
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: center;
    transition: scale var(--duration-fast) var(--ease-standard);
  }
  .city.is-active .dot {
    scale: 1.5;
  }
  .city:focus-visible .dot {
    stroke: var(--foreground);
    stroke-width: 2.5;
  }
  /* Ntoum's pin: terracotta, its eye cut out in the card's colour, a halo so it reads over lines. */
  .home-pin {
    pointer-events: none;
    transition: translate var(--duration-fast) var(--ease-standard);
  }
  .home-pin path {
    fill: var(--accent);
    stroke: var(--surface);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .home-pin circle {
    fill: var(--surface);
  }
  .city.home.is-active .home-pin {
    translate: 0 -3px;
  }
  .pulse {
    fill: var(--accent);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pulse {
      animation: pulse 2.4s var(--ease-standard) infinite;
    }
  }
  @keyframes pulse {
    from {
      scale: 1;
      opacity: 0.55;
    }
    to {
      scale: 3.4;
      opacity: 0;
    }
  }
  /* Names wear a halo of the card's colour, so they read over province lines. */
  .name {
    fill: var(--text-secondary);
    font-family: var(--font-body);
    font-size: 15px;
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 4px;
    stroke-linejoin: round;
    pointer-events: none;
    transition: fill var(--duration-fast) var(--ease-standard);
  }
  .city.home .name,
  .city.is-active .name {
    fill: var(--foreground);
    font-weight: 500;
  }

  /* ─── What the chosen place is ─── */
  .info {
    display: grid;
    min-height: 7.5rem;
  }
  .card {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }
  .card[hidden] {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .card:not([hidden]) {
      animation: card-in 240ms var(--ease-enter);
    }
  }
  @keyframes card-in {
    from {
      opacity: 0;
      translate: 0 4px;
    }
  }
  .card-name {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
  }
  .home-tag {
    padding: 2px var(--space-3);
    border: 1px solid color-mix(in srgb, var(--accent) 60%, transparent);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--accent) 14%, var(--background));
    color: var(--accent);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0;
  }
  .card-line {
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
    margin: 0;
    font-size: var(--text-sm);
  }
  .facts div {
    display: flex;
    gap: var(--space-2);
  }
  .facts dt {
    color: var(--text-secondary);
  }
  .facts dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .year {
    color: var(--text-muted);
  }
  .credit {
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  /* A narrow card (phone): only the chosen town and Ntoum keep their names, set larger. */
  @container (max-width: 26rem) {
    .name {
      display: none;
      font-size: 24px;
      stroke-width: 6px;
    }
    .city.home .name,
    .city.is-active .name {
      display: inline;
    }
    .hit {
      r: 26;
    }
  }
</style>
