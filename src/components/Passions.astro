---
import { WRESTLERS, wrestlerPhoto } from "../data/passions";
import type { Dict } from "../i18n";

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const p = t.passions;
const w = p.wrestling;
const kojima = WRESTLERS.kojima;
---

<section class="passions" id="off-the-clock" aria-labelledby="passions-title">
  <div class="container head reveal">
    <h2 id="passions-title" class="display">{p.title}</h2>
    <p class="lede">{p.lede}</p>
  </div>

  <!-- The ring: a night band for Kojima, who gave the site its orange. Music and games were taken out
       (Joel, 2026-10-31): the section is about wrestling only. -->
  <div class="ring">
    <div class="container">
      <div class="story">
        <div class="story-text">
          <h3 class="ring-title">{w.title}</h3>
          <p class="ring-lede">{w.body}</p>
          <a class="story-link" href={w.href}>
            {w.cta}
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </a>
        </div>
        <figure class="kojima">
          <a href={w.href} tabindex="-1" aria-hidden="true">
            <img src={wrestlerPhoto(kojima.id)} alt="" width="720" height="900" loading="lazy" decoding="async" />
          </a>
          <figcaption><span class="dot" aria-hidden="true"></span>{w.caption}</figcaption>
        </figure>
      </div>
    </div>

  </div>

  <div class="container credits-wrap">
    <details class="credits">
      <summary>{p.credits}</summary>
      <p>{p.creditsNote}</p>
      <ul role="list">
        <li>
          <a href={kojima.credit.source} target="_blank" rel="noopener noreferrer">{kojima.name}</a>: {kojima.credit.author},{" "}
          <a href={kojima.credit.licenseUrl} target="_blank" rel="noopener noreferrer">{kojima.credit.license}</a>
        </li>
      </ul>
    </details>
  </div>
</section>

<style>
  .passions {
    padding-block: var(--section-space);
  }
  .head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }

  /* ─── The ring: a night band, the same in both themes ─── */
  .ring {
    --ring-bg: #0f0f0f;
    --ring-ink: #f3f3f3;
    --ring-muted: #a3a3a3;
    --ring-line: #2a2a2a;
    --ring-accent: #e8916f;
    padding-block: var(--section-space);
    background: var(--ring-bg);
    color: var(--ring-ink);
  }
  :global(:root[data-theme="dark"]) .ring {
    --ring-bg: #111111;
    border-block: 1px solid var(--ring-line);
  }
  .ring-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.3rem + 2.8vw, 3.5rem);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
    line-height: 1.02;
    text-wrap: balance;
  }
  .ring-lede {
    max-width: 34rem;
    color: var(--ring-muted);
    font-size: var(--text-lg);
    text-wrap: pretty;
  }
  /* Kojima: the only photo in colour, because the orange is the point. */
  .story {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
    gap: var(--space-8) clamp(2rem, 1rem + 5vw, 6rem);
    align-items: center;
  }
  .story-text {
    display: grid;
    gap: var(--space-5);
  }
  .story-link {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding-inline: var(--space-5);
    border-radius: var(--radius-control);
    background: var(--ring-accent);
    color: #1b0d07;
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      transform var(--duration-instant) var(--ease-standard);
  }
  .story-link:hover {
    background: #f0a888;
  }
  .story-link:active {
    transform: scale(0.98);
  }
  .story-link svg {
    transition: translate var(--duration-fast) var(--ease-standard);
  }
  .story-link:hover svg {
    translate: 3px 0;
  }
  .kojima {
    display: grid;
    gap: var(--space-3);
  }
  .kojima a {
    display: block;
  }
  .kojima img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-surface);
  }
  .kojima figcaption {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ring-muted);
    font-size: var(--text-sm);
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--ring-accent);
  }

  .credits-wrap {
    padding-top: var(--space-6);
  }
  .credits {
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
  .credits summary {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    cursor: pointer;
  }
  .credits ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-1) var(--space-6);
    margin-block: var(--space-2) var(--space-4);
  }
  .credits p {
    max-width: 52rem;
    margin-bottom: var(--space-2);
  }
  .credits a {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  /* ─── Smaller screens ─── */
  @media (max-width: 55rem) {
    .story {
      grid-template-columns: minmax(0, 1fr);
    }
    .kojima {
      max-width: 22rem;
    }
  }
</style>
