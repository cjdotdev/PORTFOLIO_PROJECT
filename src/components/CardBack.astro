---
/**
 * The back of every card in the project deck: the brand as the opening title ends, the CJ mark over
 * "JOEL" (small, widely tracked, the display face) stacked over "CODJA" (Monoton), inside a thin
 * terracotta frame.
 * Sized in container units, so one back serves any card size.
 */
import Mark from "./Mark.astro";
---

{/* Spans only: the back also sits inside the project cards, which are buttons. */}
<span class="back" aria-hidden="true">
  <span class="frame">
    <Mark size="22cqw" />
    <span class="sign"><span class="first">Joel</span> <span class="surname">CODJA</span></span>
  </span>
</span>

<style>
  .back {
    display: block;
    position: absolute;
    inset: 0;
    container-type: inline-size;
    padding: 3.2cqw;
    border-radius: inherit;
    background: var(--surface);
  }
  .frame {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 2.4cqw;
    height: 100%;
    box-sizing: border-box;
    border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent);
    border-radius: 2.4cqw;
    color: var(--foreground);
  }
  .sign {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.22em;
    font-size: 7.6cqw;
    line-height: 1;
    white-space: nowrap;
  }
  /* As in the intro: the tracking also trails the last letter, so the same padding on the left keeps
     the word centred. */
  .first {
    padding-left: 0.32em;
    color: color-mix(in srgb, var(--foreground) 72%, transparent);
    font-family: var(--font-display);
    font-size: 0.34em;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }
  .surname {
    font-family: "Monoton", var(--font-display);
    letter-spacing: 0.02em;
  }
</style>
