---
/**
 * The back of every card in the project deck: the CJ mark over "Joel CODJA" signed as at the end of
 * the opening title (Joel in the display face, CODJA in Monoton), inside a thin terracotta frame.
 * Sized in container units, so one back serves any card size.
 */
import Mark from "./Mark.astro";
---

{/* Spans only: the back also sits inside the project cards, which are buttons. */}
<span class="back" aria-hidden="true">
  <span class="frame">
    <Mark size="26cqw" />
    <span class="sign"><span class="first">Joel</span> <span class="surname">CODJA</span></span>
  </span>
</span>

<style>
  .back {
    display: block;
    position: absolute;
    inset: 0;
    container-type: inline-size;
    padding: 3.2cqw;
    border-radius: inherit;
    background: var(--surface);
  }
  .frame {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 2.4cqw;
    height: 100%;
    box-sizing: border-box;
    border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent);
    border-radius: 2.4cqw;
    color: var(--foreground);
  }
  .sign {
    display: flex;
    align-items: baseline;
    gap: 0.35em;
    font-size: 6.4cqw;
    line-height: 1;
    white-space: nowrap;
  }
  .first {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .surname {
    font-family: "Monoton", var(--font-display);
    letter-spacing: 0.02em;
  }
</style>
