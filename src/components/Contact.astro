---
import { PERSONAL } from "../data";
import type { Dict } from "../i18n";

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const r = t.contact.request;
const SUBJECTS = ["hire", "project", "hello"] as const;
---

<!--
  Let's talk. The address first, then the form, written as what Joel does: an
  API request. Beside it, Mercury, messenger of the gods, holding up a letter (Queverdo, 1792 to 1798,
  Rijksmuseum RP-P-2024-74), in the sepia line work of the site's other engravings. The request's
  keys are the fields' labels; once it is sent, the response comes back (201 Created) and the hand
  signs it with the intro's quill hand. Sent through EmailJS; the subject goes at the head of the message.
-->
<section class="contact section container reveal" id="contact" aria-labelledby="contact-title">
  <div class="intro">
    <h2 id="contact-title" class="display">{t.contact.title}</h2>
    <p class="lede">{t.contact.lede}</p>
  </div>

  <a class="email" href={`mailto:${PERSONAL.email}`}>{PERSONAL.email}</a>

  <div class="desk">
    <figure class="mercury">
      <img src="/img/contact-mercury.webp" alt={r.engravingAlt} width="760" height="988" loading="lazy" decoding="async" draggable="false" />
    </figure>

    <form
      class="request mono"
      data-request
      aria-label={r.label}
      novalidate
      data-copy={JSON.stringify({ sending: r.sending, submit: r.submit, sent: r.sent, sentComment: r.sentComment, failed: r.failed })}
      data-email={PERSONAL.email}
    >
      <p class="line head">
        <span class="method">POST</span> /joel/messages
      </p>
      <p class="line dim">Content-Type: application/json</p>
      <p class="line dim">// {r.comment}</p>
      <p class="line">{"{"}</p>

      <fieldset class="field">
        <legend class="key">"subject"<span class="sr-only">: {r.subject}</span><span class="dim">:</span></legend>
        <div class="choices">
          {
            SUBJECTS.map((id, i) => (
              <label class="choice">
                <input type="radio" name="subject" value={id} checked={i === 0} />
                <span class="value">"{id}"</span>
                <span class="dim">// {r.subjects[id]}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="field">
        <label class="key" for="req-name">"name"<span class="dim">:</span></label>
        <span class="quote">"<input id="req-name" name="from_name" type="text" autocomplete="name" required placeholder={r.namePlaceholder} />",</span>
      </div>
      <div class="field">
        <label class="key" for="req-email">"email"<span class="dim">:</span></label>
        <span class="quote">"<input id="req-email" name="from_email" type="email" autocomplete="email" required placeholder={r.emailPlaceholder} />",</span>
      </div>
      <div class="field field-message">
        <label class="key" for="req-message">"message"<span class="dim">:</span></label>
        <span class="quote">"<textarea id="req-message" name="message" rows="4" required placeholder={r.messagePlaceholder}></textarea>"</span>
      </div>

      <p class="line">{"}"}</p>

      <div class="send">
        <button type="submit" class="btn btn-primary" data-send>
          <span data-send-label>{r.submit}</span>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
      </div>

      {/* The response: written in by the script, read out to screen readers. */}
      <div class="response" data-response hidden role="status">
        <p class="line status" data-status-line></p>
        <p class="line" data-body-line></p>
        <p class="line dim" data-comment-line></p>
        <button type="button" class="again" data-again>{r.again}</button>
      </div>
    </form>
  </div>
</section>

<script>
  import emailjs from "@emailjs/browser";

  const SERVICE_ID = import.meta.env.PUBLIC_EMAILJS_SERVICE_ID as string | undefined;
  const TEMPLATE_ID = import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID as string | undefined;
  const PUBLIC_KEY = import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY as string | undefined;
  const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // The request.
  const form = document.querySelector<HTMLFormElement>("[data-request]");
  if (form) {
    const copy = JSON.parse(form.dataset.copy ?? "{}") as Record<string, string>;
    const email = form.dataset.email ?? "";
    const button = form.querySelector<HTMLButtonElement>("[data-send]")!;
    const label = form.querySelector<HTMLElement>("[data-send-label]")!;
    const response = form.querySelector<HTMLElement>("[data-response]")!;
    const statusLine = form.querySelector<HTMLElement>("[data-status-line]")!;
    const bodyLine = form.querySelector<HTMLElement>("[data-body-line]")!;
    const commentLine = form.querySelector<HTMLElement>("[data-comment-line]")!;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      form.dataset.state = "sending";
      button.disabled = true;
      label.textContent = copy.sending;
      let ok = false;
      try {
        if (!SERVICE_ID || !TEMPLATE_ID || !PUBLIC_KEY) throw new Error("EmailJS is not configured");
        await emailjs.send(
          SERVICE_ID,
          TEMPLATE_ID,
          {
            from_name: String(data.get("from_name") ?? ""),
            from_email: String(data.get("from_email") ?? ""),
            message: `[${data.get("subject")}]\n\n${data.get("message") ?? ""}`,
          },
          { publicKey: PUBLIC_KEY },
        );
        ok = true;
      } catch {
        ok = false;
      }
      button.disabled = false;
      label.textContent = copy.submit;

      response.hidden = false;
      response.dataset.ok = String(ok);
      statusLine.textContent = ok ? "HTTP/1.1 201 Created" : "HTTP/1.1 502 Bad Gateway";
      bodyLine.textContent = ok ? `{ "status": "${copy.sent}", "reply_within": "48h" }` : `{ "error": "not_sent", "write_to": "${email}" }`;
      commentLine.textContent = `// ${ok ? copy.sentComment : copy.failed.replace("{email}", email)}`;
      form.dataset.state = ok ? "sent" : "failed";
      response.scrollIntoView({ block: "nearest", behavior: calm ? "auto" : "smooth" });
    });

    form.querySelector("[data-again]")?.addEventListener("click", () => {
      form.reset();
      response.hidden = true;
      delete form.dataset.state;
      form.querySelector<HTMLInputElement>("#req-name")?.focus();
    });
  }
</script>

<style>
  .contact {
    display: grid;
    gap: var(--space-10);
  }
  .intro {
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
  }

  /* ─── The address, the largest type in the section ─── */
  .email {
    position: relative;
    display: block;
    width: fit-content;
    max-width: 100%;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 0.6rem + 5.4vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.05;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.14em;
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .email:hover {
    color: var(--accent);
  }

  /* ─── The desk: Mercury and the request ─── */
  .desk {
    display: grid;
    gap: var(--space-8) clamp(2rem, 1rem + 4vw, 6rem);
    align-items: center;
  }
  .mercury {
    justify-self: center;
    width: min(100%, 26rem);
    margin: 0;
  }
  .mercury img {
    width: 100%;
    height: auto;
    opacity: 1;
    pointer-events: none;
    user-select: none;
  }

  /* The request reads like API documentation: mono, the JSON keys as labels, the fields as the
     string values between their quotes, // comments in the page's language. */
  .request {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
    font-size: clamp(0.875rem, 0.8rem + 0.25vw, 1rem);
    line-height: 1.6;
  }
  .line {
    margin: 0;
  }
  .head {
    margin-bottom: var(--space-1);
    font-size: 1.15em;
  }
  .method {
    color: var(--accent);
    font-weight: 500;
  }
  .dim {
    color: var(--text-muted);
  }
  .field {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
    margin: 0;
    padding: 0 0 var(--space-2) 1.5em;
    border: 0;
  }
  .key {
    padding: 0;
    color: var(--text-secondary);
  }
  .quote {
    display: flex;
    align-items: baseline;
    gap: 0.1em;
    min-width: 0;
    color: var(--text-muted);
  }
  .quote input,
  .quote textarea {
    flex: 1;
    min-width: 0;
    min-height: 2.75rem;
    padding: var(--space-2) 0;
    border: 0;
    border-bottom: 1px solid var(--border-strong);
    border-radius: 0;
    background: transparent;
    color: var(--foreground);
    font: inherit;
    font-size: 1.05em;
    transition: border-color var(--duration-fast) var(--ease-standard);
  }
  .quote textarea {
    min-height: 6.5rem;
    resize: vertical;
  }
  .quote input::placeholder,
  .quote textarea::placeholder {
    color: var(--text-muted);
    opacity: 0.7;
  }
  .quote input:hover,
  .quote textarea:hover {
    border-bottom-color: var(--text-muted);
  }
  .quote input:focus-visible,
  .quote textarea:focus-visible {
    border-bottom-color: var(--accent);
    outline: none;
  }

  /* The subject: three string values, the chosen one in terracotta. */
  .choices {
    display: grid;
    gap: var(--space-1);
  }
  .choice {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-3);
    min-height: 2.25rem;
    cursor: pointer;
  }
  .choice input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .choice .value {
    color: var(--text-secondary);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.3em;
    transition:
      color var(--duration-fast) var(--ease-standard),
      text-decoration-color var(--duration-fast) var(--ease-standard);
  }
  .choice:hover .value {
    color: var(--foreground);
  }
  .choice:has(input:checked) .value {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
  .choice:has(input:focus-visible) .value {
    outline: 2px solid var(--focus-outline);
    outline-offset: 3px;
    border-radius: 3px;
  }

  .send {
    padding-top: var(--space-4);
    font-family: var(--font-body);
  }
  .request[data-state="sending"] .send .btn {
    opacity: 0.6;
  }

  /* The response, written back under the request; hidden until a request has been sent (its own
     display would otherwise override the hidden attribute). */
  .response[hidden] {
    display: none;
  }
  /* The response, written back under the request. */
  .response {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }
  .status {
    color: var(--success, #7ac58f);
    font-weight: 500;
  }
  .response[data-ok="false"] .status {
    color: var(--danger);
  }
  .again {
    justify-self: start;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-secondary);
    font-family: var(--font-body);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    cursor: pointer;
  }
  .again:hover {
    color: var(--foreground);
  }
  /* While the response shows, the request stays readable but cannot be sent twice. */
  .request:is([data-state="sent"]) .send {
    display: none;
  }

  /* Desktop: Mercury on the left, the request on the right. */
  @media (min-width: 56rem) {
    .desk {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
    .mercury {
      width: 100%;
    }
  }
  /* Phone: the engraving steps out; the request takes the full width. */
  @media (max-width: 39.99rem) {
    .mercury {
      display: none;
    }
    .field {
      padding-left: 1em;
    }
  }
</style>
