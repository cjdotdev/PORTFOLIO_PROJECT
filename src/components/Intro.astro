---
import Mark from "./Mark.astro";
import { CJ_C, CJ_GROUP, CJ_VIEWBOX } from "../data/cj-mark";
import type { Dict } from "../i18n";

interface Props {
  t: Dict;
}

const { t } = Astro.props;

// The middle of the C's stroke, from its upper tip round the left to its lower end, in the mark's
// own units: the ink mask is drawn along it and the pen is moved along it, so the C appears behind the nib.
const C_LINE =
  "M150 28 C146 14 126 6 112 8 C94 10 76 24 66 42 C56 60 50 80 50 96 C50 118 60 134 76 139 C92 144 108 137 120 130 C125 128 129 128 133 128";
// The hand (720 x 450 px, Rijksmuseum, 1605) drawn 300 units wide, a little larger than the mark;
// its nib sits at (0, 125.75), on the image's left edge.
const HAND = { width: 300, height: 187.5, nibY: 125.75 };
// The pen comes in from the lower right to the C's upper tip, writes, and leaves the same way.
const ENTER_PATH = "M360 270 C300 170 210 70 150 28";
const LEAVE_PATH = "M133 128 C200 150 300 220 390 330";
---

<!--
  The opening title: about ten and a half seconds, once per browser session, one continuous shot. A
  light leak opens the frame; an engraved hand (sepia, 1605) writes the C in one stroke; the J
  drops and swings with light running across it; the shadow builds out; "Joel CODJA" writes itself
  under the mark; then the mark flies to its place in the header as the page opens. Everything runs on
  the CSS clock: the ink is a stroke drawn along the C. The hand is a plain image moved by a transform
  animation built once from the same paths, easings and start time as the ink, so the compositor
  plays it smoothly even while the page is still loading. The script also measures the header for
  the flight and lets a click or a key skip it. Layout.astro sets data-intro="off" before the first paint
  for repeat visits and reduced motion, and then this never renders on screen.
-->
<div class="intro" data-intro-root aria-hidden="true">
  <div class="curtain top"></div>
  <div class="curtain bottom"></div>
  <div class="stage">
    <span class="flare"></span>
    <span class="flare flare-hit"></span>
    <Mark size="var(--mark)" class="mark" glint />
    <div class="sign-wrap">
      <p class="sign"><span class="first">Joel</span> <span class="surname">CODJA</span></p>
      <span class="caret"></span>
    </div>
    <svg class="scribe" viewBox={CJ_VIEWBOX} aria-hidden="true" data-scribe>
      <defs>
        <mask id="intro-ink" maskUnits="userSpaceOnUse" x="-60" y="-60" width="400" height="400">
          <path class="nib-write" d={C_LINE} pathLength="1" fill="none" stroke="#fff" stroke-width="52" stroke-linecap="round" stroke-linejoin="round" />
        </mask>
      </defs>
      <g class="ink" mask="url(#intro-ink)">
        <g transform={CJ_GROUP}><path transform={CJ_C.transform} d={CJ_C.d} /></g>
      </g>
      {/* Invisible tracks for the way in and out: their timing is the pen's timing. */}
      <path class="track nib-enter" d={ENTER_PATH} pathLength="1" />
      <path class="track nib-leave" d={LEAVE_PATH} pathLength="1" />
    </svg>
    {/* The pen, over the scribe: a plane in the mark's own units, scaled to the mark's size. */}
    <div class="pen">
      <div class="pen-plane" data-pen data-viewbox={CJ_VIEWBOX} style={`--vb:${CJ_VIEWBOX.split(" ")[2]}px`}>
        <img
          class="hand"
          src="/img/intro-hand-v1.webp"
          alt=""
          draggable="false"
          data-hand
          style={`width:${HAND.width}px;height:${HAND.height}px;margin-top:-${HAND.nibY}px`}
        />
      </div>
    </div>
  </div>
  <div class="grain"></div>
  <span class="bar bar-top"></span>
  <span class="bar bar-bottom"></span>
</div>
<button type="button" class="skip-intro" data-intro-skip tabindex="0">{t.intro.skip}</button>

<script>
  const root = document.querySelector<HTMLElement>("[data-intro-root]");
  const skip = document.querySelector<HTMLButtonElement>("[data-intro-skip]");
  const html = document.documentElement;

  try {
    sessionStorage.setItem("joelcodja.intro", "seen");
  } catch {
    // storage blocked: the intro may play again on the next page, nothing else breaks
  }

  function end() {
    html.dataset.intro = "done";
    root?.remove();
    skip?.remove();
    document.removeEventListener("keydown", onKey);
    window.removeEventListener("resize", aim);
    window.removeEventListener("resize", scale);
  }
  function onKey(event: KeyboardEvent) {
    if (event.key === "Tab") return;
    end();
  }

  // The flight: from the middle of the screen up to the header's mark at the top centre, same centre,
  // same size. The
  // header mark is hidden while the intro plays and shows again the moment this one lands on it.
  function aim() {
    const big = root?.querySelector<HTMLElement>(".mark");
    const small = document.querySelector<HTMLElement>(".brand .cj");
    if (!big || !small) return;
    const from = big.getBoundingClientRect();
    const to = small.getBoundingClientRect();
    if (!from.width || !to.width) return;
    big.style.setProperty("--fly-x", `${to.left + to.width / 2 - (from.left + from.width / 2)}px`);
    big.style.setProperty("--fly-y", `${to.top + to.height / 2 - (from.top + from.height / 2)}px`);
    big.style.setProperty("--fly-s", String(to.width / from.width));
  }

  const scribe = root?.querySelector<SVGSVGElement>("[data-scribe]");
  const plane = root?.querySelector<HTMLElement>("[data-pen]");

  // The pen plane is drawn in the mark's units: scale it to the size the mark has on this screen.
  function scale() {
    const size = scribe?.getBoundingClientRect().width;
    const units = parseFloat(plane?.style.getPropertyValue("--vb") ?? "");
    if (size && units) plane?.style.setProperty("--pen-k", String(size / units));
  }

  // The pen: for each leg (in, the C, out), sample the path the ink or the track follows into
  // transform keyframes, then play them with that leg's CSS duration, delay and easing, started at
  // the same instant. A stroke-dashoffset grows evenly along the path's length, and so do these
  // keyframes, so hand and ink stay together, and the hand never waits on the main thread.
  function pen() {
    const hand = plane?.querySelector<HTMLElement>("[data-hand]");
    if (!scribe || !plane || !hand) return;
    const [left, top] = (plane.dataset.viewbox ?? "0 0").split(" ").map(Number);
    const legs: [string, number, FillMode][] = [
      [".nib-enter", 24, "both"],
      [".nib-write", 60, "forwards"],
      [".nib-leave", 24, "forwards"],
    ];
    for (const [selector, steps, fill] of legs) {
      const track = scribe.querySelector<SVGPathElement>(selector);
      const clock = track?.getAnimations()[0];
      if (!track || !(clock?.effect instanceof KeyframeEffect)) continue;
      const length = track.getTotalLength();
      const frames = Array.from({ length: steps + 1 }, (_, i) => {
        const point = track.getPointAtLength((i / steps) * length);
        return { transform: `translate(${(point.x - left).toFixed(2)}px, ${(point.y - top).toFixed(2)}px)` };
      });
      // A CSS animation keeps its timing function on its keyframes, not on the effect.
      const easing = clock.effect.getKeyframes()[0]?.easing ?? "linear";
      const { duration, delay } = clock.effect.getTiming();
      const move = hand.animate(frames, { duration, delay, easing, fill });
      clock.ready.then(() => {
        move.startTime = clock.startTime;
      });
    }
  }

  if (html.dataset.intro === "on" && root) {
    aim();
    scale();
    pen();
    window.addEventListener("resize", aim);
    window.addEventListener("resize", scale);
    root.addEventListener("click", end);
    skip?.addEventListener("click", end);
    document.addEventListener("keydown", onKey);
    root.addEventListener("animationend", (event) => {
      if (event.animationName.includes("fly") || (event.target as HTMLElement).classList.contains("bottom")) end();
    });
  } else {
    end();
  }
</script>

<style>
  /* Timeline (seconds)
     0.1 flare
     0.9 the hand comes in · 1.65 to 3.15 it writes the C in sepia · 3.15 it leaves, the C cools to white
     3.85 the J drops · 4.4 catches and swings · 4.7 light runs across it
     6.05 the shadow builds out in three steps · 6.55 hit and a second flare
     6.85 to 8.85 "Joel CODJA" writes itself under the mark, a terracotta caret leading
     9.35 the mark flies to the header while the curtains open · 10.35 gone */
  .intro {
    --ink: #f3f3f3;
    --night: #0b0b0b;
    --hot: #e8916f;
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    overflow: hidden;
    color: var(--ink);
    cursor: pointer;
    animation: leave 0.01s linear 10.6s forwards;
  }
  :global(html[data-intro="off"]) .intro,
  :global(html[data-intro="off"]) .skip-intro,
  :global(html[data-intro="done"]) .skip-intro {
    display: none;
  }

  /* Two halves of the night that part like a curtain at the end. */
  .curtain {
    position: absolute;
    left: 0;
    width: 100%;
    height: 50.5%;
    background: var(--night);
  }
  /* Full shorthands: a shorthand without a name compiles to "animation: none". */
  .top {
    top: 0;
    animation: part-up 0.8s cubic-bezier(0.76, 0, 0.24, 1) 9.35s forwards;
  }
  .bottom {
    bottom: 0;
    animation: part-down 0.8s cubic-bezier(0.76, 0, 0.24, 1) 9.35s forwards;
  }

  /* Letterbox bands: the frame of a film. */
  .bar {
    position: absolute;
    left: 0;
    z-index: 3;
    width: 100%;
    height: 9vh;
    background: #000;
  }
  .bar-top {
    top: 0;
    animation: part-up 0.8s cubic-bezier(0.76, 0, 0.24, 1) 9.35s forwards;
  }
  .bar-bottom {
    bottom: 0;
    animation: part-down 0.8s cubic-bezier(0.76, 0, 0.24, 1) 9.35s forwards;
  }

  /* The stage sits above the curtains and the bands, so the mark can fly out over the opening page. */
  /* The mark is sized by the height too, and the whole stage rides up by a fifth of it: the name
     hangs under the mark, so mark and name together sit in the middle of the frame, clear of the
     bands. The flight measures the mark where it is, so it still lands on the header. */
  .stage {
    --mark: clamp(7rem, min(42vmin, 40vh), 22rem);
    position: relative;
    translate: 0 calc(var(--mark) * -0.22);
    z-index: 5;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .stage > :global(*) {
    grid-area: 1 / 1;
  }

  /* A horizontal light leak that opens the frame. */
  .flare {
    width: min(70vw, 56rem);
    height: 1px;
    background: var(--hot);
    box-shadow: 0 0 24px 2px rgb(232 145 111 / 0.6);
    scale: 0 1;
    opacity: 0;
    animation: flare 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
  }
  /* The same light leak once more, wider and lower, at the instant the shadow hits. */
  .flare-hit {
    width: min(90vw, 72rem);
    translate: 0 calc(var(--mark) * 0.52);
    animation-delay: 6.55s;
  }

  /* ─── The mark ─── */
  .stage :global(.mark) {
    color: var(--ink);
    perspective: 900px;
    animation:
      hit 0.42s cubic-bezier(0.2, 0, 0, 1) 6.55s both,
      fly 1s cubic-bezier(0.7, 0, 0.2, 1) 9.35s forwards;
  }
  /* The mark's own white C takes over from the written sepia one, in the same place. */
  .stage :global(.mark .cj-c) {
    animation: appear 0.56s ease-out 3.2s both;
  }
  .stage :global(.mark .cj-j) {
    animation:
      drop 0.56s cubic-bezier(0.55, 0, 1, 0.45) 3.85s both,
      swing 1.9s cubic-bezier(0.37, 0, 0.63, 1) 4.4s both;
  }
  .stage :global(.mark .cj-glint) {
    animation: glint 1s cubic-bezier(0.45, 0, 0.55, 1) 4.7s both;
  }
  /* The shadow comes out of the letters in three hard steps, like depth being extruded. */
  .stage :global(.mark .cj-echo) {
    fill: var(--hot);
    animation:
      appear 0.01s linear 6.05s both,
      extrude 0.5s steps(3, jump-start) 6.05s both,
      echo-land 1s linear 9.35s forwards;
  }

  /* The signature: JOEL small and widely tracked in the display face over CODJA in Monoton, as on the
     page, so the two faces read as a deliberate pair. Revealed left to right over 2 s behind a
     terracotta caret, like a line being written. */
  .sign-wrap {
    position: relative;
    translate: 0 calc(var(--mark) * 0.78);
  }
  .sign {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.22em;
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.75rem, min(7vw, 8vh), 5rem);
    line-height: 1;
    white-space: nowrap;
    clip-path: inset(-0.2em 100% -0.2em 0);
    animation:
      write-on 2s cubic-bezier(0.45, 0, 0.4, 1) 6.85s forwards,
      fade-out 0.3s ease-in 9.3s forwards;
  }
  .first {
    /* The tracking also trails the last letter: the same padding on the left keeps the word centred. */
    padding-left: 0.32em;
    color: rgb(243 243 243 / 0.72);
    font-family: var(--font-display);
    font-size: max(0.34em, 0.8125rem);
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }
  .surname {
    font-family: "Monoton", var(--font-display);
    letter-spacing: 0.02em;
  }
  .caret {
    position: absolute;
    top: -0.15em;
    bottom: -0.15em;
    left: 0;
    width: 2px;
    background: var(--hot);
    opacity: 0;
    animation: caret 2s cubic-bezier(0.45, 0, 0.4, 1) 6.85s forwards;
  }

  /* The scribe: the same square as the mark, laid over it. The written C is sepia ink (the colour of
     the engraved hand) and gives way to the mark's white C once the hand has gone. */
  .scribe {
    width: var(--mark);
    height: var(--mark);
    overflow: visible;
  }
  .ink {
    fill: #e8c8a0;
    animation:
      appear 0.01s linear 1.65s both,
      fade-out 0.56s ease-out 3.2s forwards;
  }
  /* The stroke that reveals the ink, and the two tracks the pen follows in and out. */
  .nib-write,
  .track {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
  }
  .track {
    fill: none;
    stroke: none;
  }
  .nib-enter {
    animation: draw 0.75s cubic-bezier(0.2, 0.7, 0.3, 1) 0.9s both;
  }
  .nib-write {
    animation: draw 1.5s cubic-bezier(0.45, 0, 0.4, 1) 1.65s both;
  }
  .nib-leave {
    animation: draw 0.75s cubic-bezier(0.5, 0, 0.8, 0.4) 3.15s both;
  }
  .pen {
    position: relative;
    width: var(--mark);
    height: var(--mark);
  }
  .pen-plane {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--vb);
    height: var(--vb);
    transform-origin: 0 0;
    scale: var(--pen-k, 1);
  }
  .hand {
    position: absolute;
    top: 0;
    left: 0;
    max-width: none;
    pointer-events: none;
    user-select: none;
    will-change: transform;
    opacity: 0;
    animation: present 3s linear 0.9s both;
  }

  /* Film grain, jittered a few times a second. */
  .grain {
    position: absolute;
    inset: -50%;
    z-index: 4;
    pointer-events: none;
    opacity: 0.09;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    animation:
      grain 0.5s steps(4) infinite,
      fade-out 0.3s ease-in 9.3s forwards;
  }

  .skip-intro {
    position: fixed;
    right: var(--space-4);
    bottom: calc(9vh + var(--space-4));
    z-index: 101;
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: var(--radius-pill);
    background: transparent;
    color: rgb(255 255 255 / 0.8);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
    animation: leave 0.01s linear 9.3s forwards;
  }
  .skip-intro:hover {
    border-color: rgb(255 255 255 / 0.6);
    color: #fff;
  }

  /* The header's own mark waits for the flying one to land on it. */
  :global(html[data-intro="on"] .brand .cj) {
    visibility: hidden;
  }

  @keyframes flare {
    40% {
      scale: 1 1;
      opacity: 1;
    }
    to {
      scale: 1.1 1;
      opacity: 0;
    }
  }
  @keyframes drop {
    from {
      opacity: 0;
      translate: 0 -150%;
    }
    30% {
      opacity: 1;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  /* A pendant on its hook: each swing smaller than the last, then still. */
  @keyframes swing {
    from {
      rotate: 0deg;
    }
    16% {
      rotate: 17deg;
    }
    38% {
      rotate: -10deg;
    }
    58% {
      rotate: 6deg;
    }
    76% {
      rotate: -2.5deg;
    }
    90% {
      rotate: 1deg;
    }
    to {
      rotate: 0deg;
    }
  }
  @keyframes glint {
    from {
      opacity: 0;
      translate: 75px 0;
    }
    20%,
    80% {
      opacity: 1;
    }
    to {
      opacity: 0;
      translate: 290px 0;
    }
  }
  /* The shadow starts tucked exactly under the letters (where its cut-out hides it). */
  @keyframes extrude {
    from {
      translate: -3.6% -3.6%;
    }
    to {
      translate: 0 0;
    }
  }
  @keyframes write-on {
    to {
      clip-path: inset(-0.2em 0 -0.2em 0);
    }
  }
  @keyframes caret {
    0% {
      left: 0;
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      left: 100%;
      opacity: 0;
    }
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes present {
    0% {
      opacity: 0;
    }
    4%,
    96% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes appear {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes hit {
    from {
      scale: 1;
    }
    35% {
      scale: 1.07;
    }
    to {
      scale: 1;
    }
  }
  /* Into the header: same centre, same size, and the page's own colours by the time it lands. */
  @keyframes fly {
    to {
      translate: var(--fly-x, 0) var(--fly-y, -44vh);
      scale: var(--fly-s, 0.1);
      color: var(--foreground);
    }
  }
  @keyframes echo-land {
    to {
      fill: var(--accent);
    }
  }
  @keyframes fade-out {
    to {
      opacity: 0;
    }
  }
  @keyframes part-up {
    to {
      translate: 0 -101%;
    }
  }
  @keyframes part-down {
    to {
      translate: 0 101%;
    }
  }
  @keyframes grain {
    0% {
      translate: 0 0;
    }
    25% {
      translate: -5% 3%;
    }
    50% {
      translate: 4% -6%;
    }
    75% {
      translate: -3% 5%;
    }
  }
  @keyframes leave {
    to {
      visibility: hidden;
      pointer-events: none;
    }
  }
</style>
