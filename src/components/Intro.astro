---
import Mark from "./Mark.astro";
import type { Dict } from "../i18n";

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const WORDS = ["I", "AM", "THE", "ONE"];
---

<!--
  The opening title: about three seconds, once per browser session. Pure CSS, so it plays and ends on
  its own even without JavaScript; the script only lets a click or a key skip it. The inline script in
  Layout.astro sets data-intro="off" before the first paint for repeat visits and reduced motion, and
  then this never renders on screen.
-->
<div class="intro" data-intro-root aria-hidden="true">
  <div class="curtain top"></div>
  <div class="curtain bottom"></div>
  <div class="stage">
    <span class="flare"></span>
    {
      WORDS.map((word, index) => (
        <span class:list={["word", { last: index === WORDS.length - 1 }]} style={`--n:${index}`}>
          {word}
        </span>
      ))
    }
    <Mark size="100%" class="mark" />
  </div>
  <div class="grain"></div>
  <span class="bar bar-top"></span>
  <span class="bar bar-bottom"></span>
</div>
<button type="button" class="skip-intro" data-intro-skip tabindex="0">{t.intro.skip}</button>

<script>
  const root = document.querySelector<HTMLElement>("[data-intro-root]");
  const skip = document.querySelector<HTMLButtonElement>("[data-intro-skip]");
  const html = document.documentElement;

  try {
    sessionStorage.setItem("joelcodja.intro", "seen");
  } catch {
    // storage blocked: the intro may play again on the next page, nothing else breaks
  }

  function end() {
    html.dataset.intro = "done";
    root?.remove();
    skip?.remove();
    document.removeEventListener("keydown", onKey);
  }
  function onKey(event: KeyboardEvent) {
    if (event.key === "Tab") return;
    end();
  }

  if (html.dataset.intro === "on" && root) {
    root.addEventListener("click", end);
    skip?.addEventListener("click", end);
    document.addEventListener("keydown", onKey);
    root.addEventListener("animationend", (event) => {
      if ((event.target as HTMLElement).classList.contains("bottom")) end();
    });
  } else {
    end();
  }
</script>

<style>
  /* Timeline (seconds): 0.1 flare · 0.45 I · 0.8 AM · 1.15 THE · 1.5 ONE · 2.05 mark draws ·
     2.75 curtains open · 3.35 gone. */
  .intro {
    --ink: #f3f3f3;
    --night: #0b0b0b;
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    overflow: hidden;
    color: var(--ink);
    cursor: pointer;
    animation: leave 0.01s linear 3.35s forwards;
  }
  :global(html[data-intro="off"]) .intro,
  :global(html[data-intro="off"]) .skip-intro,
  :global(html[data-intro="done"]) .skip-intro {
    display: none;
  }

  /* Two halves of the night that part like a curtain at the end. */
  .curtain {
    position: absolute;
    left: 0;
    width: 100%;
    height: 50.5%;
    background: var(--night);
  }
  /* Full shorthands: a shorthand without a name compiles to "animation: none". */
  .top {
    top: 0;
    animation: part-up 0.6s cubic-bezier(0.76, 0, 0.24, 1) 2.75s forwards;
  }
  .bottom {
    bottom: 0;
    animation: part-down 0.6s cubic-bezier(0.76, 0, 0.24, 1) 2.75s forwards;
  }

  /* Letterbox bands: the frame of a film, closing in a hair as the title lands. */
  .bar {
    position: absolute;
    left: 0;
    z-index: 3;
    width: 100%;
    height: 9vh;
    background: #000;
  }
  .bar-top {
    top: 0;
    animation: part-up 0.6s cubic-bezier(0.76, 0, 0.24, 1) 2.75s forwards;
  }
  .bar-bottom {
    bottom: 0;
    animation: part-down 0.6s cubic-bezier(0.76, 0, 0.24, 1) 2.75s forwards;
  }

  .stage {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    animation: fade-out 0.35s ease-in 2.6s forwards;
  }
  .stage > :global(*) {
    grid-area: 1 / 1;
  }

  /* A horizontal light leak that opens the frame. */
  .flare {
    width: min(70vw, 56rem);
    height: 1px;
    background: #e8916f;
    box-shadow: 0 0 24px 2px rgb(232 145 111 / 0.6);
    scale: 0 1;
    opacity: 0;
    animation: flare 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
  }

  /* Each word lands one beat after the last: out of focus and wide, then sharp and tight. */
  .word {
    font-family: var(--font-display);
    font-size: clamp(5rem, 22vw, 20rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 0.8;
    white-space: nowrap;
    opacity: 0;
    animation: beat 0.35s cubic-bezier(0.16, 1, 0.3, 1) calc(0.45s + var(--n) * 0.35s) both;
  }
  .word.last {
    color: #e8916f;
    animation:
      land 0.7s cubic-bezier(0.16, 1, 0.3, 1) calc(0.45s + var(--n) * 0.35s) both,
      fade-out 0.25s ease-in 1.95s forwards;
  }

  /* The c/J mark draws itself where ONE stood. */
  .stage :global(.mark) {
    width: clamp(7rem, 22vmin, 12rem);
    height: auto;
    color: var(--ink);
  }
  .stage :global(.mark .ring),
  .stage :global(.mark .slash) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 0.7s cubic-bezier(0.65, 0, 0.35, 1) 2.05s forwards;
  }
  .stage :global(.mark .slash) {
    animation-duration: 0.35s;
    animation-delay: 2.25s;
  }
  .stage :global(.mark .letters) {
    opacity: 0;
    transform-origin: 128px 128px;
    animation: letters 0.45s cubic-bezier(0.16, 1, 0.3, 1) 2.3s forwards;
  }

  /* Film grain, jittered a few times a second. */
  .grain {
    position: absolute;
    inset: -50%;
    z-index: 4;
    pointer-events: none;
    opacity: 0.09;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    animation:
      grain 0.5s steps(4) infinite,
      fade-out 0.3s ease-in 2.7s forwards;
  }

  .skip-intro {
    position: fixed;
    right: var(--space-4);
    bottom: calc(9vh + var(--space-4));
    z-index: 101;
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: var(--radius-pill);
    background: transparent;
    color: rgb(255 255 255 / 0.8);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
    animation: leave 0.01s linear 2.7s forwards;
  }
  .skip-intro:hover {
    border-color: rgb(255 255 255 / 0.6);
    color: #fff;
  }

  @keyframes flare {
    40% {
      scale: 1 1;
      opacity: 1;
    }
    to {
      scale: 1.1 1;
      opacity: 0;
    }
  }
  @keyframes beat {
    0% {
      opacity: 0;
      filter: blur(18px);
      letter-spacing: 0.25em;
      scale: 1.18;
    }
    55% {
      opacity: 1;
      filter: blur(0);
      letter-spacing: -0.05em;
      scale: 1;
    }
    /* Hard cut, like a title card: gone the instant the next word lands. */
    99.9% {
      opacity: 1;
      filter: blur(0);
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes land {
    from {
      opacity: 0;
      filter: blur(22px);
      letter-spacing: 0.3em;
      scale: 1.25;
    }
    to {
      opacity: 1;
      filter: blur(0);
      letter-spacing: -0.05em;
      scale: 1;
    }
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes letters {
    from {
      opacity: 0;
      scale: 0.86;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }
  @keyframes fade-out {
    to {
      opacity: 0;
    }
  }
  @keyframes part-up {
    to {
      translate: 0 -101%;
    }
  }
  @keyframes part-down {
    to {
      translate: 0 101%;
    }
  }
  @keyframes grain {
    0% {
      translate: 0 0;
    }
    25% {
      translate: -5% 3%;
    }
    50% {
      translate: 4% -6%;
    }
    75% {
      translate: -3% 5%;
    }
  }
  @keyframes leave {
    to {
      visibility: hidden;
      pointer-events: none;
    }
  }
</style>
