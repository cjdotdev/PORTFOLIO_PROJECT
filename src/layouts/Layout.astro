---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Intro from "../components/Intro.astro";
import { SITE_URL, PERSONAL } from "../data";
import { HERO_IMAGE } from "../lib/hero-image";
import type { Dict, Locale } from "../i18n";
import "../styles/global.css";

interface Props {
  t: Dict;
  locale: Locale;
  alternate: { en: string; fr: string };
  current: "home" | "work" | "writing" | "pics" | "music" | "kojima" | "none";
  title: string;
  description: string;
  /** Keeps the page out of search results (a page that is hidden for now). */
  noindex?: boolean;
  /** A blog post: its cover for link previews (1200x630) and its dates for search engines. */
  article?: { image?: string; published: Date; modified?: Date; tags: string[] };
  /** Overrides the canonical URL (a post's French page points to the English one, the post's language). */
  canonicalPath?: string;
}

const { t, locale, alternate, current, title, description, noindex = false, article, canonicalPath } = Astro.props;
const canonical = `${SITE_URL}${canonicalPath ?? alternate[locale]}`;
const ogImage = article?.image ? new URL(article.image, SITE_URL).href : `${SITE_URL}/og.png`;
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: PERSONAL.name,
  jobTitle: locale === "fr" ? "Développeur backend" : "Backend developer",
  description: t.meta.description,
  knowsAbout: ["API design", "Serverless", "Edge computing", "Cloudflare Workers", "TypeScript", "Hono"],
  nationality: { "@type": "Country", name: "Gabon" },
  image: `${SITE_URL}/img/avatar-v1.webp`,
  url: SITE_URL,
  worksFor: { "@type": "Organization", name: "Lixali Studio", url: "https://lixalistudio.tech" },
  homeLocation: { "@type": "Place", name: "Cotonou, Benin" },
  sameAs: [PERSONAL.github, PERSONAL.linkedin, PERSONAL.twitter],
};
const jsonLd = article
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      image: ogImage,
      datePublished: article.published.toISOString(),
      dateModified: (article.modified ?? article.published).toISOString(),
      inLanguage: "en",
      keywords: article.tags.join(", "),
      mainEntityOfPage: canonical,
      author: { "@type": "Person", name: PERSONAL.name, url: SITE_URL },
    }
  : person;
---

<!doctype html>
<html lang={locale} data-theme="dark" style="color-scheme: dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={PERSONAL.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/clash-grotesk-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cabinet-grotesk-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/monoton.woff2" as="font" type="font/woff2" crossorigin />
    {
      current === "home" && (
        <link
          rel="preload"
          as="image"
          type="image/webp"
          href={HERO_IMAGE.src}
          imagesrcset={HERO_IMAGE.srcset}
          imagesizes={HERO_IMAGE.sizes}
          fetchpriority="high"
        />
      )
    }
    <meta name="theme-color" content="#1b1b1b" />

    <link rel="alternate" hreflang="en" href={`${SITE_URL}${alternate.en}`} />
    <link rel="alternate" hreflang="fr" href={`${SITE_URL}${alternate.fr}`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}${alternate.en}`} />
    <link rel="alternate" type="application/rss+xml" title={t.meta.siteName} href="/rss.xml" />

    <meta property="og:type" content={article ? "article" : "website"} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
          {article.tags.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }
    <meta property="og:locale" content={locale === "fr" ? "fr_FR" : "en_US"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={t.meta.siteName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <!-- The site is dark only: data-theme="dark" is fixed on <html> above. -->
    <script is:inline>
      // The opening title plays once per session, and never when motion is unwelcome (Intro.astro).
      (() => {
        let seen = false;
        try {
          seen = sessionStorage.getItem("joelcodja.intro") === "seen";
        } catch {
          seen = false;
        }
        const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
        document.documentElement.dataset.intro = seen || calm ? "off" : "on";
        // The hand comes in under a second after the first paint: fetch it now, before anything else.
        if (!seen && !calm) {
          const hand = document.createElement("link");
          hand.rel = "preload";
          hand.as = "image";
          hand.href = "/img/intro-hand-v1.webp";
          hand.fetchPriority = "high";
          document.head.append(hand);
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body id="top">
    <Intro t={t} />
    <a class="skip" href="#content">{t.nav.skip}</a>
    <Header t={t} locale={locale} current={current} switchHref={alternate[locale === "fr" ? "en" : "fr"]} />
    <main id="content">
      <slot />
    </main>
    <Footer t={t} />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 50;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-control);
    background: var(--primary);
    color: var(--primary-foreground);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    translate: 0 -200%;
  }
  .skip:focus-visible {
    translate: 0 0;
  }
</style>
