---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Intro from "../components/Intro.astro";
import { SITE_URL, PERSONAL } from "../data";
import { THEME_STORAGE_KEY } from "../lib/theme";
import { HERO_IMAGE } from "../lib/hero-image";
import type { Dict, Locale } from "../i18n";
import "../styles/global.css";

interface Props {
  t: Dict;
  locale: Locale;
  alternate: { en: string; fr: string };
  current: "home" | "work" | "writing";
  title: string;
  description: string;
}

const { t, locale, alternate, current, title, description } = Astro.props;
const canonical = `${SITE_URL}${alternate[locale]}`;
const ogImage = `${SITE_URL}/og.png`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: PERSONAL.name,
  jobTitle: locale === "fr" ? "Développeur backend" : "Backend developer",
  url: SITE_URL,
  worksFor: { "@type": "Organization", name: "Lixali Studio", url: "https://lixalistudio.tech" },
  homeLocation: { "@type": "Place", name: "Cotonou, Benin" },
  sameAs: [PERSONAL.github, PERSONAL.linkedin, PERSONAL.twitter, PERSONAL.hashnode],
};
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={PERSONAL.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/clash-grotesk-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cabinet-grotesk-400.woff2" as="font" type="font/woff2" crossorigin />
    {
      current === "home" && (
        <link
          rel="preload"
          as="image"
          type="image/webp"
          href={HERO_IMAGE.src}
          imagesrcset={HERO_IMAGE.srcset}
          imagesizes={HERO_IMAGE.sizes}
          fetchpriority="high"
        />
      )
    }
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1b1b" media="(prefers-color-scheme: dark)" />

    <link rel="alternate" hreflang="en" href={`${SITE_URL}${alternate.en}`} />
    <link rel="alternate" hreflang="fr" href={`${SITE_URL}${alternate.fr}`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}${alternate.en}`} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === "fr" ? "fr_FR" : "en_US"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={t.meta.siteName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <!-- Theme before first paint: the saved choice (footer switcher, src/lib/theme.ts), otherwise the
         system setting, which keeps being followed. -->
    <script is:inline define:vars={{ themeKey: THEME_STORAGE_KEY }}>
      (() => {
        const media = matchMedia("(prefers-color-scheme: dark)");
        const saved = () => {
          try {
            const value = localStorage.getItem(themeKey);
            return value === "light" || value === "dark" ? value : null;
          } catch {
            return null;
          }
        };
        const apply = () => {
          const theme = saved() ?? (media.matches ? "dark" : "light");
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
        };
        apply();
        media.addEventListener("change", apply);
      })();
      // The opening title plays once per session, and never when motion is unwelcome (Intro.astro).
      (() => {
        let seen = false;
        try {
          seen = sessionStorage.getItem("joelcodja.intro") === "seen";
        } catch {
          seen = false;
        }
        const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
        document.documentElement.dataset.intro = seen || calm ? "off" : "on";
      })();
    </script>
  </head>
  <body id="top">
    <Intro t={t} />
    <a class="skip" href="#content">{t.nav.skip}</a>
    <Header t={t} locale={locale} current={current} switchHref={alternate[locale === "fr" ? "en" : "fr"]} />
    <main id="content">
      <slot />
    </main>
    <Footer t={t} />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 50;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-control);
    background: var(--primary);
    color: var(--primary-foreground);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    translate: 0 -200%;
  }
  .skip:focus-visible {
    translate: 0 0;
  }
</style>
